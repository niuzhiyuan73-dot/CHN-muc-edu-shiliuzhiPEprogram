/* 石榴籽杯首页：项目切换 + 分状态赛事列表 */

.cup-header {
  padding: 36rpx 32rpx 12rpx;
}

.cup-title {
  font-size: var(--font-xl);
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #1f2329;
}

.cup-subtitle {
  margin-top: 10rpx;
  font-size: var(--font-sm);
  color: #6b7280;
}

/* 顶部项目切换：一屏正好三个，其余左滑；选中项由 scroll-into-view 滚进可视区 */
.cup-projects {
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx 0 8rpx;
  white-space: nowrap;
}

.cup-projects-track {
  display: inline-flex;
  padding: 0 32rpx;
}

.cup-project {
  display: flex;
  flex: none;
  /* 三个一屏：减掉左右留白 64rpx 与两道 16rpx 间距 */
  width: calc((100vw - 96rpx) / 3);
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 72rpx;
  margin-right: 16rpx;
  border: 2rpx solid #e6e8ec;
  border-radius: 16rpx;
  background: #ffffff;
  color: #5a606b;
  font-size: var(--font-body);
  line-height: 1;
}

.cup-project:last-child {
  margin-right: 0;
}

.cup-project.is-active {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 600;
}

.cup-project-glyph {
  margin-right: 8rpx;
  font-size: var(--font-sm);
  opacity: 0.7;
}

.cup-project.is-active .cup-project-glyph {
  color: #ffffff;
  opacity: 1;
}

/* 搜索：与项目栏同为「先定位再浏览」的入口，放在列表控件上方 */
.cup-search {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 80rpx;
  margin: 8rpx 32rpx 0;
  padding: 0 22rpx;
  border: 2rpx solid #e6e8ec;
  border-radius: 999rpx;
  background: #ffffff;
}

.cup-search-icon {
  flex: none;
  margin-right: 12rpx;
  font-size: var(--font-sm);
  opacity: 0.55;
}

.cup-search-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  color: #1f2329;
  font-size: var(--font-body);
}

.cup-search-placeholder {
  color: #b3b8c0;
}

.cup-search-clear {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  margin-left: 8rpx;
  color: #9aa0a6;
  font-size: var(--font-caption);
  line-height: 48rpx;
  text-align: center;
}

/* 筛选条 */
.cup-toolbar {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx 8rpx;
}

.cup-filter {
  padding: 10rpx 20rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 2rpx solid #e6e8ec;
  color: #4b5563;
  font-size: var(--font-sm);
}

.cup-total {
  margin-left: auto;
  color: #9aa0a6;
  font-size: var(--font-caption);
}

.cup-create {
  padding: 12rpx 32rpx 8rpx;
}

/* 分状态列表 */
.cup-group {
  padding: 20rpx 24rpx 0;
}

.cup-group-title {
  display: flex;
  align-items: center;
  padding: 0 8rpx 14rpx;
  color: #303540;
  font-size: var(--font-body);
  font-weight: 600;
}

.cup-group-count {
  margin-left: 12rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #eceef2;
  color: #6b7280;
  font-size: var(--font-xs);
  font-weight: 400;
  line-height: 34rpx;
}

.cup-row {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.05);
}

.cup-row-main {
  flex: 1;
  min-width: 0;
}

.cup-row-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.cup-row-name {
  max-width: 380rpx;
  margin-right: 10rpx;
  overflow: hidden;
  color: #1f2329;
  font-size: var(--font-md);
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cup-row-meta {
  margin-top: 8rpx;
  color: #7b818b;
  font-size: var(--font-caption);
}

.cup-row-side {
  flex: none;
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.cup-row-action {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fdeceb;
  color: var(--color-primary);
  font-size: var(--font-caption);
}

.cup-row-arrow {
  color: #c1c5cc;
  font-size: var(--font-lg);
  line-height: 1;
}

.cup-more {
  padding: 24rpx;
  color: #8a8f99;
  font-size: var(--font-sm);
  text-align: center;
}
