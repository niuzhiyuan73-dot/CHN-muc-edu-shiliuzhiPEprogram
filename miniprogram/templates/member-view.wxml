<!--
  个人主页主体
  ============================================================
  「我的」页、「个人详情」页与「他人主页」看到的是同一套战绩内容，
  差别只在于加载谁的数据、以及各自展示多少。为了让几处不至于各写一份、
  改一处漏一处，界面全部放在这个模板里，页面各自 import 后传数据即可。

  模板内的事件绑定（bindtap）会由所在页面处理，所以切池、加载更多
  这些交互页面都要实现同名方法。

  【为什么拆成小块】「我的」页瘦身之后只留头卡、两张分卡与赛事名次，
  走势、战绩、交手搬进了详情页。内容还是同一套，只是各页取用不同的块。
  下面先定义每个小节，再由三个顶层模板按需拼装：memberView 是全量基准，
  profileView / profileDetailView 各取子集，避免同一段标记在几处各抄一份。
  ============================================================
-->

<!-- ========== 会员头卡。头像可点，进个人详情（他人主页里是空操作） ========== -->
<template name="memberHero">
  <view class="member-hero">
    <view class="member-avatar" bindtap="onGoProfileDetail">
      <image wx:if="{{user.avatarUrl}}" class="member-avatar-img" src="{{user.avatarUrl}}" mode="aspectFill" />
      <text wx:else>{{user.avatarText}}</text>
    </view>
    <view class="member-info">
      <view class="member-name">
        <text class="member-nick">{{user.nickName}}</text>
        <!-- 真名比昵称小一号缀在旁边；与昵称相同时不显示（见 profile.js） -->
        <text wx:if="{{user.showRealName}}" class="member-real-name">（{{user.realName}}）</text>
        <text wx:if="{{user.roleLabel && user.roleLabel !== '会员'}}" class="member-badge">{{user.roleLabel}}</text>
      </view>
      <view wx:if="{{user.college || user.joinDateText}}" class="member-meta">{{user.college}}<text wx:if="{{user.joinDateText}}"> · 加入于 {{user.joinDateText}}</text></view>
      <view class="member-tags">
        <!-- 赛季积分各协会不同（详情页/他人主页按协会取数才显示）；
             「我的」页是跨协会的，这里关掉（user.showPoints 为假，见 profile-view） -->
        <text wx:if="{{user.showPoints}}" class="tag tag-primary">赛季积分 {{user.points}}</text>
        <text wx:if="{{user.statusLabel && user.statusLabel !== '正常'}}" class="tag tag-warning">{{user.statusLabel}}</text>
      </view>
    </view>
    <!-- 切协会徽章。只有需要它的页面（我的/详情/他人主页）才传 showSwitch。
         首页与「我的」用全局作用域，详情页/他人主页是页面局部——语义由各页自行处理。
         外面包一层是为了给它一个可定位、可推到右侧的宿主节点 -->
    <view wx:if="{{showSwitch}}" class="member-hero-switch">
      <association-switch value="{{switchValue}}" label="{{switchLabel}}" bind:change="onAssociationChange" />
    </view>
  </view>
</template>

<!-- 一场都没打过：给一句明确的说明，而不是一串 0 让人以为系统坏了。
     外层 .card 由各顶层模板自己包，这里只管内容 -->
<template name="memberNoProjectNote">
  <view class="empty-state">
    <view class="empty-state-icon">🏓</view>
    <view class="empty-state-text">还没有比赛记录，打一场就有了</view>
  </view>
</template>

<!-- ========== 分项目切换 ========== -->
<template name="memberPoolTabs">
  <view class="pool-tabs {{switching ? 'is-switching' : ''}}">
    <view
      wx:for="{{projectTabs}}"
      wx:key="project"
      class="pool-tab {{item.active ? 'is-active' : ''}}"
      data-project="{{item.project}}"
      bindtap="onSwitchProject"
    >
      <view class="pool-tab-label">{{item.label}}</view>
      <view class="pool-tab-elo">{{item.elo}}</view>
    </view>
  </view>
</template>

<!-- ========== 分数卡（完整版）。详情页用，涨跌、入池分、出场次数、近期状态都在这里 ========== -->
<template name="memberScoreCard">
  <view class="card score-card">
    <view class="score-main">
      <view class="score-value">{{summary.elo}}</view>
      <view class="score-delta {{summary.deltaUp ? 'is-up' : 'is-down'}}">
        {{summary.deltaText}}
      </view>
    </view>
    <view class="score-caption">{{activeProjectLabel}}等级分 · 入池 {{summary.startElo}} 分</view>

    <view class="divider"></view>

    <view class="score-grid">
      <view class="score-cell">
        <view class="score-cell-value">{{summary.rank}}</view>
        <view class="score-cell-label">当前排名</view>
      </view>
      <view class="score-cell">
        <view class="score-cell-value">{{summary.matchCount}}</view>
        <view class="score-cell-label">出场次数</view>
      </view>
      <view class="score-cell">
        <view class="score-cell-value">{{summary.winRateText}}</view>
        <view class="score-cell-label">{{summary.recordText}}</view>
      </view>
    </view>

    <view class="score-foot">
      <text>{{summary.rankText}}</text>
      <text class="score-foot-sep">·</text>
      <text>{{summary.beatText}}</text>
    </view>

    <view class="divider"></view>

    <!-- 近期状态：最近 5 场的胜负，最近的在最左边 -->
    <view class="form-row">
      <view class="form-label">近期状态</view>
      <view class="form-dots">
        <view
          wx:for="{{form.dots}}"
          wx:key="index"
          class="form-dot {{item === 'W' ? 'is-win' : 'is-loss'}}"
        >{{item === 'W' ? '胜' : '负'}}</view>
      </view>
      <view class="form-streak">{{form.streakText}}</view>
    </view>
  </view>
</template>

<!-- ========== 分数卡（精简版）。「我的」页用，只留各项当前分数与排名、百分位 ========== -->
<!-- 两个格子本身就是切换入口：点「双打」整页换成双打口径，选中的格子用主色标出。
     没有出过场的项目不会出现在 projectTabs 里，因此也就没有那个格子 -->
<template name="memberScoreDuo">
  <view class="card score-duo-card">
    <view class="score-duo {{switching ? 'is-switching' : ''}}">
      <view
        wx:for="{{projectTabs}}"
        wx:key="project"
        class="score-duo-cell {{item.active ? 'is-active' : ''}}"
        data-project="{{item.project}}"
        bindtap="onSwitchProject"
      >
        <view class="score-duo-label">{{item.label}}</view>
        <view class="score-duo-value">{{item.elo}}</view>
      </view>
    </view>

    <view class="divider"></view>

    <view class="score-foot">
      <text>{{summary.rankText}}</text>
      <text class="score-foot-sep">·</text>
      <text>{{summary.beatText}}</text>
    </view>
  </view>
</template>

<!-- ========== 分数曲线 ========== -->
<template name="memberChart">
  <view class="card">
    <view class="card-title">分数走势</view>
    <view class="card-subtitle">虚线是入池起点，曲线是每一场之后的分数</view>

    <view wx:if="{{chart.empty}}" class="empty-note">还没有足够的数据画出走势</view>

    <block wx:else>
      <view class="chart-wrap">
        <canvas type="2d" id="eloChart" class="chart-canvas"></canvas>
      </view>

      <view class="chart-legend">
        <view class="legend-cell">
          <view class="legend-label">起点</view>
          <view class="legend-value">{{chart.startElo}}</view>
        </view>
        <view class="legend-cell">
          <view class="legend-label">当前</view>
          <view class="legend-value is-primary">{{chart.currentElo}}</view>
        </view>
        <view class="legend-cell">
          <view class="legend-label">最高</view>
          <view class="legend-value">{{chart.maxElo}}</view>
        </view>
        <view class="legend-cell">
          <view class="legend-label">最低</view>
          <view class="legend-value">{{chart.minElo}}</view>
        </view>
      </view>

      <!-- 涨跌正负号已由 formatSigned 带上，这里不要再补一个加号 -->
      <view class="chart-extremes" wx:if="{{chart.best}}">
        <view class="extreme is-up">单场最大涨幅 {{chart.best.deltaText}}（{{chart.best.dateText}}）</view>
        <view class="extreme is-down">单场最大跌幅 {{chart.worst.deltaText}}（{{chart.worst.dateText}}）</view>
      </view>
    </block>
  </view>
</template>

<!-- ========== 赛事名次 ========== -->
<template name="memberEvents">
  <view class="card">
    <view class="card-title">赛事名次</view>

    <view wx:if="{{events.records.length === 0}}" class="empty-note">还没有参加过赛事</view>

    <block wx:else>
      <view class="event-summary">
        <view class="score-cell">
          <view class="score-cell-value">{{events.summary.eventCount}}</view>
          <view class="score-cell-label">参赛</view>
        </view>
        <view class="score-cell">
          <view class="score-cell-value is-champion">{{events.summary.championCount}}</view>
          <view class="score-cell-label">冠军</view>
        </view>
        <view class="score-cell">
          <view class="score-cell-value">{{events.summary.topThreeCount}}</view>
          <view class="score-cell-label">进前三</view>
        </view>
        <view class="score-cell">
          <view class="score-cell-value">{{events.summary.bestPlacementText}}</view>
          <view class="score-cell-label">最好成绩</view>
        </view>
      </view>

      <view class="divider"></view>

      <view class="event-row" wx:for="{{events.records}}" wx:key="eventId">
        <view class="event-main">
          <view class="event-title">{{item.title}}</view>
          <view class="event-meta">{{item.dateText}} · {{item.participantCount}} 人参赛</view>
        </view>
        <view class="event-place {{item.isTop ? 'is-top' : ''}}">{{item.placementText}}</view>
      </view>
    </block>
  </view>
</template>

<!-- ========== 我的荣誉（跨协会聚合） ========== -->
<!-- 「我的」页专用：汇总数字是各协会相加，下面按协会分组列名次；
     没参加过赛事的协会不出现（分组由 profile-view.loadProfileSummary 只放有记录的） -->
<template name="profileHonors">
  <view class="card">
    <view class="card-title">我的荣誉</view>

    <view wx:if="{{honors.total === 0}}" class="empty-note">还没有参加过赛事</view>

    <block wx:else>
      <view class="event-summary">
        <view class="score-cell">
          <view class="score-cell-value">{{honors.summary.eventCount}}</view>
          <view class="score-cell-label">参赛</view>
        </view>
        <view class="score-cell">
          <view class="score-cell-value is-champion">{{honors.summary.championCount}}</view>
          <view class="score-cell-label">冠军</view>
        </view>
        <view class="score-cell">
          <view class="score-cell-value">{{honors.summary.topThreeCount}}</view>
          <view class="score-cell-label">进前三</view>
        </view>
        <view class="score-cell">
          <view class="score-cell-value">{{honors.summary.bestPlacementText}}</view>
          <view class="score-cell-label">最好成绩</view>
        </view>
      </view>

      <block wx:for="{{honors.groups}}" wx:key="associationId" wx:for-item="group" wx:for-index="groupIndex">
        <view class="divider"></view>
        <view class="honor-group-head">
          <text class="assoc-chip">{{group.associationGlyph}} {{group.associationName}}</text>
        </view>
        <view class="event-row" wx:for="{{group.records}}" wx:key="eventId">
          <view class="event-main">
            <view class="event-title">{{item.title}}</view>
            <view class="event-meta">{{item.dateText}} · {{item.participantCount}} 人参赛</view>
          </view>
          <view class="event-place {{item.isTop ? 'is-top' : ''}}">{{item.placementText}}</view>
        </view>
      </block>
    </block>
  </view>
</template>

<!-- ========== 逐场战绩 ========== -->
<template name="memberHistory">
  <view class="card">
    <view class="card-title">逐场战绩</view>
    <view class="card-subtitle">最近的在最上面，右侧是本场等级分的变化；赛事积分记在决定名次的那一场</view>

    <view wx:if="{{history.length === 0}}" class="empty-note">这个项目还没有比赛记录</view>

    <view class="match-row" wx:for="{{history}}" wx:key="matchId">
      <view class="match-flag {{item.isWin ? 'is-win' : 'is-loss'}}">{{item.resultText}}</view>
      <view class="match-body">
        <view class="match-line1">
          对阵 {{item.rivalText}}
          <text wx:if="{{item.isEvent}}" class="match-tag">赛事</text>
        </view>
        <view class="match-line2">{{item.dateText}} · {{item.partnerText}}<text wx:if="{{item.formatText}}"> · {{item.formatText}}</text></view>
        <view class="match-line2">{{item.scoreText}}</view>
      </view>
      <view class="match-delta">
        <view class="match-elo {{item.eloDeltaUp ? 'is-up' : 'is-down'}}">{{item.eloDeltaText}}</view>
        <!-- 日常比赛不给积分，大多数场次没有这一行；只有结算了赛事积分才显示 -->
        <view wx:if="{{item.hasPointDelta}}" class="match-point">积分 {{item.pointDeltaText}}</view>
      </view>
    </view>

    <view wx:if="{{hasMore}}" class="load-more" bindtap="onLoadMore">加载更多</view>
  </view>
</template>

<!-- ========== 交锋记录 ========== -->
<template name="memberHeadToHead">
  <view class="card">
    <view class="card-title">交锋记录</view>
    <view class="card-subtitle">和谁打得最多、赢多还是输多。右侧是这些交手里的总分得失</view>

    <view wx:if="{{headToHead.length === 0}}" class="empty-note">还没有交手记录</view>

    <!-- 点一行就能跳去看对方的记录，这是开球网那种「互相查战绩」的用法 -->
    <view class="stat-row" wx:for="{{headToHead}}" wx:key="opponentId"
          data-user-id="{{item.opponentId}}" bindtap="onOpenMember">
      <view class="stat-main">
        <view class="stat-name">{{item.nickName}}</view>
        <view class="stat-detail">{{item.matchCount}} 场 · {{item.recordText}}</view>
      </view>
      <view class="stat-rate">{{item.winRateText}}</view>
      <view class="stat-delta {{item.deltaUp ? 'is-up' : 'is-down'}}">{{item.deltaText}}</view>
    </view>
  </view>
</template>

<!-- ========== 搭档记录 ========== -->
<template name="memberPartners">
  <view class="card" wx:if="{{partners.length > 0}}">
    <view class="card-title">搭档记录</view>
    <view class="card-subtitle">跟谁搭档胜率最高</view>

    <view class="stat-row" wx:for="{{partners}}" wx:key="partnerId"
          data-user-id="{{item.partnerId}}" bindtap="onOpenMember">
      <view class="stat-main">
        <view class="stat-name">{{item.nickName}}</view>
        <view class="stat-detail">{{item.matchCount}} 次搭档 · {{item.recordText}}</view>
      </view>
      <view class="stat-rate">{{item.winRateText}}</view>
    </view>
  </view>
</template>

<!-- ============================================================
     顶层组合
     ============================================================ -->

<!-- 全量：他人主页。顺序与拆分前保持一致，显示效果不变 -->
<template name="memberView">
  <!-- 加载中。必须排在「查无此人」前面，否则首屏会一闪而过地报错 -->
  <view wx:if="{{loading}}" class="loading">正在加载…</view>

  <view wx:elif="{{error}}" class="empty-state">
    <view class="empty-state-icon">⚠️</view>
    <view class="empty-state-text">{{error}}</view>
  </view>

  <!-- 查无此人 -->
  <view wx:elif="{{!found}}" class="empty-state">
    <view class="empty-state-icon">🔍</view>
    <view class="empty-state-text">没有找到这位会员</view>
  </view>

  <block wx:else>
    <template is="memberHero" data="{{user: user, showSwitch: showSwitch, switchValue: switchValue}}" />

    <!-- B8 收敛：任免 / 改分入口已移除，指定权限统一走学校身份页 -->

    <view wx:if="{{!hasProject}}" class="card">
      <template is="memberNoProjectNote" />
    </view>

    <block wx:else>
      <template is="memberPoolTabs" data="{{projectTabs: projectTabs, switching: switching}}" />
      <template is="memberScoreCard" data="{{summary: summary, activeProjectLabel: activeProjectLabel, form: form}}" />
      <template is="memberChart" data="{{chart: chart}}" />
      <template is="memberEvents" data="{{events: events}}" />
      <template is="memberHistory" data="{{history: history, hasMore: hasMore}}" />
      <template is="memberHeadToHead" data="{{headToHead: headToHead}}" />
      <template is="memberPartners" data="{{partners: partners}}" />
    </block>
  </block>
</template>

<!-- 瘦身版：「我的」页。只留头卡（全局身份）与跨协会聚合的荣誉 -->
<template name="profileView">
  <view wx:if="{{loading}}" class="loading">正在加载…</view>

  <view wx:elif="{{error}}" class="empty-state">
    <view class="empty-state-icon">⚠️</view>
    <view class="empty-state-text">{{error}}</view>
  </view>

  <view wx:elif="{{!found}}" class="empty-state">
    <view class="empty-state-icon">🔍</view>
    <view class="empty-state-text">没有找到这位会员</view>
  </view>

  <block wx:else>
    <template is="memberHero" data="{{user: user, showSwitch: showSwitch, switchValue: switchValue}}" />
    <template is="profileHonors" data="{{honors: honors}}" />
  </block>
</template>

<!-- 详情版：个人详情页。头卡下先给「修改头像」入口，再是走势、战绩、交手、搭档 -->
<template name="profileDetailView">
  <view wx:if="{{loading}}" class="loading">正在加载…</view>

  <view wx:elif="{{error}}" class="empty-state">
    <view class="empty-state-icon">⚠️</view>
    <view class="empty-state-text">{{error}}</view>
  </view>

  <view wx:elif="{{!found}}" class="empty-state">
    <view class="empty-state-icon">🔍</view>
    <view class="empty-state-text">没有找到这位会员</view>
  </view>

  <block wx:else>
    <template is="memberHero" data="{{user: user, showSwitch: showSwitch, switchValue: switchValue}}" />

    <view class="card entry-card" bindtap="onGoProfileEdit">
      <view class="entry-card-main">
        <view class="entry-card-title">修改头像</view>
        <view class="entry-card-hint">更换头像与昵称</view>
      </view>
      <view class="entry-card-arrow">›</view>
    </view>

    <view wx:if="{{!hasProject}}" class="card">
      <template is="memberNoProjectNote" />
    </view>

    <block wx:else>
      <template is="memberPoolTabs" data="{{projectTabs: projectTabs, switching: switching}}" />
      <template is="memberScoreCard" data="{{summary: summary, activeProjectLabel: activeProjectLabel, form: form}}" />
      <template is="memberChart" data="{{chart: chart}}" />
      <template is="memberHistory" data="{{history: history, hasMore: hasMore}}" />
      <template is="memberHeadToHead" data="{{headToHead: headToHead}}" />
      <template is="memberPartners" data="{{partners: partners}}" />
    </block>
  </block>
</template>
