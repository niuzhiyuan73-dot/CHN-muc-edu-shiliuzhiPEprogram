/**
 * 我的球队与团队成绩：样式正本
 * ============================================================
 * 这份样式由两处共用，所以必须放在**主包**：
 *   · components/team-profile-panel —— 协会工作台里的「我的球队」页签（主包）
 *   · packageTeam/my-team-profile  —— 独立页面（分包）
 *
 * 【为什么不能留在分包里（2026-10-20 踩过）】
 * 它原先叫 pages/my-team-profile/my-team-profile.wxss，那时全在主包，
 * 组件 @import 页面样式是合法的。分包化之后页面搬进了 packageTeam，
 * 组件却在主包——**主包不允许引用分包资源**，编译直接报
 * 「wxss 文件编译错误：path '../../packageTeam/...' not found」。
 * 反过来（分包引用主包）是允许的，所以共用资源一律放主包。
 * 配对模板见 templates/team-profile-view.wxml。
 * ============================================================
 */
.total-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.total-cell { width: calc(50% - 8rpx); box-sizing: border-box; padding: 22rpx; border-radius: 12rpx; background: var(--color-bg, #f5f7f8); }
.total-label { color: var(--color-text-secondary); font-size: var(--font-sm); }
.total-value { font-size: var(--font-lg); font-weight: 600; margin: 8rpx 0; }
.season-stats { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 12rpx; }
.season-cell { width: 100%; font-size: var(--font-sm); }
.hero {
  padding: var(--space-lg) 0 var(--space-md);
}

.hero-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text-primary);
}

.hero-subtitle {
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--color-text-secondary);
}


.card-title {
  font-size: var(--font-md);
  font-weight: 600;
  margin-bottom: var(--space-sm);
}

/* 汇总条：四格平分，数字在上、说明在下 */
.summary {
  display: flex;
  align-items: center;
}

.summary-cell {
  flex: 1;
  text-align: center;
}

.summary-value {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text-primary);
}

.summary-label {
  margin-top: 4rpx;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

/* 一行一队 / 一届 */
.row {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: flex;
  align-items: center;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-primary);
}

.row-meta {
  margin-top: 4rpx;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.row-side {
  display: flex;
  align-items: center;
  flex: none;
  margin-left: var(--space-sm);
}

.status {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.arrow {
  margin-left: var(--space-xs);
  font-size: var(--font-md);
  color: var(--color-text-tertiary, #B9BDC6);
}


.tag-muted {
  background: var(--color-bg-subtle, #F2F3F5);
  color: var(--color-text-secondary);
}

.tag-medal {
  background: #FFF3D6;
  color: #9A6B00;
}

/* 荣誉：名次方块 + 赛事与球队 */
.honor {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
}

.honor-medal {
  width: 88rpx;
  flex: none;
  padding: 8rpx 0;
  border-radius: var(--radius-md);
  background: #FFF3D6;
  text-align: center;
  font-size: var(--font-caption);
  font-weight: 600;
  color: #9A6B00;
}

.honor-main {
  margin-left: var(--space-sm);
}

.honor-event {
  font-size: var(--font-sm);
  color: var(--color-text-primary);
}

.honor-team {
  margin-top: 2rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* 累计表 */
.stat-head {
  display: flex;
  align-items: center;
  padding: var(--space-xs) 0;
  border-bottom: 1rpx solid var(--color-border);
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.stat-row {
  display: flex;
  align-items: center;
  padding: var(--space-xs) 0;
  border-bottom: 1rpx solid var(--color-border);
  font-size: var(--font-sm);
  color: var(--color-text-primary);
}

.stat-total {
  border-bottom: none;
  font-weight: 600;
}

.col-name {
  flex: 2;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.col {
  flex: 1;
  text-align: center;
}

.hint-inline {
  margin: var(--space-xs) 0;
  font-size: var(--font-xs);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.hint {
  padding: var(--space-xl) 0;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}
