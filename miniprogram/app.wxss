/**
 * 全局样式与设计变量
 * ============================================================
 * 全项目统一的视觉规范集中在此处定义。
 * 页面样式一律引用变量，不写死颜色值，方便后期统一换肤。
 * ============================================================
 */

page {
  /* ---------- 主色：石榴红（与协会无关的界面，如首页顶栏） ---------- */
  --color-primary: #b23a2e;
  --color-primary-dark: #8e2c23;
  --color-primary-light: #f7e9e7;

  /* ---------- 强调色：石榴籽金，用于关键行动按钮与高亮 ---------- */
  --color-accent: #c9a227;
  --color-accent-light: #fbf3e0;

  /* ---------- 中性色 ---------- */
  --color-bg: #f5f6f8;
  --color-card: #ffffff;
  --color-text: #1f2329;
  --color-text-secondary: #6b7280;
  --color-text-tertiary: #9ca3af;
  --color-border: #e5e7eb;
  --color-divider: #f0f1f3;

  /* ---------- 语义色 ---------- */
  --color-success: #16a34a;
  --color-danger: #e5484d;
  --color-warning: #f59e0b;

  /* ---------- 排行榜奖牌色 ---------- */
  --color-gold: #d4af37;
  --color-silver: #a8a9ad;
  --color-bronze: #cd7f32;

  /* ---------- 荣誉金（冠军数、「最好成绩」徽章等荣誉场景） ----------
     荣誉语义跨协会一致，不随协会主题换色；比奖牌金深一档，白底可读。 */
  --color-honor: #a97b12;
  --color-honor-light: #f9efdb;

  /* ---------- 间距（以 8rpx 为基础单位，保证视觉节奏统一） ---------- */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;

  /* ---------- 圆角 ---------- */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;

  /* ---------- 字号 ---------- */
  --font-xs: 22rpx;
  --font-sm: 26rpx;
  --font-md: 30rpx;
  --font-lg: 36rpx;
  --font-xl: 44rpx;
  /* 展示型大数字（排名、荣誉统计等）：与正文拉开明显大小对比，让数据一眼可读 */
  --font-display: 48rpx;

  background-color: var(--color-bg);
  color: var(--color-text);
  font-size: var(--font-md);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  line-height: 1.6;
}

/* ==================== 通用布局 ==================== */

.page-container {
  min-height: 100vh;
  padding: var(--space-md);
  box-sizing: border-box;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.07);
}

.card-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--space-sm);
}

.card-subtitle {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

/* ==================== 文字工具类 ==================== */

.text-secondary {
  color: var(--color-text-secondary);
}

.text-tertiary {
  color: var(--color-text-tertiary);
}

.text-sm {
  font-size: var(--font-sm);
}

.text-xs {
  font-size: var(--font-xs);
}

.text-center {
  text-align: center;
}

.text-bold {
  font-weight: 600;
}

.text-primary {
  color: var(--color-primary);
}

.text-success {
  color: var(--color-success);
}

.text-danger {
  color: var(--color-danger);
}

/* 等级分上升时显示绿色，下降时显示红色 */
.text-up {
  color: var(--color-success);
}

.text-down {
  color: var(--color-danger);
}

/* ==================== 按钮 ==================== */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  font-weight: 500;
  border: none;
  line-height: 1;
}

.btn::after {
  border: none;
}

/* 主按钮用主色渐变：比实心色块多一层质感，也和顶部品牌区的渐变呼应。
   禁用态保持实心灰——渐变会给「不可点」的元素误加视觉权重。 */
.btn-primary {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: #ffffff;
}

.btn-primary.btn-disabled {
  background: #c8d6d0;
  color: #ffffff;
}

.btn-accent {
  background: var(--color-accent);
  color: #ffffff;
}

.btn-outline {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

/* 危险操作（退出登录、删除等）：红字红框，一眼区别于主色按钮。
   不做成实心红——整屏只有一个主行动按钮，退出一类的不该抢那个位置。 */
.btn-danger {
  background: transparent;
  color: var(--color-danger);
  border: 2rpx solid var(--color-danger);
}

.btn-block {
  width: 100%;
}

/* ==================== 分池切换 ==================== */
/* 「我的」页与排行榜页都要切项目（男单 / 女单 / 双打），
   样式放全局，两个页面共用一份，不各写一遍。 */

.pool-tabs {
  display: flex;
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: var(--space-xs);
  margin-bottom: var(--space-md);
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.07);
}

.pool-tab {
  flex: 1;
  text-align: center;
  padding: var(--space-xs) 0;
  border-radius: var(--radius-sm);
  color: var(--color-text-secondary);
}

/* 选中的池要一眼看得出来，否则用户不知道下面的数据属于哪个项目 */
.pool-tab.is-active {
  background: var(--color-primary);
  color: #ffffff;
}

/* 切换时整条标签栏淡下去。数据都在内存里，通常快到看不见，
   但万一卡一下，用户至少知道自己点到了，而不是以为没反应 */
.pool-tabs.is-switching {
  opacity: 0.5;
}

.pool-tab-label {
  font-size: var(--font-sm);
}

/* 个人主页在每个池标签下多显示一个当前分数 */
.pool-tab-elo {
  font-size: var(--font-lg);
  font-weight: 600;
  margin-top: 2rpx;
}

/* ==================== 标签 ==================== */

.tag {
  display: inline-flex;
  align-items: center;
  padding: 0 var(--space-sm);
  height: 40rpx;
  border-radius: 20rpx;
  font-size: var(--font-xs);
  line-height: 1;
}

.tag-primary {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.tag-warning {
  background: #fef3c7;
  color: #b45309;
}

.tag-success {
  background: #dcfce7;
  color: #15803d;
}

.tag-danger {
  background: #fee2e2;
  color: #b91c1c;
}

.tag-gray {
  background: var(--color-divider);
  color: var(--color-text-secondary);
}

/* ==================== 空状态 ==================== */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--space-lg);
  color: var(--color-text-tertiary);
}

/* 空状态图标统一底座：emoji 收进同一个浅灰圆形，全站所有空态
   （🔒⚠️🔍📣🏸👥等约 50 处）只改这一处就获得一致观感——
   emoji 本身各页不同没关系，底座一致就不显杂乱。 */
.empty-state-icon {
  width: 112rpx;
  height: 112rpx;
  line-height: 112rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-divider);
  font-size: 56rpx;
  margin-bottom: var(--space-md);
}

.empty-state-text {
  font-size: var(--font-sm);
}

/* 区块内的空状态：比整页的 .empty-state 轻，只占一行。
   个人主页的「暂无交锋记录」、排行榜的「这个项目还没有人打过」都用它。 */
.empty-note {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  text-align: center;
  padding: var(--space-lg) 0;
}

/* ==================== 分割线 ==================== */

.divider {
  height: 2rpx;
  background: var(--color-divider);
  margin: var(--space-md) 0;
}

/* ==================== 可点入口卡片 ==================== */

/* 标题 + 一句说明 + 箭头的可点卡片。管理入口（我的页）与「修改头像」
   （个人详情页）共用，放在全局，免得两个页面各写一份。 */
.entry-card {
  display: flex;
  align-items: center;
}

.entry-card-main {
  flex: 1;
  min-width: 0;
}

.entry-card-title {
  font-size: var(--font-md);
  font-weight: 600;
}

.entry-card-hint {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* 一个朴素的方向箭头，暗示这张卡可以点 */
.entry-card-arrow {
  flex-shrink: 0;
  margin-left: var(--space-sm);
  font-size: var(--font-xl);
  color: var(--color-text-tertiary);
  line-height: 1;
}

/* 出口卡片上的次级动作（如初始等级分的「清除」）。与整卡的主点击区分开，
   用 catchtap 阻止冒泡，点了不会顺带把主动作也触发。 */
.entry-card-action {
  flex-shrink: 0;
  margin-left: var(--space-sm);
  padding: 6rpx 18rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
}

/* ==================== 加载状态 ==================== */

/* 开发期提示条：告诉用户现在看到的是模拟数据，别当成真实成绩。
   页脚一条淡淡的小字即可，不能抢眼到干扰阅读。 */
.mock-note {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  padding: var(--space-lg) 0 var(--space-xl);
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-xl);
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
}

/* ==================== 协会主题 ==================== */
/* 「按协会套品牌」的落点：页面根节点挂 services/branding.js 给的 rootClass，
   这里覆盖全局设计变量。小程序无法给 page 元素加类，所以色值挂在页面内部的
   根容器上，子节点靠 var() 继承——只要根容器包住整页内容，效果与换肤一致。

   颜色值是 utils/associations.js 里各协会 theme 的镜像（注册表是唯一真相源；
   CSS 读不到 JS 常量，只能手抄一份）。新增协会时两边都要加。 */

.assoc-neutral {
  --color-primary: #b23a2e;
  --color-primary-dark: #8e2c23;
  --color-primary-light: #f7e9e7;
  --color-accent: #c9a227;
}

.assoc-pkb {
  --color-primary: #1565c0;
  --color-primary-dark: #0d47a1;
  --color-primary-light: #e3f0fb;
  --color-accent: #ff7a45;
}

.assoc-tt {
  --color-primary: #004d40;
  --color-primary-dark: #00332b;
  --color-primary-light: #e0f0ec;
  --color-accent: #c9a227;
}

.assoc-bd {
  --color-primary: #6a1b9a;
  --color-primary-dark: #4a148c;
  --color-primary-light: #f3e8f7;
  --color-accent: #f2994a;
}

.assoc-tn {
  --color-primary: #2e7d32;
  --color-primary-dark: #1b5e20;
  --color-primary-light: #e8f5e9;
  --color-accent: #c6d93b;
}

/* 篮球 → 橙（与匹克球的蓝、网球的草绿拉开；accent 用琥珀配球体质感） */
.assoc-bk {
  --color-primary: #e65100;
  --color-primary-dark: #bf360c;
  --color-primary-light: #fff3e0;
  --color-accent: #f9a825;
}

.assoc-fb {
  --color-primary: #0d6b45;
  --color-primary-dark: #08492f;
  --color-primary-light: #e7f3ec;
  --color-accent: #d4af37;
}
