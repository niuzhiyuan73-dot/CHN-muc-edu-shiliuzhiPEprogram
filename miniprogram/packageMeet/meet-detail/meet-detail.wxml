<!--
  运动会详情：基本信息 + 项目清单 + 按角色可见的动作。
  草稿期才出现「继续配置 / 发布报名 / 删除草稿」——发布后改规则会影响已提交的报名。
-->
<view class="page-container {{themeClass}}">

  <view wx:if="{{loading}}" class="loading">正在加载…</view>

  <view wx:elif="{{error && !meet}}" class="empty-state">
    <view class="empty-state-icon">⚠️</view>
    <view class="empty-state-text">{{error}}</view>
    <button class="btn btn-primary" bindtap="reload">重试</button>
  </view>

  <block wx:else>
    <view wx:if="{{notice}}" class="meet-notice">{{notice}}</view>
    <view wx:if="{{error}}" class="meet-error">{{error}}</view>

    <view class="card meet-head">
      <view class="meet-name">{{meet.name}}</view>
      <view wx:if="{{canManage || !meet.isDraft}}" class="meet-status meet-status-{{meet.status}}">{{meet.statusLabel}}</view>
      <view class="meet-meta">{{meet.startDate}} 至 {{meet.endDate}}</view>
      <view wx:if="{{meet.location}}" class="meet-meta">地点：{{meet.location}}</view>
      <view class="meet-meta">项目组别：{{meet.eventCount}} 项</view>
      <view wx:if="{{meet.registration && meet.registration.openAt}}" class="meet-meta">
        报名：{{meet.registration.openAt}} 至 {{meet.registration.closeAt}}
        <text wx:if="{{meet.registration.late}}">（补报中，{{meet.registration.lateEndText}} 截止）</text>
      </view>
      <view wx:if="{{registrationClosed}}" class="meet-meta meet-meta-strong">报名已截止</view>
    </view>

    <view class="meet-section-title">项目清单</view>
    <view wx:if="{{!isDraft}}" class="meet-section-hint">点项目查看该项目的成绩</view>
    <view wx:if="{{events.length === 0}}" class="empty-state">
      <view class="empty-state-icon">📋</view>
      <view class="empty-state-text">还没有选择项目</view>
    </view>

    <!-- 点项目弹成绩：成绩不再平铺在页面底部，避免一届上百项目滚不完 -->
    <view
      wx:for="{{events}}"
      wx:key="eventKey"
      class="card meet-event"
      hover-class="{{isDraft ? '' : 'meet-event-pressed'}}"
      data-event-key="{{item.eventKey}}"
      bindtap="onOpenEventResult"
    >
      <view class="meet-event-main">
        <view class="meet-event-name">{{item.name}}</view>
        <view class="meet-event-tags">
          <text class="meet-tag">{{item.categoryLabel}}</text>
          <text class="meet-tag">{{item.group === 'male' ? '男子' : item.group === 'female' ? '女子' : '混合'}}</text>
          <text class="meet-tag" wx:if="{{item.scoreType === 'versus'}}">{{item.formatLabel || '单败淘汰'}}</text>
          <text class="meet-tag" wx:elif="{{item.heatMode === 'single'}}">单场</text>
          <text class="meet-tag" wx:else>{{item.rounds === 'heat_final' ? '预赛+决赛' : '直接决赛'}}</text>
          <text class="meet-tag" wx:if="{{item.heatCapacity}}">{{item.heatMode === 'lane' ? '每批' : '每批最多'}} {{item.heatCapacity}}</text>
          <text class="meet-tag" wx:if="{{!item.scored}}">不计分</text>
          <!-- 管理员看报名规模：正式名单人数 + 待审（学生看不到，避免页面对所有人变成台账） -->
          <text class="meet-tag" wx:if="{{canManage}}">已报 {{item.entryCount}}{{item.entryForm === 'team' ? '队' : item.entryForm === 'group' ? '组' : '人'}}<text wx:if="{{item.pendingCount}}"> · {{item.pendingCount}} 待审</text></text>
          <text class="meet-tag is-result" wx:if="{{item.hasResult}}">已出成绩 ›</text>
        </view>
      </view>
      <view class="meet-event-side">
        <view class="meet-event-limit">每院 {{item.limitUnlimited ? '不限' : item.perCollegeLimit}}{{item.entryForm === 'single' ? '人' : item.entryForm === 'team' ? '队' : '组'}}</view>
        <view class="meet-event-members" wx:if="{{item.membersUnlimited}}">每组人数不限</view>
        <view class="meet-event-members" wx:elif="{{item.members > 1}}">每组 {{item.members}} 人</view>
        <!-- 学生报名：意向不占名额；已入选后不能再撤（D10／D19）。
             用 catchtap 阻止冒泡，否则点报名会同时打开成绩弹层 -->
        <block wx:if="{{isRegistration}}">
          <view wx:if="{{item.myInterestStatus === 'selected'}}" class="meet-event-state">已在正式名单</view>
          <view
            wx:elif="{{item.myInterestStatus === 'pending'}}"
            class="meet-event-btn is-pending"
            data-event-key="{{item.eventKey}}"
            catchtap="onWithdrawInterest"
          >已报名 · 撤回</view>
          <view wx:elif="{{item.drawn}}" class="meet-event-state">已抽签</view>
          <view
            wx:else
            class="meet-event-btn"
            data-event-key="{{item.eventKey}}"
            catchtap="onInterest"
          >我要报名</view>
        </block>
      </view>
    </view>

    <!-- 我的参与：意向与正式名单要能分清（D10 的三态） -->
    <block wx:if="{{isRegistration && interests.length > 0}}">
      <view class="meet-section-title">我的参赛意向</view>
      <view wx:for="{{interests}}" wx:key="eventKey" class="card meet-entry">
        <view class="meet-entry-main">
          <view class="meet-entry-name">{{item.name}} · {{item.group === 'male' ? '男子' : item.group === 'female' ? '女子' : '混合'}}</view>
          <view class="meet-entry-meta">
            {{item.status === 'pending' ? '待学院选拔' : item.status === 'selected' ? '已被学院选中' : item.status === 'rejected' ? '未入选' : '已撤回'}}
          </view>
        </view>
      </view>
    </block>

    <!-- 管理员：待审名单（审核通过才转「已用」名额） -->
    <block wx:if="{{canManage && pendingEntries.length > 0}}">
      <view class="meet-section-title">待审核名单 {{pendingEntries.length}} 条</view>
      <view wx:for="{{pendingEntries}}" wx:key="entryKey" class="card meet-entry">
        <view class="meet-entry-main">
          <view class="meet-entry-name">{{item.name}} · {{item.group === 'male' ? '男子' : item.group === 'female' ? '女子' : '混合'}}</view>
          <view class="meet-entry-meta">{{item.collegeId}} · {{item.members}} 人<text wx:if="{{item.submittedByAdmin}}"> · 代报</text></view>
        </view>
        <view class="meet-review-ops">
          <view class="meet-review is-ok" data-entry-key="{{item.entryKey}}" data-decision="approve" bindtap="onReview">通过</view>
          <view class="meet-review is-no" data-entry-key="{{item.entryKey}}" data-decision="reject" bindtap="onReview">驳回</view>
        </view>
      </view>
    </block>

    <!-- 学院部长入口：只给学院部长与管理员，普通会员点进去只会拿到「只有学院部长可以提交」 -->
    <block wx:if="{{canLeadCollege && (isRegistration || registrationClosed)}}">
      <view class="meet-college-link" bindtap="onOpenCollege">进入学院报名工作台 ›</view>
    </block>

    <!-- 管理员：赛程编排与录分发布 -->
    <block wx:if="{{!isDraft}}">
      <view wx:if="{{canManage}}" class="meet-college-link" bindtap="onOpenSchedule">赛程编排与裁判指派 ›</view>
      <view class="meet-college-link" bindtap="onOpenScore">裁判任务与成绩发布 ›</view>
      <view class="meet-college-link" bindtap="onOpenStanding">学院总榜与我的荣誉 ›</view>

      <!-- 补报窗口（D27）：报名截止后临时放开一段时间，名单仍由学院部长提交 -->
      <block wx:if="{{canManage && meet.status !== 'finished'}}">
        <view class="meet-college-link" bindtap="onToggleLate">{{lateOpen ? '收起补报设置' : '开放补报窗口 ›'}}</view>
        <view wx:if="{{lateOpen}}" class="card meet-publish">
          <view class="meet-hint">补报期间学院部长仍可提交名单，已抽签的项目不接受新增</view>
          <view class="meet-field">
            <text class="meet-label">开始</text>
            <view class="meet-time">
              <picker mode="date" value="{{lateStartDate}}" data-field="lateStartDate" bindchange="onLateDate">
                <view class="meet-time-part">{{lateStartDate || '选日期'}}</view>
              </picker>
              <picker mode="time" value="{{lateStartTime}}" data-field="lateStartTime" bindchange="onLateTime">
                <view class="meet-time-part">{{lateStartTime}}</view>
              </picker>
            </view>
          </view>
          <view class="meet-field">
            <text class="meet-label">截止</text>
            <view class="meet-time">
              <picker mode="date" value="{{lateEndDate}}" data-field="lateEndDate" bindchange="onLateDate">
                <view class="meet-time-part">{{lateEndDate || '选日期'}}</view>
              </picker>
              <picker mode="time" value="{{lateEndTime}}" data-field="lateEndTime" bindchange="onLateTime">
                <view class="meet-time-part">{{lateEndTime}}</view>
              </picker>
            </view>
          </view>
          <button class="btn btn-primary" bindtap="onSubmitLateWindow" disabled="{{busy}}">开放补报</button>
        </view>
      </block>
      <!-- 成绩改为点项目弹出；这里只在「已出成绩」索引取不到时留一个重试入口 -->
      <view wx:if="{{resultsError}}" class="meet-error" bindtap="loadResultIndex">{{resultsError}} · 点击重试</view>
      <button wx:if="{{canManage && meet.status !== 'finished'}}" class="btn btn-ghost" bindtap="onFinish" disabled="{{busy}}">结束运动会</button>
    </block>

<block wx:if="{{canManage && isDraft}}">
      <view class="meet-section-title">发布报名</view>
      <view class="card meet-publish">
        <view class="meet-field">
          <text class="meet-label">开始</text>
          <picker mode="date" value="{{openAt}}" bindchange="onOpenAtChange">
            <view class="meet-value">{{openAt}}</view>
          </picker>
        </view>
        <view class="meet-field">
          <text class="meet-label">截止</text>
          <picker mode="date" value="{{closeAt}}" bindchange="onCloseAtChange">
            <view class="meet-value">{{closeAt}}</view>
          </picker>
        </view>
        <button class="btn btn-primary" bindtap="onPublish" disabled="{{busy}}">发布报名</button>
        <button class="btn btn-ghost" bindtap="onOpenBasic" disabled="{{busy}}">编辑基本信息</button>
        <button class="btn btn-ghost" bindtap="onOpenSetup" disabled="{{busy}}">继续配置项目</button>
        <button class="btn btn-ghost meet-danger" bindtap="onDelete" disabled="{{busy}}">删除草稿</button>
      </view>
    </block>

    <view wx:elif="{{canManage && !isDraft}}" class="meet-hint">已发布报名，项目配置已锁定（改规则需后续批次的能力）。</view>
  </block>

  <!-- 成绩弹层：只装被点开的那一个项目；点遮罩关闭，点面板不关 -->
  <view wx:if="{{resultPopup.visible}}" class="meet-sheet-mask" bindtap="onCloseResult">
    <view class="meet-sheet" catchtap="onStopBubble">
      <view class="meet-sheet-head">
        <view class="meet-sheet-title">{{resultPopup.title}}</view>
        <view class="meet-sheet-close" bindtap="onCloseResult">关闭</view>
      </view>
      <scroll-view scroll-y class="meet-sheet-body">
        <view wx:if="{{resultPopup.loading}}" class="meet-hint">正在加载成绩…</view>
        <view wx:elif="{{resultPopup.error}}" class="meet-error" bindtap="onRetryEventResult">{{resultPopup.error}} · 点击重试</view>
        <view wx:elif="{{resultPopup.rounds.length === 0}}" class="meet-hint">该项目还没有发布成绩</view>
        <block wx:else>
          <view wx:for="{{resultPopup.rounds}}" wx:for-item="round" wx:key="sessionKey" class="meet-sheet-round">
            <view class="meet-sheet-round-title">{{round.roundLabel}} · {{round.official ? '正式名次' : '预赛成绩（不计学院分）'}}</view>
            <view wx:if="{{round.items.length === 0}}" class="meet-hint">该场次没有成绩行</view>
            <view wx:for="{{round.items}}" wx:for-item="row" wx:key="entryKey" class="meet-sheet-row">
              <view class="meet-sheet-row-main">
                <view class="meet-sheet-row-name">{{row.rank ? '第 ' + row.rank + ' 名' : '无成绩'}} · {{row.collegeName}}</view>
                <view wx:if="{{row.memberText}}" class="meet-sheet-row-meta">{{row.memberText}}</view>
              </view>
              <view class="meet-sheet-row-side">
                <view class="meet-sheet-row-text">{{row.text}}</view>
                <view class="meet-sheet-row-points">{{row.points}} 分</view>
              </view>
            </view>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
