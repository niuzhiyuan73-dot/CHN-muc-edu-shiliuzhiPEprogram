.meet-section-title { margin: 24rpx 0 12rpx; font-size: var(--font-sm); font-weight: 600; color: #555; }
.meet-row { padding: 20rpx 24rpx; margin-bottom: 12rpx; }
.meet-row-head { display: flex; justify-content: space-between; align-items: center; }
.meet-row-name { font-size: var(--font-body); font-weight: 500; }
.meet-row-meta { margin-top: 6rpx; font-size: var(--font-xs); color: #888; }
.meet-row-tag { font-size: var(--font-xs); padding: 4rpx 14rpx; border-radius: 999rpx; background: #f2f2f2; color: #777; }
.meet-editor { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f0f0; }
.meet-hint { font-size: var(--font-caption); color: #888; padding: 8rpx 0; }
.meet-warn { font-size: var(--font-caption); color: var(--color-primary); background: var(--color-danger-light); padding: 10rpx 16rpx; border-radius: 10rpx; margin-bottom: 10rpx; }
.meet-score-row { display: flex; align-items: center; gap: 12rpx; padding: 10rpx 0; }
.meet-score-college { width: 120rpx; font-size: var(--font-caption); color: #555; }
.meet-score-input { flex: 1; height: 64rpx; padding: 0 16rpx; background: #f7f8fa; border-radius: 10rpx; font-size: var(--font-caption); }
.meet-score-state { width: 100rpx; font-size: var(--font-2xs); color: #999; text-align: center; }
.meet-score-submit { padding: 8rpx 18rpx; border-radius: 999rpx; background: var(--color-primary); color: #fff; font-size: var(--font-xs); }
.meet-preview-row { display: flex; align-items: center; gap: 12rpx; padding: 10rpx 0; font-size: var(--font-caption); }
.meet-preview-college { flex: 1; }
.meet-preview-value { width: 120rpx; text-align: right; }
.meet-preview-void { padding: 6rpx 14rpx; border-radius: 999rpx; background: #f2f2f2; color: #777; font-size: var(--font-2xs); }
.meet-preview-void.is-void { background: var(--color-danger-light); color: var(--color-primary); }
.meet-notice { margin-bottom: 16rpx; padding: 12rpx 20rpx; border-radius: 12rpx; background: var(--color-success-light); color: var(--color-success-text); font-size: var(--font-caption); }
.meet-error { margin-bottom: 16rpx; padding: 12rpx 20rpx; border-radius: 12rpx; background: var(--color-danger-light); color: var(--color-primary); font-size: var(--font-caption); }

/* 预赛/决赛切换 */
.meet-rounds { white-space: nowrap; margin: 12rpx 0; }
.meet-round { display: inline-block; padding: 8rpx 20rpx; margin-right: 12rpx; border-radius: 999rpx; background: #f2f3f5; font-size: var(--font-xs); color: #555; }
.meet-round.is-active { background: var(--color-primary); color: #fff; }
/* 签表：点队伍名即判胜 */
.meet-match { padding: 12rpx 0; border-bottom: 1rpx solid #f4f4f4; }
.meet-match-head { font-size: var(--font-xs); color: #888; margin-bottom: 8rpx; }
.meet-side { padding: 12rpx 18rpx; border-radius: 10rpx; background: #f7f8fa; font-size: var(--font-sm); margin-bottom: 8rpx; }
.meet-side.is-winner { background: var(--color-success-light); color: var(--color-success-text); font-weight: 600; }
.meet-side.is-empty { color: #bbb; background: #fbfbfb; }
.meet-ok { font-size: var(--font-caption); color: var(--color-success-text); background: var(--color-success-light); padding: 10rpx 16rpx; border-radius: 10rpx; margin-bottom: 10rpx; }

/* 录分页的场次切换与「下一场」 */
.meet-next { margin-top: 16rpx; padding: 16rpx; text-align: center; border-radius: 12rpx; background: #f7f8fa; font-size: var(--font-caption); color: var(--color-primary); }
