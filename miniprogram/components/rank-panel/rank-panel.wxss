/*
 * 排行榜面板样式
 * 分池切换（.pool-tabs）的样式在 app.wxss 里，与「我的」页共用（靠组件的
 * styleIsolation: apply-shared 渗入）。
 * 「我的排名」卡、搜索框与榜单行的样式都在 templates/rank-board.wxss 里，
 * 与「赛事」面板共用。
 */
@import "../../templates/rank-board.wxss";

.my-rank { padding: var(--space-md); display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--space-md); }
.my-rank-value { font-size: var(--font-display); font-variant-numeric: tabular-nums; }
.search-input { min-height: var(--control-min-height); box-sizing: border-box; font-size: var(--font-body); }
.rank-name { overflow-wrap: anywhere; white-space: normal; }

/* 只读浏览提示条：切到外校时出现在面板顶部，与首页同款 */
.readonly-banner {
  margin-bottom: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-warning-light);
  color: var(--color-warning-text);
  font-size: var(--font-sm);
  line-height: 1.6;
}
