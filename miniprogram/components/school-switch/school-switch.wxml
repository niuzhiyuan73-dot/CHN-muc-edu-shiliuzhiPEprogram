<!-- 学校切换徽章：校名 + 下拉暗示。整块可点，点了弹学校清单。
     variant="onbrand" 时用深色底上的玻璃拟态样式（见 wxss）。 -->
<view
  class="school-switch {{variant === 'onbrand' ? 'school-switch--onbrand' : ''}}"
  bindtap="onTap"
  hover-class="school-switch--hover"
>
  <text class="school-switch__name">{{schoolName}}</text>
  <text class="school-switch__caret">▾</text>
</view>
