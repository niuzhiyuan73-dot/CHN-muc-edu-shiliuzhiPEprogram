<!--
  赛事面板（协会工作台内嵌）
  数据形状见 services/events-view.js 的 loadEventsView。
  榜单行与搜索框的样式来自 templates/rank-board.wxss，与「排行榜」面板共用。
  积分榜只列前 10 名，「我的排名」卡不受截断影响，其余名次靠搜索框定位。
  根节点不带 page-container：外层工作台已经提供了页面内边距。
-->
<view class="{{themeClass}}">

  <!-- 加载中。必须排在出错之前，否则首屏会一闪而过地报错 -->
  <view wx:if="{{loading}}" class="loading">正在加载…</view>

  <view wx:elif="{{error}}" class="empty-state">
    <view class="empty-state-icon">⚠️</view>
    <view class="empty-state-text">{{error}}</view>
  </view>

  <block wx:else>

    <!-- 切到外校为只读浏览：赛事与积分榜是对方学校的演示内容，不能操作也进不了详情 -->
    <view wx:if="{{demoSchool}}" class="readonly-banner">
      正在浏览 {{demoSchoolName}}（只读）· 赛事与积分榜为演示内容
    </view>

    <!-- ========== 赛季说明 ========== -->
    <!-- 积分只来自赛事，且每赛季清零。先把口径写在这里，免得有人拿积分当实力比 -->
    <view class="season-bar">
      <view class="season-bar-title">{{view.seasonText}}</view>
      <view class="season-bar-note">积分只来自赛事，赛季开始后重新计算</view>
    </view>

    <!-- ========== 赛事列表（赛事闭环入口） ========== -->
    <!-- 点一行进详情：报名 / 退赛 / 签到 / 录入名次都在那边 -->
    <view class="card">
      <view class="rank-head">
        <view class="rank-head-title">赛事</view>
        <!-- 没有发布权时这个按钮根本不渲染，不给点进去再被拒的机会 -->
        <view wx:if="{{view.canPublish}}" class="event-publish" bindtap="onOpenPublish">＋ 发布</view>
      </view>

      <view wx:if="{{!view.hasEvents}}" class="empty-note">{{view.eventsEmptyNote}}</view>

      <view
        wx:for="{{view.events}}"
        wx:key="id"
        class="event-row"
        data-event-id="{{item.id}}"
        bindtap="onOpenEvent"
      >
        <view class="event-main">
          <view class="event-title">
            <text class="event-name">{{item.title}}</text>
            <text wx:if="{{item.pinned}}" class="tag tag-danger">置顶</text>
            <text class="tag {{item.isSignup ? 'tag-success' : (item.isOngoing ? 'tag-warning' : 'tag-gray')}}">{{item.statusLabel}}</text>
          </view>
          <view class="event-meta">
            {{item.timeText}}<text wx:if="{{item.location}}"> · {{item.location}}</text>
          </view>
          <view class="event-meta">{{item.levelLabel}} · {{item.matchTypeLabel}}{{item.disciplineLabel ? ' · ' + item.disciplineLabel : ''}} · {{item.quotaText}}</view>
        </view>

        <view class="event-side">
          <view wx:if="{{item.signedUp}}" class="event-my-signup">{{item.mySignupLabel}}</view>
          <!-- 管理员在列表上直接切换置顶；catchtap 挡住行点击，否则会跳进详情 -->
          <view
            wx:if="{{item.canPin}}"
            class="event-pin {{item.pinned ? 'is-on' : ''}}"
            data-event-id="{{item.id}}"
            data-pinned="{{item.pinned}}"
            catchtap="onToggleEventPin"
          >{{item.pinned ? '取消置顶' : '置顶'}}</view>
          <view wx:if="{{!item.signedUp && !item.canPin}}" class="event-arrow">›</view>
        </view>
      </view>

      <!-- 列表只摆最近几场，其余进「全部赛事」；没被截断时这条不渲染 -->
      <view wx:if="{{view.hasMoreEvents}}" class="list-more" bindtap="onMoreEvents">
        查看全部 {{view.eventTotal}} 场赛事 ›
      </view>
    </view>

    <!-- ========== 学院赛（名单制报名的入口） ========== -->
    <!-- 学院赛不个人报名，由学院负责人交名单；同一行对管理员与学院负责人去不同的页 -->
    <view class="card">
      <view class="rank-head">
        <view class="rank-head-title">学院赛</view>
        <view wx:if="{{view.canManageCollege}}" class="event-publish" bindtap="onOpenCollegePublish">＋ 学院赛</view>
      </view>

      <view wx:if="{{!view.hasCollegeEvents}}" class="empty-note">{{view.collegeEventsEmptyNote}}</view>

      <view
        wx:for="{{view.collegeEvents}}"
        wx:key="eventId"
        class="event-row"
        data-event-id="{{item.eventId}}"
        data-can-submit="{{item.canSubmit}}"
        bindtap="onOpenCollegeEvent"
      >
        <view class="event-main">
          <view class="event-title">
            <text class="event-name">{{item.title}}</text>
            <text wx:if="{{item.pinned}}" class="tag tag-danger">置顶</text>
            <text class="tag {{item.statusClass}}">{{item.statusLabel}}</text>
          </view>
          <view class="event-meta">
            {{item.startTimeText}}<text wx:if="{{item.location}}"> · {{item.location}}</text>
          </view>
          <view class="event-meta">{{item.legPlanText}} · 名单 {{item.rosterText}}</view>
        </view>

        <view class="event-side">
          <!-- 管理员在列表上直接切换置顶；catchtap 挡住行点击，否则会跳进详情 -->
          <view
            wx:if="{{item.canPin}}"
            class="event-pin {{item.pinned ? 'is-on' : ''}}"
            data-event-id="{{item.eventId}}"
            data-pinned="{{item.pinned}}"
            catchtap="onToggleCollegePin"
          >{{item.pinned ? '取消置顶' : '置顶'}}</view>
          <view wx:if="{{item.actionText}}" class="event-action">{{item.actionText}}</view>
          <view wx:if="{{!item.actionText && !item.canPin}}" class="event-arrow">›</view>
        </view>
      </view>

      <!-- 列表只摆最近几场，其余进「全部学院赛」；没被截断时这条不渲染 -->
      <view wx:if="{{view.hasMoreCollegeEvents}}" class="list-more" bindtap="onMoreCollegeEvents">
        查看全部 {{view.collegeEventTotal}} 场学院赛 ›
      </view>
    </view>

    <!-- ========== 我在积分榜上的位置 ========== -->
    <view wx:if="{{view.me}}" class="card my-rank">
      <view class="my-rank-value">
        {{view.me.rank}}<text class="my-rank-total">/{{view.me.total}}</text>
      </view>
      <view class="my-rank-line1">我在本赛季积分榜的排名</view>
      <view class="my-rank-line2">{{view.me.beatText}}</view>
    </view>

    <!-- 我不在榜上时也要交代一句，空着会让人以为页面坏了 -->
    <view wx:else class="my-rank-hint">{{view.meHint}}</view>

    <!-- ========== 按名字找会员 ========== -->
    <!-- 只是把下面的积分榜过一遍，不重新排名；搜索范围是全量，
         前十之外的人也能被搜到 -->
    <view class="search-bar">
      <input
        class="search-input"
        type="text"
        value="{{keyword}}"
        confirm-type="search"
        placeholder="输入名字找会员"
        bindinput="onInputKeyword"
      />
      <view wx:if="{{keyword}}" class="search-clear" catchtap="onClearKeyword">✕</view>
    </view>

    <!-- ========== 赛季积分榜 ========== -->
    <view class="card">
      <view class="rank-head">
        <view class="rank-head-title">赛季积分榜</view>
        <view class="rank-head-count">{{playerCountText}}</view>
      </view>

      <view wx:if="{{empty}}" class="empty-note">{{emptyNote}}</view>

      <!-- 点一行就去看这个人的完整战绩 -->
      <view
        wx:for="{{rows}}"
        wx:key="userId"
        class="rank-row {{item.isMe ? 'is-me' : ''}}"
        data-user-id="{{item.userId}}"
        bindtap="onOpenMember"
      >
        <view class="rank-no {{item.medal ? 'is-' + item.medal : ''}}">{{item.rank}}</view>

        <view class="rank-avatar">
          <image wx:if="{{item.avatarUrl}}" class="rank-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" />
          <text wx:else>{{item.avatarText}}</text>
        </view>

        <view class="rank-main">
          <view class="rank-name">
            <text>{{item.nickName}}</text>
            <text wx:if="{{item.isMe}}" class="rank-me-tag">我</text>
          </view>
          <view class="rank-detail">{{item.detailText}}</view>
        </view>

        <view class="rank-value-box">
          <view class="rank-value">{{item.valueText}}</view>
          <view class="rank-note">{{item.noteText}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{isMock}}" class="mock-note">
      当前为本地模拟数据，用于开发预览，并非真实成绩
    </view>

  </block>
</view>
