/*
 * 赛事页样式
 * 「我的排名」卡与榜单行的样式在 templates/rank-board.wxss 里，与「排行榜」页共用。
 * 赛事 / 学院赛两个列表的行样式在 templates/event-list.wxss 里，与「全部赛事」页共用。
 * 这里只写本页独有的「赛季说明」那一条。
 */
@import "../../templates/rank-board.wxss";
@import "../../templates/event-list.wxss";

/* 只读浏览提示条：切到外校时出现在页面顶部，与首页同款 */
.readonly-banner {
  margin-bottom: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-warning-light);
  color: var(--color-warning-text);
  font-size: var(--font-sm);
  line-height: 1.6;
}

/* ==================== 赛季说明 ==================== */

.season-bar {
  background: var(--color-primary-light);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
}

.season-bar-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-primary);
}

.season-bar-note {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}
