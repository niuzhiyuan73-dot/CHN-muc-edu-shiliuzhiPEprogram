/* 协会切换徽章。跟随所在页面的主题色（--color-primary），
   所以首页（中性红）与各协会页（各自主题色）里都能自适应。 */
.assoc-switch {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-primary-light, #f7e9e7);
  color: var(--color-primary, #b23a2e);
  font-size: var(--font-sm);
  line-height: 1.4;
}

.assoc-switch--hover {
  opacity: 0.7;
}

/* 深色品牌区（首页 Hero）上的玻璃拟态变体：半透明白底 + 白字，
   比浅底红字的「贴纸感」更融入品牌区。默认浅底样式保持不变——
   「我的」页头卡上同样在用这个组件，那里是白底卡片。 */
.assoc-switch--onbrand {
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
}

.assoc-switch__name {
  font-weight: 600;
  white-space: nowrap;
}

.assoc-switch__caret {
  font-size: var(--font-xs);
  opacity: 0.75;
}
