<!-- 协会切换徽章：项目名（三字）+ 下拉暗示。整块可点，点了弹协会清单。
     variant="onbrand" 时用深色底上的玻璃拟态样式（见 wxss）。 -->
<view
  class="assoc-switch {{variant === 'onbrand' ? 'assoc-switch--onbrand' : ''}}"
  bindtap="onTap"
  hover-class="assoc-switch--hover"
>
  <text wx:if="{{label}}" class="assoc-switch__label">{{label}}</text>
  <text wx:if="{{glyph}}" class="assoc-switch__glyph">{{glyph}}</text>
  <text class="assoc-switch__name">{{sportName}}</text>
  <text class="assoc-switch__caret">▾</text>
</view>
