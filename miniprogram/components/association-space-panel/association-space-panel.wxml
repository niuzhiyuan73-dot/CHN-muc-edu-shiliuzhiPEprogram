<!--
  协会空间面板（协会工作台内嵌）
  二级页签：分组 / 通知 / 训练 / 成员，默认「训练」（见规划 §3.1）。
  已落：分组 / 成员（P1）、通知（P2）、训练（P3）。签到与积分属于 P5，
  本模板不出现任何「签到」入口。
  根节点不带 page-container：外层工作台已经提供了页面内边距。
-->
<view class="{{themeClass}}">

  <view wx:if="{{loading}}" class="loading">正在加载…</view>

  <!-- 无权限：不是加载故障，而是一道准入线，给出说明与（演示环境下的）换身份入口 -->
  <view wx:elif="{{noAccess}}" class="empty-state">
    <view class="empty-state-icon">🔒</view>
    <view class="empty-state-text">{{noAccessNote}}</view>
    <view class="space-noaccess-hint">协会空间仅对本校在册会员与管理者开放。当前身份若不是本校在册会员，请先到「学校身份」页办理。</view>
    <button wx:if="{{canGoIdentity}}" class="btn btn-primary space-noaccess-btn" bindtap="onGoSchoolIdentity">
      去学校身份页
    </button>
  </view>

  <view wx:elif="{{loadError}}" class="empty-state">
    <view class="empty-state-icon">⚠️</view>
    <view class="empty-state-text">{{loadError}}</view>
  </view>

  <block wx:else>

    <!-- 顶栏：学校 + 协会，避免只显示「匹克球」分不清民大与北航 -->
    <view class="space-head">
      <view class="space-head-title">{{spaceTitle}}</view>
      <view class="space-head-note">协会空间 · 分组 / 通知 / 训练 / 成员</view>
    </view>

    <!-- ========== 二级页签 ========== -->
    <view class="pool-tabs space-tabs">
      <view
        wx:for="{{subTabs}}"
        wx:key="key"
        class="pool-tab {{item.active ? 'is-active' : ''}}"
        data-sub="{{item.key}}"
        bindtap="onSwitchSub"
      >
        <view class="pool-tab-label">{{item.label}}</view>
      </view>
    </view>

    <view wx:if="{{notice}}" class="space-notice">{{notice}}</view>
    <!-- 表单 / 动作错误就地显示，绝不替换整块面板（否则一次校验失败会把四个页签全打白） -->
    <view wx:if="{{error}}" class="space-error">{{error}}</view>

    <!-- ========== 分组 ========== -->
    <view wx:if="{{mountedSub.group}}" hidden="{{activeSub !== 'group'}}">

      <button wx:if="{{canManage}}" class="btn btn-outline btn-block space-new" bindtap="onToggleCreate">
        {{showCreate ? '取消新建' : '新建小组'}}
      </button>

      <!-- 建组表单。成员多选只列本协会在册会员（后端已过滤），不提供自行加入 -->
      <view wx:if="{{showCreate}}" class="card">
        <view class="card-title">新建小组</view>
        <view class="space-field">
          <text class="space-label">小组名称</text>
          <input class="search-input" value="{{groupForm.name}}" maxlength="30" placeholder="2～30 个字"
            data-field="name" bindinput="onField" />
        </view>
        <view class="space-field">
          <text class="space-label">说明（选填）</text>
          <textarea class="space-textarea" value="{{groupForm.description}}" maxlength="300"
            placeholder="这个小组是做什么的" data-field="description" bindinput="onField" />
        </view>
        <view class="space-field">
          <text class="space-label">选入成员（已选 {{selectedMemberIds.length}} 人）</text>
          <view wx:if="{{roster.length === 0}}" class="space-picker-note">本协会暂无可选会员</view>
          <view wx:else class="space-picker">
            <view
              wx:for="{{roster}}"
              wx:key="userId"
              class="space-pick-row {{item.picked ? 'is-picked' : ''}}"
              data-userid="{{item.userId}}"
              bindtap="onTogglePick"
            >
              <text class="space-pick-name">{{item.nickName}}</text>
              <text class="space-pick-check">{{item.picked ? '✓' : ''}}</text>
            </view>
          </view>
        </view>
        <button class="btn btn-primary btn-block" bindtap="onCreateGroup" disabled="{{groupBusy}}">
          {{groupBusy ? '处理中…' : '创建小组'}}
        </button>
      </view>

      <view wx:if="{{groups.length === 0}}" class="empty-state">
        <view class="empty-state-icon">👥</view>
        <view class="empty-state-text">本协会还没有小组</view>
      </view>

      <view
        wx:for="{{groups}}"
        wx:key="groupId"
        wx:for-item="group"
        class="card space-group {{group.archived ? 'is-archived' : ''}}"
      >
        <view class="space-group-head">
          <view class="space-group-name">
            {{group.name}}<text wx:if="{{group.joined}}" class="rank-me-tag">已加入</text>
          </view>
          <view class="space-group-count">{{group.memberCount}} 人</view>
        </view>
        <view wx:if="{{group.description}}" class="space-group-desc">{{group.description}}</view>

        <view class="space-group-actions">
          <button class="btn btn-outline space-mini" data-groupid="{{group.groupId}}" bindtap="onToggleGroupDetail">
            {{openGroupId === group.groupId ? '收起名单' : '查看名单'}}
          </button>
          <button wx:if="{{group.joined && !group.archived}}" class="btn btn-danger space-mini"
            data-groupid="{{group.groupId}}" bindtap="onLeaveGroup" disabled="{{groupBusy}}">退出</button>
          <button wx:if="{{canManage && !group.archived}}" class="btn btn-outline space-mini"
            data-groupid="{{group.groupId}}" data-revision="{{group.revision}}" bindtap="onToggleEdit"
            disabled="{{groupBusy}}">{{editingId === group.groupId ? '取消编辑' : '编辑'}}</button>
          <button wx:if="{{canManage && !group.archived}}" class="btn btn-outline space-mini"
            data-groupid="{{group.groupId}}" data-revision="{{group.revision}}" bindtap="onArchiveGroup"
            disabled="{{groupBusy}}">归档</button>
          <!-- 删除不按 archived 过滤：归档的组也要能删掉，否则它永远占着组名与列表 -->
          <button wx:if="{{canManage}}" class="btn btn-danger space-mini"
            data-groupid="{{group.groupId}}" data-revision="{{group.revision}}" bindtap="onDeleteGroup"
            disabled="{{groupBusy}}">删除</button>
        </view>

        <!-- 编辑表单：管理者改组名 / 说明，提交带版本号 -->
        <view wx:if="{{editingId === group.groupId}}" class="card space-edit">
          <view class="space-field">
            <text class="space-label">小组名称</text>
            <input class="search-input" value="{{groupForm.name}}" maxlength="30" placeholder="2～30 个字"
              data-field="name" bindinput="onField" />
          </view>
          <view class="space-field">
            <text class="space-label">说明（选填）</text>
            <textarea class="space-textarea" value="{{groupForm.description}}" maxlength="300"
              placeholder="这个小组是做什么的" data-field="description" bindinput="onField" />
          </view>
          <button class="btn btn-primary btn-block" bindtap="onSaveEdit" disabled="{{groupBusy}}">
            {{groupBusy ? '处理中…' : '保存修改'}}
          </button>
        </view>

        <!-- 名册：仅管理者与组员可见（后端 canReadRoster 已把关） -->
        <view wx:if="{{openGroupId === group.groupId}}" class="space-roster">
          <view wx:if="{{detailLoading}}" class="space-roster-note">名单加载中…</view>
          <view wx:elif="{{detailMembers.length === 0}}" class="space-roster-note">暂无组员</view>
          <view wx:else>
            <view wx:for="{{detailMembers}}" wx:key="userId" wx:for-item="member" class="space-roster-row">
              <text class="space-roster-name">{{member.nickName}}</text>
              <text class="space-roster-meta">{{member.collegeName}}{{member.permissionLabel}}</text>
              <button class="btn btn-danger space-mini" data-groupid="{{group.groupId}}"
                data-userid="{{member.userId}}" bindtap="onRemoveMember" disabled="{{groupBusy}}">移出</button>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ========== 通知（P2） ========== -->
    <view wx:if="{{mountedSub.notice}}" hidden="{{activeSub !== 'notice'}}">

      <button wx:if="{{canManage}}" class="btn btn-outline btn-block space-new" bindtap="onToggleNoticeCreate">
        {{showNoticeCreate ? '取消发布' : '发布通知'}}
      </button>

      <!-- 发布表单：正文与分类复用全局公告的校验口径（announcement.validateAnnouncement） -->
      <view wx:if="{{showNoticeCreate}}" class="card">
        <view class="card-title">发布通知</view>
        <view class="space-field">
          <text class="space-label">标题</text>
          <input class="search-input" value="{{noticeForm.title}}" maxlength="30" placeholder="2～30 个字"
            data-field="title" bindinput="onNoticeField" />
        </view>
        <view class="space-field">
          <text class="space-label">正文</text>
          <textarea class="space-textarea" value="{{noticeForm.content}}" maxlength="500"
            placeholder="不超过 500 个字" data-field="content" bindinput="onNoticeField" />
        </view>
        <view class="space-field">
          <text class="space-label">分类</text>
          <picker mode="selector" range="{{noticeCategories}}" value="{{noticeCategoryIndex}}"
            bindchange="onPickNoticeCategory">
            <view class="space-picker-value">{{noticeForm.category}}</view>
          </picker>
        </view>
        <view class="space-field space-switch-row">
          <text class="space-label">置顶</text>
          <switch checked="{{noticeForm.pinned}}" bindchange="onToggleNoticePinned" />
        </view>
        <button class="btn btn-primary btn-block" bindtap="onCreateNotice" disabled="{{groupBusy}}">
          {{groupBusy ? '处理中…' : '发布'}}
        </button>
      </view>

      <view wx:if="{{noticeError}}" class="empty-state">
        <view class="empty-state-icon">⚠️</view>
        <view class="empty-state-text">{{noticeError}}</view>
      </view>

      <view wx:elif="{{notices.length === 0 && !noticeLoading}}" class="empty-state">
        <view class="empty-state-icon">📣</view>
        <view class="empty-state-text">暂无空间通知</view>
      </view>

      <block wx:else>
        <view wx:for="{{notices}}" wx:key="noticeId" wx:for-item="notice" class="card space-card">
          <view class="space-card-head">
            <view class="space-card-title">{{notice.title}}</view>
            <text wx:if="{{notice.pinned}}" class="rank-me-tag">置顶</text>
            <text wx:if="{{notice.withdrawn}}" class="space-status">已撤回</text>
          </view>
          <view class="space-card-meta">{{notice.category}} · {{notice.publisherName}} · {{notice.publishText}}</view>
          <view class="space-card-body">{{notice.content}}</view>

          <view wx:if="{{notice.canEdit || notice.canWithdraw}}" class="space-group-actions">
            <button wx:if="{{notice.canEdit}}" class="btn btn-outline space-mini"
              data-noticeid="{{notice.noticeId}}" data-revision="{{notice.revision}}"
              bindtap="onToggleNoticeEdit" disabled="{{groupBusy}}">
              {{editingNoticeId === notice.noticeId ? '取消编辑' : '编辑'}}
            </button>
            <button wx:if="{{notice.canWithdraw}}" class="btn btn-danger space-mini"
              data-noticeid="{{notice.noticeId}}" data-revision="{{notice.revision}}"
              bindtap="onWithdrawNotice" disabled="{{groupBusy}}">撤回</button>
          </view>

          <!-- 编辑表单 -->
          <view wx:if="{{editingNoticeId === notice.noticeId}}" class="card space-edit">
            <view class="space-field">
              <text class="space-label">标题</text>
              <input class="search-input" value="{{noticeForm.title}}" maxlength="30" placeholder="2～30 个字"
                data-field="title" bindinput="onNoticeField" />
            </view>
            <view class="space-field">
              <text class="space-label">正文</text>
              <textarea class="space-textarea" value="{{noticeForm.content}}" maxlength="500"
                placeholder="不超过 500 个字" data-field="content" bindinput="onNoticeField" />
            </view>
            <view class="space-field">
              <text class="space-label">分类</text>
              <picker mode="selector" range="{{noticeCategories}}" value="{{noticeCategoryIndex}}"
                bindchange="onPickNoticeCategory">
                <view class="space-picker-value">{{noticeForm.category}}</view>
              </picker>
            </view>
            <view class="space-field space-switch-row">
              <text class="space-label">置顶</text>
              <switch checked="{{noticeForm.pinned}}" bindchange="onToggleNoticePinned" />
            </view>
            <button class="btn btn-primary btn-block" bindtap="onSaveNoticeEdit" disabled="{{groupBusy}}">
              {{groupBusy ? '处理中…' : '保存修改'}}
            </button>
          </view>
        </view>

        <button wx:if="{{noticeHasMore}}" class="btn btn-outline btn-block" bindtap="onLoadMoreNotices"
          disabled="{{noticeLoading}}">{{noticeLoading ? '加载中…' : '加载更多'}}</button>
      </block>
    </view>

    <!-- ========== 训练（默认页签；P3） ========== -->
    <view wx:if="{{mountedSub.training}}" hidden="{{activeSub !== 'training'}}">

      <!-- 状态筛选：全部 / 可报名 / 进行中 / 已结束 / 已取消 -->
      <view class="pool-tabs space-filters">
        <view
          wx:for="{{trainingFilters}}"
          wx:key="key"
          class="pool-tab {{trainingFilter === item.key ? 'is-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onTrainingFilter"
        >
          <view class="pool-tab-label">{{item.label}}</view>
        </view>
      </view>

      <button wx:if="{{canManage}}" class="btn btn-outline btn-block space-new" bindtap="onToggleTrainingCreate">
        {{showTrainingCreate ? '取消发布' : '发布训练'}}
      </button>

      <!-- 发布表单 -->
      <view wx:if="{{showTrainingCreate}}" class="card">
        <view class="card-title">发布训练</view>
        <view class="space-field">
          <text class="space-label">标题</text>
          <input class="search-input" value="{{trainingForm.title}}" maxlength="30" placeholder="2～30 个字"
            data-field="title" bindinput="onTrainingField" />
        </view>
        <view class="space-field">
          <text class="space-label">地点</text>
          <input class="search-input" value="{{trainingForm.location}}" maxlength="100" placeholder="如：综合体育馆"
            data-field="location" bindinput="onTrainingField" />
        </view>
        <view class="space-field">
          <text class="space-label">开始时间</text>
          <view class="space-datetime">
            <picker mode="date" value="{{trainingForm.date}}" data-kind="start" bindchange="onPickTrainingDate">
              <view class="space-picker-value">{{trainingForm.date || '选择日期'}}</view>
            </picker>
            <picker mode="time" value="{{trainingForm.time}}" data-kind="start" bindchange="onPickTrainingTime">
              <view class="space-picker-value">{{trainingForm.time || '选择时间'}}</view>
            </picker>
          </view>
        </view>
        <view class="space-field">
          <text class="space-label">结束时间</text>
          <view class="space-datetime">
            <picker mode="date" value="{{trainingForm.endDate}}" data-kind="end" bindchange="onPickTrainingDate">
              <view class="space-picker-value">{{trainingForm.endDate || '选择日期'}}</view>
            </picker>
            <picker mode="time" value="{{trainingForm.endTime}}" data-kind="end" bindchange="onPickTrainingTime">
              <view class="space-picker-value">{{trainingForm.endTime || '选择时间'}}</view>
            </picker>
          </view>
        </view>
        <view class="space-field">
          <text class="space-label">人数上限（留空表示不限）</text>
          <input class="search-input" type="number" value="{{trainingForm.capacity}}" maxlength="4"
            placeholder="留空不限" data-field="capacity" bindinput="onTrainingField" />
        </view>
        <view class="space-field">
          <text class="space-label">报名范围</text>
          <view class="space-mode-row">
            <view class="space-mode {{trainingForm.audienceMode === 'all' ? 'is-active' : ''}}"
              data-mode="all" bindtap="onPickAudienceMode">不限小组</view>
            <view class="space-mode {{trainingForm.audienceMode === 'groups' ? 'is-active' : ''}}"
              data-mode="groups" bindtap="onPickAudienceMode">限指定小组</view>
          </view>
          <view wx:if="{{trainingForm.audienceMode === 'groups'}}" class="space-picker">
            <view wx:if="{{audienceGroups.length === 0}}" class="space-picker-note">本协会还没有可用的小组</view>
            <view
              wx:for="{{audienceGroups}}"
              wx:key="groupId"
              wx:for-item="group"
              class="space-pick-row {{group.picked ? 'is-picked' : ''}}"
              data-groupid="{{group.groupId}}"
              bindtap="onToggleAudienceGroup"
            >
              <text class="space-pick-name">{{group.name}}</text>
              <text class="space-pick-check">{{group.picked ? '✓' : ''}}</text>
            </view>
          </view>
        </view>
        <view class="space-field">
          <text class="space-label">说明（选填）</text>
          <textarea class="space-textarea" value="{{trainingForm.description}}" maxlength="1000"
            placeholder="训练内容、注意事项" data-field="description" bindinput="onTrainingField" />
        </view>
        <button class="btn btn-primary btn-block" bindtap="onCreateTraining" disabled="{{groupBusy}}">
          {{groupBusy ? '处理中…' : '发布'}}
        </button>
      </view>

      <view wx:if="{{trainingError}}" class="empty-state">
        <view class="empty-state-icon">⚠️</view>
        <view class="empty-state-text">{{trainingError}}</view>
      </view>

      <view wx:elif="{{trainings.length === 0 && !trainingLoading}}" class="empty-state">
        <view class="empty-state-icon">🏸</view>
        <view class="empty-state-text">暂无训练</view>
      </view>

      <block wx:else>
        <view wx:for="{{trainings}}" wx:key="trainingId" wx:for-item="training" class="card space-group">
          <view class="space-group-head">
            <view class="space-group-name">{{training.title}}</view>
            <view class="space-state is-{{training.state}}">{{training.stateLabel}}</view>
          </view>
          <view class="space-card-meta">{{training.startText}} ~ {{training.endText}} · {{training.location}}</view>
          <view class="space-card-meta">{{training.audienceText}} · 已报名 {{training.signupCount}} / {{training.capacityText}}</view>

          <view class="space-group-actions">
            <button class="btn btn-outline space-mini" data-trainingid="{{training.trainingId}}"
              bindtap="onToggleTrainingDetail">
              {{openTrainingId === training.trainingId ? '收起详情' : '详情 / 报名'}}
            </button>
            <button wx:if="{{canManage && !training.canceled}}" class="btn btn-outline space-mini"
              data-trainingid="{{training.trainingId}}" data-revision="{{training.revision}}"
              bindtap="onToggleTrainingEdit" disabled="{{groupBusy}}">
              {{editingTrainingId === training.trainingId ? '取消编辑' : '编辑'}}
            </button>
            <button wx:if="{{canManage && training.finishable}}" class="btn btn-outline space-mini"
              data-trainingid="{{training.trainingId}}" bindtap="onFinishTraining"
              disabled="{{groupBusy}}">标记结束</button>
            <button wx:if="{{canManage && !training.canceled && !training.finishable}}"
              class="btn btn-danger space-mini" data-trainingid="{{training.trainingId}}"
              bindtap="onCancelTraining" disabled="{{groupBusy}}">取消训练</button>
          </view>

          <!-- 编辑表单：与发布同一套字段 -->
          <view wx:if="{{editingTrainingId === training.trainingId}}" class="card space-edit">
            <view class="space-field">
              <text class="space-label">标题</text>
              <input class="search-input" value="{{trainingForm.title}}" maxlength="30" placeholder="2～30 个字"
                data-field="title" bindinput="onTrainingField" />
            </view>
            <view class="space-field">
              <text class="space-label">地点</text>
              <input class="search-input" value="{{trainingForm.location}}" maxlength="100" placeholder="如：综合体育馆"
                data-field="location" bindinput="onTrainingField" />
            </view>
            <view class="space-field">
              <text class="space-label">开始时间</text>
              <view class="space-datetime">
                <picker mode="date" value="{{trainingForm.date}}" data-kind="start" bindchange="onPickTrainingDate">
                  <view class="space-picker-value">{{trainingForm.date || '选择日期'}}</view>
                </picker>
                <picker mode="time" value="{{trainingForm.time}}" data-kind="start" bindchange="onPickTrainingTime">
                  <view class="space-picker-value">{{trainingForm.time || '选择时间'}}</view>
                </picker>
              </view>
            </view>
            <view class="space-field">
              <text class="space-label">结束时间</text>
              <view class="space-datetime">
                <picker mode="date" value="{{trainingForm.endDate}}" data-kind="end" bindchange="onPickTrainingDate">
                  <view class="space-picker-value">{{trainingForm.endDate || '选择日期'}}</view>
                </picker>
                <picker mode="time" value="{{trainingForm.endTime}}" data-kind="end" bindchange="onPickTrainingTime">
                  <view class="space-picker-value">{{trainingForm.endTime || '选择时间'}}</view>
                </picker>
              </view>
            </view>
            <view class="space-field">
              <text class="space-label">人数上限（留空表示不限）</text>
              <input class="search-input" type="number" value="{{trainingForm.capacity}}" maxlength="4"
                placeholder="留空不限" data-field="capacity" bindinput="onTrainingField" />
            </view>
            <view class="space-field">
              <text class="space-label">报名范围</text>
              <view class="space-mode-row">
                <view class="space-mode {{trainingForm.audienceMode === 'all' ? 'is-active' : ''}}"
                  data-mode="all" bindtap="onPickAudienceMode">不限小组</view>
                <view class="space-mode {{trainingForm.audienceMode === 'groups' ? 'is-active' : ''}}"
                  data-mode="groups" bindtap="onPickAudienceMode">限指定小组</view>
              </view>
              <view wx:if="{{trainingForm.audienceMode === 'groups'}}" class="space-picker">
                <view wx:if="{{audienceGroups.length === 0}}" class="space-picker-note">本协会还没有可用的小组</view>
                <view
                  wx:for="{{audienceGroups}}"
                  wx:key="groupId"
                  wx:for-item="group"
                  class="space-pick-row {{group.picked ? 'is-picked' : ''}}"
                  data-groupid="{{group.groupId}}"
                  bindtap="onToggleAudienceGroup"
                >
                  <text class="space-pick-name">{{group.name}}</text>
                  <text class="space-pick-check">{{group.picked ? '✓' : ''}}</text>
                </view>
              </view>
            </view>
            <view class="space-field">
              <text class="space-label">说明（选填）</text>
              <textarea class="space-textarea" value="{{trainingForm.description}}" maxlength="1000"
                placeholder="训练内容、注意事项" data-field="description" bindinput="onTrainingField" />
            </view>
            <button class="btn btn-primary btn-block" bindtap="onSaveTrainingEdit" disabled="{{groupBusy}}">
              {{groupBusy ? '处理中…' : '保存修改'}}
            </button>
          </view>

          <!-- 详情 + 报名（签到属于 P5，这里不出现任何签到入口） -->
          <view wx:if="{{openTrainingId === training.trainingId}}" class="space-roster">
            <view wx:if="{{trainingDetailLoading}}" class="space-roster-note">详情加载中…</view>
            <view wx:elif="{{trainingDetailError}}" class="space-roster-note">{{trainingDetailError}}</view>
            <block wx:elif="{{trainingDetail}}">
              <view wx:if="{{trainingDetail.training.description}}" class="space-card-body">{{trainingDetail.training.description}}</view>

              <view class="space-signup">
                <text wx:if="{{trainingDetail.myRegistration && trainingDetail.myRegistration.signupStatus === 'registered'}}"
                  class="space-signup-state">你已报名</text>
                <button wx:if="{{trainingDetail.canRegister}}" class="btn btn-primary space-mini"
                  bindtap="onRegisterTraining" disabled="{{groupBusy}}">报名</button>
                <button wx:elif="{{trainingDetail.canCancel}}" class="btn btn-danger space-mini"
                  bindtap="onCancelRegistration" disabled="{{groupBusy}}">取消报名</button>
                <text wx:elif="{{trainingDetail.registerNote}}" class="space-signup-note">{{trainingDetail.registerNote}}</text>
              </view>

              <!-- 本人签到：只在窗口内、已报名、非待确认 / 已确认时出现；其余情况给一句说明 -->
              <view wx:if="{{trainingDetail.canCheckIn}}" class="space-signup">
                <text class="space-signup-note">签到后需负责人确认，确认成功计 1 分</text>
                <button class="btn btn-primary space-mini" bindtap="onRequestCheckIn"
                  disabled="{{groupBusy}}">我要签到</button>
              </view>
              <view wx:elif="{{trainingDetail.checkInNote}}" class="space-signup">
                <text class="space-signup-note">{{trainingDetail.checkInNote}}</text>
              </view>

              <view class="space-roster-note">报名名单（{{trainingRoster.length}}）</view>
              <view wx:if="{{trainingRoster.length === 0}}" class="space-roster-note">还没有人报名</view>
              <view wx:else>
                <view wx:for="{{trainingRoster}}" wx:key="userId" wx:for-item="player" class="space-roster-item">
                  <view class="space-roster-row">
                    <text class="space-roster-name">{{player.nickName}}
                      <text wx:if="{{player.canceled}}" class="space-roster-meta">已取消</text>
                      <text wx:elif="{{player.attendanceLabel}}" class="space-roster-meta">{{player.attendanceLabel}}</text></text>
                    <text class="space-roster-meta">{{player.collegeName}}</text>
                    <view class="space-roster-actions">
                      <button wx:if="{{trainingDetail.canManage && player.canApprove}}" class="btn btn-primary space-mini"
                        data-userid="{{player.userId}}" data-revision="{{player.revision}}"
                        bindtap="onConfirmCheckIn" disabled="{{groupBusy}}">确认签到</button>
                      <button wx:if="{{trainingDetail.canManage && player.canApprove}}" class="btn btn-outline space-mini"
                        data-userid="{{player.userId}}" data-kind="reject"
                        bindtap="onStartApproval" disabled="{{groupBusy}}">退回</button>
                      <button wx:if="{{trainingDetail.canManage && player.canRevoke}}" class="btn btn-outline space-mini"
                        data-userid="{{player.userId}}" data-kind="revoke"
                        bindtap="onStartApproval" disabled="{{groupBusy}}">撤销确认</button>
                      <button wx:if="{{trainingDetail.canManage && !player.canceled}}" class="btn btn-danger space-mini"
                        data-userid="{{player.userId}}" bindtap="onRemoveRegistration" disabled="{{groupBusy}}">移出</button>
                    </view>
                  </view>
                  <view wx:if="{{approvalAction && approvalAction.userId === player.userId}}" class="space-approval">
                    <input class="search-input" value="{{approvalReason}}" maxlength="200"
                      placeholder="{{approvalAction.kind === 'reject' ? '退回原因（必填）' : '撤销原因（必填）'}}"
                      bindinput="onApprovalReason" />
                    <view class="space-approval-actions">
                      <button class="btn btn-primary space-mini" bindtap="onSubmitApproval" disabled="{{groupBusy}}">提交</button>
                      <button class="btn btn-outline space-mini" bindtap="onCancelApproval" disabled="{{groupBusy}}">取消</button>
                    </view>
                  </view>
                  <view wx:if="{{player.rejectionReason}}" class="space-roster-note">退回原因：{{player.rejectionReason}}</view>
                </view>
              </view>
            </block>
          </view>
        </view>

        <button wx:if="{{trainingHasMore}}" class="btn btn-outline btn-block" bindtap="onLoadMoreTrainings"
          disabled="{{trainingLoading}}">{{trainingLoading ? '加载中…' : '加载更多'}}</button>
      </block>
    </view>

    <!-- ========== 成员 ========== -->
    <view wx:if="{{mountedSub.member}}" hidden="{{activeSub !== 'member'}}">

      <view class="search-bar">
        <input
          class="search-input"
          type="text"
          value="{{keyword}}"
          confirm-type="search"
          placeholder="输入昵称或姓名找会员"
          bindinput="onInputKeyword"
        />
        <view wx:if="{{keyword}}" class="search-clear" catchtap="onClearKeyword">✕</view>
      </view>

      <view wx:if="{{memberError}}" class="empty-state">
        <view class="empty-state-icon">⚠️</view>
        <view class="empty-state-text">{{memberError}}</view>
      </view>

      <view wx:elif="{{members.length === 0 && !memberLoading}}" class="empty-state">
        <view class="empty-state-icon">🔍</view>
        <view class="empty-state-text">{{memberEmptyNote}}</view>
      </view>

      <view wx:else class="card">
        <view
          wx:for="{{members}}"
          wx:key="userId"
          wx:for-item="member"
          class="rank-row"
          data-userid="{{member.userId}}"
          bindtap="onOpenMember"
        >
          <view class="rank-avatar">
            <image wx:if="{{member.avatarUrl}}" class="rank-avatar-img" src="{{member.avatarUrl}}" mode="aspectFill" />
            <text wx:else>{{member.nickName}}</text>
          </view>
          <view class="rank-main">
            <view class="rank-name">
              {{member.nickName}}<text wx:if="{{member.realName && member.realName !== member.nickName}}"
                class="space-roster-meta">{{member.realName}}</text>
            </view>
            <view class="rank-detail">{{member.collegeName}}{{member.permissionLabel}}</view>
          </view>
        </view>
      </view>

      <button wx:if="{{memberHasMore}}" class="btn btn-outline btn-block" bindtap="onLoadMore" disabled="{{memberLoading}}">
        {{memberLoading ? '加载中…' : '加载更多'}}
      </button>
    </view>

  </block>
</view>
