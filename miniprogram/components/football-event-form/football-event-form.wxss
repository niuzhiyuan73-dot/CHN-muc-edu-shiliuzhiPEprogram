.football-form { padding: 28rpx; background: #fff; border-radius: 20rpx; color: #24352c; }
.form-title { font-size: 34rpx; font-weight: 700; line-height: 1.5; }
.form-note, .field-note { color: #64746b; font-size: 24rpx; line-height: 1.65; margin-top: 12rpx; }
.form-field { padding: 22rpx 0; border-bottom: 1rpx solid #e8eeea; }
.field-label { font-size: 27rpx; line-height: 1.6; margin-bottom: 12rpx; }
.field-input, .field-choice { box-sizing: border-box; width: 100%; min-height: 76rpx; padding: 16rpx 20rpx; border-radius: 12rpx; background: #f3f7f4; font-size: 28rpx; }
.field-input { height: 80rpx; }
.field-invalid .field-input, .field-invalid .field-choice { background: #fff2f0; }
.quota-controls { display: flex; gap: 16rpx; align-items: center; }
.quota-controls picker { flex: 1; min-width: 0; }
.quota-input { width: 160rpx; flex: none; }
.field-error, .form-error { color: #a83228; font-size: 24rpx; line-height: 1.65; }
.field-error { margin-top: 10rpx; }
.form-error { background: #fff2f0; border-radius: 12rpx; padding: 18rpx; margin-top: 20rpx; }
.rules-summary { margin-top: 28rpx; padding: 22rpx; border-radius: 16rpx; background: #e7f3ec; }
.summary-title { color: #08492f; font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.summary-line { font-size: 25rpx; line-height: 1.85; overflow-wrap: break-word; }
.preview-heading { margin-top: 24rpx; }
.preview-name { font-size: 32rpx; font-weight: 600; overflow-wrap: break-word; }
.form-actions { display: flex; gap: 16rpx; margin-top: 28rpx; padding-bottom: 12rpx; }
.form-button { flex: 1; min-width: 0; margin: 0; padding: 0 12rpx; font-size: 26rpx; line-height: 80rpx; border-radius: 12rpx; }
.form-button::after { border: none; }
.primary { color: #fff; background: #0d6b45; }
.secondary { color: #365144; background: #eff4f0; }
