.sports-heading{margin:var(--space-sm) 0 var(--space-lg)}.sports-title{font-size:var(--font-xl);font-weight:600;color:var(--color-text)}
.sports-tabs{display:flex;gap:var(--space-xs);border-bottom:2rpx solid var(--color-border)}.sports-tab{flex:1;min-width:0;min-height:44px;border-radius:0;background:transparent;font-size:var(--font-body);color:var(--color-text-secondary);padding:var(--space-sm) 0;border-bottom:4rpx solid transparent;line-height:1.5}.sports-tab.is-current{color:var(--color-primary-dark);border-bottom-color:var(--color-primary);font-weight:600}
.sports-projects{white-space:nowrap;margin:var(--space-sm) 0}.sports-project{display:inline-block;min-height:44px;padding:var(--space-sm) var(--space-md);font-size:var(--font-caption);color:var(--color-text-secondary);line-height:1.5;background:transparent;margin-right:var(--space-xs)}.sports-project.is-current{background:var(--color-primary-light);color:var(--color-primary-dark)}
.sports-tab::after,.sports-project::after{border:0}.sports-caption{font-size:var(--font-caption);color:var(--color-text-secondary);line-height:1.7;margin:var(--space-md) 0}
.sports-record{background:var(--color-card);border-radius:var(--radius-md);padding:var(--space-lg);margin-bottom:var(--space-md);border-left:4rpx solid var(--color-primary-light)}.sports-record.has-honor{border-left-color:var(--color-honor)}
.sports-record-top,.sports-record-foot,.sports-focus-head{display:flex;justify-content:space-between;gap:var(--space-sm);flex-wrap:wrap;align-items:center}.sports-project-name{color:var(--color-primary-dark);font-size:var(--font-caption)}.sports-state{font-size:var(--font-caption);color:var(--color-text-secondary)}
.sports-record-title{font-size:var(--font-md);font-weight:600;margin:var(--space-sm) 0;overflow-wrap:anywhere}.sports-opponents{font-size:var(--font-body);line-height:1.6;overflow-wrap:anywhere}.sports-score,.sports-rank{font-size:var(--font-lg);font-variant-numeric:tabular-nums;line-height:1.5;margin:var(--space-sm) 0}.sports-rank{color:var(--color-honor)}.sports-proof{font-size:var(--font-caption);color:var(--color-success-text);margin:var(--space-sm) 0}.sports-record-meta{font-size:var(--font-caption);color:var(--color-text-secondary);line-height:1.7;overflow-wrap:anywhere}
.sports-record-foot{border-top:1rpx solid var(--color-divider);margin-top:var(--space-md);padding-top:var(--space-md);font-size:var(--font-caption);color:var(--color-primary-dark);min-height:44px}.sports-record-foot text:first-child{color:var(--color-text-secondary)}.sports-list-end{color:var(--color-text-secondary);font-size:var(--font-caption);text-align:center;margin:var(--space-lg) 0}.sports-focus-head{font-size:var(--font-body);font-weight:600}
@media(max-width:360px){.sports-record{padding:var(--space-md)}.sports-record-title{line-height:1.5}}

/* 生涯节点：横向时间轴只承担“回看里程碑”，详细事实仍在下方护照列表 */
.career-panel{margin:var(--space-md) 0 var(--space-lg);padding:var(--space-lg);border-radius:var(--radius-md);background:var(--color-card);box-shadow:var(--shadow-card)}
.career-panel-head{display:flex;justify-content:space-between;gap:var(--space-sm);margin-bottom:var(--space-md)}
.career-title{font-size:var(--font-lg);font-weight:600;color:var(--color-text)}
.career-note{font-size:var(--font-caption);color:var(--color-text-secondary);line-height:1.6;margin-top:var(--space-xs)}
.career-scroll{width:100%;white-space:nowrap}
.career-track{display:flex;align-items:stretch;gap:var(--space-md);padding:var(--space-sm) 0}
.career-node{position:relative;flex:0 0 270rpx;width:270rpx;white-space:normal;padding-top:var(--space-lg)}
.career-node::before{content:'';position:absolute;top:54rpx;left:0;right:calc(-1 * var(--space-md));height:2rpx;background:var(--color-divider)}
.career-node:last-child::before{display:none}
.career-year{position:absolute;top:0;left:0;color:var(--color-text-secondary);font-size:var(--font-2xs)}
.career-dot{position:absolute;top:44rpx;left:0;width:22rpx;height:22rpx;border-radius:50%;background:var(--color-primary);border:4rpx solid var(--color-card);box-shadow:0 0 0 2rpx var(--color-primary-light)}
.career-node.is-honor .career-dot{background:var(--color-honor)}
.career-card{margin-top:var(--space-sm);padding:var(--space-md);border-radius:var(--radius-md);background:var(--color-bg);border-left:4rpx solid var(--color-primary)}
.career-node.is-honor .career-card{border-left-color:var(--color-honor)}
.career-project{font-size:var(--font-2xs);color:var(--color-primary-dark)}
.career-card-title{margin-top:var(--space-xs);font-size:var(--font-sm);font-weight:600;line-height:1.5;overflow-wrap:anywhere}
.career-detail{margin-top:var(--space-xs);font-size:var(--font-caption);color:var(--color-honor);font-weight:600}
.career-proof{margin-top:var(--space-xs);font-size:var(--font-2xs);color:var(--color-success-text);line-height:1.5}
.career-time{margin-top:var(--space-xs);font-size:var(--font-2xs);color:var(--color-text-tertiary);line-height:1.5}
