/*
 * 公告列表样式
 * 卡片（.card）、标签（.tag）在 app.wxss 里，与其它页共用。
 * 协会标签与分类标签已移除（2026-10-18）：公告是本校一个通道。
 */

/* ==================== 一条公告 ==================== */

.notice-row {
  padding: var(--space-md) 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.notice-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.notice-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

/* 置顶用暖色，扫一眼就能和普通公告分开 */
.notice-pin {
  background: var(--color-warning-light);
  color: var(--color-warning-text);
}

/* 发布时间推到最右边 */
.notice-date {
  margin-left: auto;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.notice-title {
  margin-top: var(--space-xs);
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 1.5;
}

.notice-content {
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.pagination-error {
  color: var(--color-danger-text);
  font-size: var(--font-sm);
  margin: var(--space-sm) 0;
}

.notice-content.is-collapsed { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.notice-content.is-expanded { white-space: pre-wrap; overflow-wrap: anywhere; }
.notice-expand { background: transparent; color: var(--color-primary-dark); font-size: var(--font-sm); margin: var(--space-xs) 0 0; padding: var(--space-xs) 0; min-height: var(--control-min-height); text-align: left; }
.notice-expand::after { border: none; }
