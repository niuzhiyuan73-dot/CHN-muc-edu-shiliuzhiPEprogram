.page-container { padding: 24rpx; padding-bottom: 60rpx; background: #f5f6f8; color: #25332c; }
.card { padding: 28rpx; margin-bottom: 24rpx; border-radius: 18rpx; background: #fff; }
.title { font-size: 32rpx; font-weight: 600; margin-bottom: 20rpx; }
.row, .coverage-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 16rpx 0; }
.row text:first-child { flex: 1; }
input { width: 130rpx; padding: 10rpx; border: 1rpx solid #cedbd3; border-radius: 8rpx; text-align: center; }
textarea { width: 100%; box-sizing: border-box; min-height: 130rpx; height: 150rpx; padding: 18rpx; margin-top: 16rpx; background: #f4f7f5; border-radius: 10rpx; }
.muted { color: #64756b; font-size: 25rpx; line-height: 1.7; }
.warning, .notice { background: #fff2d8; color: #755018; padding: 20rpx; margin-bottom: 20rpx; border-radius: 10rpx; }
.tabs, .flags { display: flex; gap: 16rpx; align-items: center; flex-wrap: wrap; margin: 18rpx 0; }
.tabs button { flex: 1; min-width: 180rpx; margin: 0; }
button { color: #0d6b45; font-size: 27rpx; margin-top: 20rpx; }
.player { border-top: 1rpx solid #e5ebe7; padding: 16rpx 0; }
.flags { font-size: 24rpx; }
.flags view { display: flex; align-items: center; }
switch { transform: scale(.8); transform-origin: right center; }
.stats-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.stat-cell { width: 29%; font-size: 24rpx; color: #64756b; }
.stat-cell input { width: 100%; box-sizing: border-box; margin-top: 8rpx; }
.check { display: inline-flex; align-items: center; margin: 12rpx; font-size: 26rpx; }
.goal-row { padding: 16rpx 0; border-bottom: 1rpx solid #eee; overflow-wrap: anywhere; font-size: 25rpx; }
.goal-edit { padding: 20rpx; background: #f4f7f5; margin-top: 20rpx; }
