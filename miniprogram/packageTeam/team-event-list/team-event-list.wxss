/* 团队赛事列表 */
.hero {
  padding: var(--space-lg) 0 var(--space-md);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.hero-subtitle {
  margin-top: var(--space-xs);
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.notice {
  margin-bottom: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
  font-size: 26rpx;
  line-height: 1.6;
}

.notice-error {
  background: #FDECEA;
  color: #B23A2E;
}

.card {
  margin-bottom: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: var(--space-sm);
}

.create-input {
  height: 76rpx;
  padding: 0 var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-subtle, #F5F6F8);
  font-size: 28rpx;
  margin-bottom: var(--space-md);
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) 0;
}

.field-label {
  font-size: 27rpx;
  color: var(--color-text-secondary);
}

.picker {
  padding: 10rpx var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-subtle, #F5F6F8);
  font-size: 27rpx;
  color: var(--color-text-primary);
}

.field-note {
  margin-top: var(--space-xs);
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.create-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.btn {
  padding: 0 var(--space-lg);
  height: 68rpx;
  line-height: 68rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  text-align: center;
}

.btn-primary {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}

.btn-ghost {
  background: var(--color-bg-subtle, #F5F6F8);
  color: var(--color-text-secondary);
}

.is-disabled {
  opacity: 0.6;
}

.hint {
  padding: var(--space-xl) 0;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 28rpx;
  line-height: 1.7;
}

.hint-sub {
  margin-top: var(--space-xs);
  font-size: 24rpx;
}

.event-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.event-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.event-main {
  flex: 1;
  min-width: 0;
}

.event-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.event-meta {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.event-side {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  flex: none;
}

.status {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 21rpx;
  background: #F0F1F3;
  color: var(--color-text-secondary);
}

.status-registration {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.status-running {
  background: #FFF4E5;
  color: #B26A00;
}

.status-finished {
  background: #E8F5E9;
  color: #2E7D32;
}

.event-arrow {
  font-size: 34rpx;
  color: var(--color-text-secondary);
}

.fab {
  position: fixed;
  right: var(--space-lg);
  bottom: 60rpx;
  padding: 0 var(--space-lg);
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
}
