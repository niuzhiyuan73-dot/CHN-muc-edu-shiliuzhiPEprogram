<!-- 球队详情：队名 / 队长 / 状态 + 名单 + 按身份显示的动作 -->
<view class="page-container {{themeClass}}">
  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <view wx:elif="{{error}}" class="hint">{{error}}</view>

  <block wx:else>
    <view class="team-head">
      <view class="team-avatar">{{team.initial}}</view>
      <view class="team-head-main">
        <view class="team-name">
          {{team.name}}
          <text wx:if="{{team.isCollegeTeam}}" class="tag tag-rank">学院队</text>
        </view>
        <view class="team-meta">
          <text wx:if="{{team.isCollegeTeam}}">学院负责人管理 · {{team.memberCount}} 人（不设上限）</text>
          <text wx:else>队长 {{team.captainName}} · {{team.memberCount}} 人</text>
          <text wx:if="{{team.college}}"> · {{team.college}}</text>
        </view>
        <view class="team-status">{{team.statusLabel}}</view>
      </view>
    </view>

    <view wx:if="{{notice}}" class="notice {{noticeError ? 'notice-error' : ''}}">{{notice}}</view>

    <!-- 路人：申请加入；已在队/待审时给状态说明。院队没有申请入口，只能被选入队。 -->
    <view wx:if="{{team.status === 'active'}}" class="actions">
      <view wx:if="{{team.isCollegeTeam}}" class="hint-inline">学院代表队由本学院负责人挑选队员，报名时选中即入队；在队队员可自行退出。</view>
      <view wx:if="{{team.canApply}}" class="btn btn-primary" bindtap="onApply">申请加入</view>
      <view wx:elif="{{team.pending}}" class="hint-inline">入队申请已提交，等队长审批</view>
      <view wx:if="{{team.isMine && !team.isCaptain}}" class="btn btn-ghost" bindtap="onLeave">退队</view>
      <view wx:if="{{canPickMembers}}" class="btn btn-primary" bindtap="onOpenPick">添加队员</view>
    </view>

    <!-- 院队挑人：候选池 = 本学院在该项目的在册会员 -->
    <view wx:if="{{pickOpen}}" class="card">
      <view class="card-head">
        <view class="card-title">添加队员</view>
        <view class="badge">已选 {{pickedCount}}</view>
      </view>
      <input class="create-input" placeholder="搜索本院会员" value="{{pickKeyword}}" bindinput="onPickKeyword" />
      <view wx:if="{{visibleCandidates.length === 0}}" class="hint">没有可添加的会员</view>
      <view wx:else class="member-list">
        <view wx:for="{{visibleCandidates}}" wx:key="userId" class="member-row">
          <view class="member-main">
            <view class="member-name">
              {{item.name}}
              <text wx:if="{{item.inTeam}}" class="tag tag-captain">已在队</text>
              <text wx:elif="{{item.picked}}" class="tag tag-rank">已选</text>
            </view>
          </view>
          <view class="member-actions">
            <view
              wx:if="{{!item.inTeam}}"
              class="mini {{item.picked ? '' : 'mini-primary'}}"
              data-userid="{{item.userId}}"
              bindtap="onTogglePick"
            >{{item.picked ? '取消' : '选择'}}</view>
          </view>
        </view>
      </view>
      <view class="create-actions">
        <view class="btn btn-ghost" bindtap="onClosePick">关闭</view>
        <view class="btn btn-primary {{picking ? 'is-disabled' : ''}}" bindtap="onSavePick">
          {{picking ? '提交中…' : '加入学院队'}}
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-head">
        <view class="card-title">队员名单</view>
        <view wx:if="{{team.canManage && pendingCount > 0}}" class="badge">待审 {{pendingCount}}</view>
      </view>

      <view wx:if="{{members.length === 0}}" class="hint">还没有队员</view>
      <view wx:else class="member-list">
        <view wx:for="{{members}}" wx:key="userId" class="member-row">
          <view class="member-main">
            <view class="member-name">
              {{item.name}}
              <text wx:if="{{item.role === 'captain'}}" class="tag tag-captain">队长</text>
              <text wx:if="{{item.status === 'pending'}}" class="tag tag-pending">待审批</text>
            </view>
            <view class="member-meta">{{item.statusLabel}}</view>
          </view>

          <!-- 队长/管理者：审待审申请；队长可把队长转给在队队员 -->
          <view class="member-actions">
            <block wx:if="{{item.status === 'pending' && team.canManage}}">
              <view class="mini mini-primary" data-userid="{{item.userId}}" bindtap="onApprove">通过</view>
              <view class="mini" data-userid="{{item.userId}}" bindtap="onReject">拒绝</view>
            </block>
            <view
              wx:elif="{{team.isCaptain && item.role !== 'captain' && item.status === 'active'}}"
              class="mini"
              data-userid="{{item.userId}}"
              data-name="{{item.name}}"
              bindtap="onTransfer"
            >转队长</view>
            <view
              wx:elif="{{team.isCollegeTeam && canPickMembers && item.status === 'active'}}"
              class="mini"
              data-userid="{{item.userId}}"
              bindtap="onRemoveMember"
            >移出</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 战绩：总胜负 + 历届名次 + 近期几场。只算已发布的比赛 -->
    <view wx:if="{{recordSupported}}" class="card">
      <view class="card-head">
        <view class="card-title">球队战绩</view>
        <view wx:if="{{record}}" class="badge">{{record.overall.winRateText}} 胜率</view>
      </view>

      <view wx:if="{{recordError}}" class="hint">{{recordError}}</view>
      <view wx:elif="{{!record}}" class="hint">加载中…</view>
      <block wx:else>
        <view wx:if="{{record.sportFormat === 'football11'}}" class="hint-inline">{{record.overall.recordText}} · 点球胜负单列，正式平局不计为胜。</view>
        <view class="record-summary">
          <view class="record-cell">
            <view class="record-value">{{record.overall.games}}</view>
            <view class="record-label">场次</view>
          </view>
          <view class="record-cell">
            <view class="record-value">{{record.overall.wins}}</view>
            <view class="record-label">胜</view>
          </view>
          <view class="record-cell">
            <view class="record-value">{{record.overall.losses}}</view>
            <view class="record-label">负</view>
          </view>
          <view class="record-cell">
            <view class="record-value">{{record.overall.draws}}</view>
            <view class="record-label">平</view>
          </view>
        </view>

        <view wx:if="{{record.seasons.length === 0}}" class="hint-inline">还没有参加过赛事。</view>
        <view wx:for="{{record.seasons}}" wx:key="eventId" class="record-row">
          <view class="record-main">
            <view class="record-name">{{item.name}}</view>
            <view class="record-meta">{{item.recordText}}</view>
          </view>
          <view class="record-side">
            <text wx:if="{{item.placementText}}" class="tag tag-medal">{{item.placementText}}</text>
            <text wx:else class="record-status">{{item.statusLabel}}</text>
          </view>
        </view>

        <block wx:if="{{record.recent.length > 0}}">
          <view class="record-sub">近期比赛</view>
          <view wx:for="{{record.recent}}" wx:key="matchId" class="record-row">
            <view class="record-main">
              <view class="record-name">vs {{item.opponentName}}</view>
              <view class="record-meta">{{item.eventName}}<text wx:if="{{item.matchTimeText}}"> · {{item.matchTimeText}}</text></view>
            </view>
            <view class="record-side">
              <text class="record-score">{{item.scoreText}}</text>
              <text class="tag {{item.result === 'win' ? 'tag-win' : (item.result === 'loss' ? 'tag-loss' : '')}}">{{item.resultLabel}}</text>
            </view>
          </view>
        </block>
        <view class="hint-inline">只统计已发布的比赛；待审核的比分不进战绩。</view>
      </block>
    </view>

    <!-- 院队是系统预置的常设队，没有「归档/解散」这一说 -->
    <view wx:if="{{team.canManage && team.status !== 'archived' && !team.isCollegeTeam}}" class="danger-zone">
      <view class="danger-text">归档后不再接受入队与报名，历史成绩仍可查询。</view>
      <view class="btn btn-danger" bindtap="onArchive">归档球队</view>
    </view>
  </block>
</view>
