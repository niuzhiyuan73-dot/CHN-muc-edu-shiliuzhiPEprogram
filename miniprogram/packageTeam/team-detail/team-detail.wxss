/* 球队详情：名头 + 名单 + 动作区 */
.team-head {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-lg) 0 var(--space-md);
}

.team-avatar {
  width: 116rpx;
  height: 116rpx;
  line-height: 116rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-display);
  font-weight: 700;
  flex: none;
}

.team-head-main {
  flex: 1;
  min-width: 0;
}

.team-name {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text-primary);
}

.team-meta {
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.team-status {
  margin-top: 6rpx;
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-xs);
}

.actions {
  margin-bottom: var(--space-md);
}





.notice {
  margin-bottom: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
  font-size: var(--font-sm);
  line-height: 1.6;
}

.notice-error {
  background: var(--color-danger-light);
  color: var(--color-danger-text);
}

.hint {
  padding: var(--space-xl) 0;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: var(--font-body);
}

.hint-inline {
  padding: var(--space-sm) 0;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}


.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-sm);
}

.card-title {
  font-size: var(--font-md);
  font-weight: 600;
}

.badge {
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-xs);
}

.member-list {
  display: flex;
  flex-direction: column;
}

.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.member-row:last-child {
  border-bottom: none;
}

.member-name {
  font-size: var(--font-body);
  color: var(--color-text-primary);
}

.member-meta {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.member-actions {
  display: flex;
  gap: var(--space-xs);
  flex: none;
}

.mini {
  padding: 0 var(--space-md);
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
  background: var(--color-bg-subtle, #F5F6F8);
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
}

.mini-primary {
  background: var(--color-primary);
  color: #fff;
}


.tag-captain {
  background: var(--color-primary);
  color: #fff;
}

.tag-pending {
  background: var(--color-warning-light);
  color: #B26A00;
}

.danger-zone {
  margin-top: var(--space-lg);
}

.danger-text {
  margin-bottom: var(--space-sm);
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* 战绩：四格汇总 + 历届 + 近期 */
.record-summary {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-sm);
}

.record-cell {
  flex: 1;
  text-align: center;
}

.record-value {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text-primary);
}

.record-label {
  margin-top: 2rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.record-sub {
  margin: var(--space-sm) 0 4rpx;
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--color-text-secondary);
}

.record-row {
  display: flex;
  align-items: center;
  padding: var(--space-xs) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.record-row:last-child {
  border-bottom: none;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-name {
  font-size: var(--font-sm);
  color: var(--color-text-primary);
}

.record-meta {
  margin-top: 2rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.record-side {
  display: flex;
  align-items: center;
  flex: none;
  gap: var(--space-xs);
}

.record-score {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text-primary);
}

.record-status {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.tag-medal {
  background: #FFF3D6;
  color: #9A6B00;
}

.tag-win {
  background: var(--color-danger-light);
  color: var(--color-primary);
}

.tag-loss {
  background: #EAF5EE;
  color: #2E7D54;
}

/* ---------- 从队伍列表页搬过来的共用零件 ----------
   「搜本院会员」抽屉与「名次标签」在 team-list / team-event-list 里都定义了样式，
   唯独这个页面漏了——输入框没有高度与底色，名次标签退化成裸文字。
   小程序页面样式互不共享（页面 wxss 只作用于本页），所以这里补齐。 */
.create-input {
  height: 76rpx;
  padding: 0 var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-subtle);
  font-size: var(--font-body);
}

.create-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.tag-rank {
  background: var(--color-primary-light);
  color: var(--color-primary);
}
