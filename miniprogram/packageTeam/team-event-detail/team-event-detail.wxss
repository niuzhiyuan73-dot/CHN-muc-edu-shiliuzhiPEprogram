/* 团队赛事详情 */
.head {
  padding: var(--space-lg) 0 var(--space-md);
}

.head-name {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text, #1f2329);
}

.head-meta {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-xs);
}

.head-count {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.head-rules {
  margin-top: var(--space-xs);
  font-size: var(--font-caption);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.status {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: var(--font-2xs);
  background: #F0F1F3;
  color: var(--color-text-secondary);
}

.status-registration {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.status-running,
.status-locked {
  background: var(--color-warning-light);
  color: #B26A00;
}

.status-finished {
  background: var(--color-success-light);
  color: #2E7D32;
}

.notice {
  margin-bottom: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
  font-size: var(--font-sm);
  line-height: 1.6;
}

.notice-error {
  background: var(--color-danger-light);
  color: var(--color-danger-text);
}

.action-bar {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}





.btn-ghost {
  background: var(--color-card, #ffffff);
  color: var(--color-text-secondary);
  box-shadow: var(--shadow-card, 0 2rpx 12rpx rgba(0, 0, 0, 0.04));
}

.is-disabled {
  opacity: 0.6;
}



.card-title {
  font-size: var(--font-md);
  font-weight: 600;
  margin-bottom: var(--space-sm);
}

.hint {
  padding: var(--space-xl) 0;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: var(--font-body);
}

.hint-inline {
  padding: var(--space-sm) 0;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.row-list {
  display: flex;
  flex-direction: column;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-name {
  font-size: var(--font-body);
  color: var(--color-text, #1f2329);
}

.row-meta {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.row-actions,
.match-actions {
  display: flex;
  gap: var(--space-xs);
  flex: none;
}

.mini {
  padding: 0 var(--space-md);
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
  background: var(--color-bg-subtle, #F5F6F8);
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
}

.mini-primary {
  background: var(--color-primary);
  color: #fff;
}



.tag-rank {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.tag-ot {
  background: var(--color-warning-light);
  color: #B26A00;
  margin-left: var(--space-xs);
}

.round {
  margin-bottom: var(--space-md);
}

.round-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.round-label {
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: var(--space-xs);
}

/* 赛程浮层里的文本输入：与 picker 同一视觉重量，右对齐便于对照标签 */
.sheet-input {
  flex: 1;
  min-width: 0;
  margin-left: var(--space-md);
  padding: 10rpx var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-subtle, #F5F6F8);
  font-size: var(--font-sm);
  color: var(--color-text, #1f2329);
  text-align: right;
}

.match {
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.match:last-child {
  border-bottom: none;
}

.match-line {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.side {
  flex: 1;
  font-size: var(--font-body);
  color: var(--color-text-secondary);
  text-align: left;
}

.side-b {
  text-align: right;
}

.side-win {
  color: var(--color-text, #1f2329);
  font-weight: 700;
}

.score {
  flex: none;
  min-width: 120rpx;
  text-align: center;
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-text, #1f2329);
}

.match-meta {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}

.match-actions {
  margin-top: var(--space-xs);
  justify-content: flex-end;
}

.table-head,
.table-row {
  display: flex;
  align-items: center;
  padding: var(--space-xs) 0;
  font-size: var(--font-caption);
}

.table-head {
  color: var(--color-text-secondary);
  border-bottom: 1rpx solid var(--color-border);
}

.table-row {
  color: var(--color-text, #1f2329);
}

.col-name {
  flex: 1;
  min-width: 0;
}

.col {
  width: 92rpx;
  text-align: center;
  flex: none;
}

.rank-no {
  width: 56rpx;
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-primary);
}

.mask {
  position: fixed;
  z-index: 1100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
}

.sheet {
  position: fixed;
  z-index: 1101;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--space-lg);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: var(--color-card, #ffffff);
  color: var(--color-text, #1f2329);
  box-sizing: border-box;
  padding-bottom: calc(var(--space-lg) + env(safe-area-inset-bottom));
  max-height: 90vh;
  overflow-y: auto;
}

.sheet-title {
  font-size: var(--font-md);
  font-weight: 600;
  text-align: center;
  margin-bottom: var(--space-lg);
}

.score-form {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-md);
}

.score-input {
  width: 180rpx;
  height: 120rpx;
  text-align: center;
  font-size: var(--font-display);
  font-weight: 700;
  border-radius: var(--radius-md);
  background: var(--color-bg-subtle, #F5F6F8);
}

.score-colon {
  font-size: var(--font-xl);
  color: var(--color-text-secondary);
}

.ot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-lg);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.sheet-note {
  margin-top: var(--space-md);
  font-size: var(--font-xs);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.sheet-actions {
  display: flex;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}

.sheet-actions .btn {
  flex: 1;
}

/* 可报名的球队 */
.submit-block {
  margin-bottom: var(--space-sm);
  padding-bottom: var(--space-sm);
  border-bottom: 1rpx solid var(--color-border);
}

.submit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-xs) 0;
}

.text-warn {
  color: #B26A00;
}

.picker {
  padding: 10rpx var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-subtle, #F5F6F8);
  font-size: var(--font-sm);
  color: var(--color-text, #1f2329);
}

.forfeit-note {
  margin-top: var(--space-sm);
  font-size: var(--font-xs);
  line-height: 1.6;
  color: #B26A00;
}

/* 个人统计浮层：名单可能十几人，给一个可滚动的区域 */
.sheet-tall {
  max-height: 86vh;
  display: flex;
  flex-direction: column;
}

.stats-scroll {
  flex: 1;
  min-height: 0;
  max-height: 58vh;
}

.stats-team {
  margin-bottom: var(--space-md);
}

.stats-team-name {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-primary);
  margin-bottom: var(--space-xs);
}

.stats-head,
.stats-row {
  display: flex;
  align-items: center;
  padding: var(--space-xs) 0;
}

.stats-head {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  border-bottom: 1rpx solid var(--color-border);
}

.stats-row {
  border-bottom: 1rpx solid var(--color-border);
}

.stats-col-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-sm);
  color: var(--color-text, #1f2329);
}

.stats-col {
  width: 80rpx;
  text-align: center;
  font-size: var(--font-2xs);
  color: var(--color-text-secondary);
  flex: none;
}

.stats-input {
  width: 72rpx;
  height: 56rpx;
  margin-left: 8rpx;
  text-align: center;
  font-size: var(--font-xs);
  border-radius: var(--radius-sm, 8rpx);
  background: var(--color-bg-subtle, #F5F6F8);
}

.stats-mode {
  margin-bottom: var(--space-sm);
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.col-name {
  flex: 1;
  min-width: 0;
}

/* 选人浮层（报名 / 出场）：一行一个人，勾选在左、号码在右 */
.sheet-sub {
  margin-bottom: var(--space-md);
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  text-align: center;
}

.pick-row {
  display: flex;
  align-items: center;
  padding: var(--space-xs) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.pick-check {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  margin-right: var(--space-sm);
  border-radius: 8rpx;
  border: 1rpx solid var(--color-border);
  text-align: center;
  line-height: 40rpx;
  font-size: var(--font-sm);
  color: transparent;
}

.pick-check-on {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}

.pick-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-sm);
  color: var(--color-text, #1f2329);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pick-no {
  width: 140rpx;
  flex: none;
  text-align: right;
  font-size: var(--font-sm);
  color: var(--color-text, #1f2329);
}

.pick-no-text {
  width: 120rpx;
  flex: none;
  text-align: right;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.side-switch {
  display: flex;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.side-tab {
  flex: 1;
  padding: 12rpx 0;
  border-radius: var(--radius-md);
  background: var(--color-bg-subtle, #F5F6F8);
  font-size: var(--font-caption);
  text-align: center;
  color: var(--color-text-secondary);
}

.side-tab-on {
  background: var(--color-primary);
  color: #fff;
}

/* 统计本地草稿：恢复成功用中性提示，版本冲突用危险语义色 */
.stats-draft-note {
  margin: var(--space-xs) var(--space-lg) 0;
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-sm);
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
  font-size: var(--font-caption);
  line-height: 1.6;
}

.stats-draft-note.is-error {
  background: var(--color-danger-light);
  color: var(--color-danger-text);
}

.stats-draft-hint {
  margin: var(--space-xs) var(--space-lg) 0;
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  line-height: 1.6;
}
