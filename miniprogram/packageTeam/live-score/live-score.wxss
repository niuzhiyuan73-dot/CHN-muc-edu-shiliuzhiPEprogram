/*
 * 实时计分台：横屏铺满一屏，不需要滚动。
 *
 * 【为什么纵向尺寸一律用 vh，而不是 rpx】
 * rpx 按屏幕「长边」换算。横屏时长边是宽度（如 812），200rpx 会变成
 * ~216px；而可用的高度只有 ~375px，顶栏 + 比分区一撑就溢出屏幕，于是
 * 「判 A 得分」得下滑才点得到。改用 vh 后，纵向尺寸跟着「高度」缩，
 * 屏幕多高都装得下一屏。横向留白才用 vw / rpx。
 *
 * 页面用 position: fixed 钉在视口上，配合 overflow: hidden：即便某台机型
 * 的 vh 算法有出入，也只是裁掉一点，不会出现滚动条。
 */
page {
  height: 100%;
  overflow: hidden;
}

.page {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  background: #10161d;
  color: #ffffff;
  /* 横屏刘海在左右两侧，躲开它 */
  padding-left: env(safe-area-inset-left);
  padding-right: env(safe-area-inset-right);
}

.hint {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6vw;
  font-size: 3.2vh;
  color: #c9d1d9;
  text-align: center;
}

/* ---------- 顶栏 ---------- */
.topbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.6vh 3vw;
  background: #182029;
}

/* 左侧信息可能很长：允许它收缩并被裁，别把右侧按钮挤出屏幕 */
.scoreline {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  display: flex;
  align-items: baseline;
}

.games {
  flex-shrink: 0;
  font-size: 5vh;
  font-weight: 700;
  letter-spacing: 0.3vw;
}

.game-index {
  flex-shrink: 0;
  margin-left: 2vw;
  font-size: 2.6vh;
  color: #8b98a6;
}

.format {
  flex-shrink: 0;
  margin-left: 1.5vw;
  font-size: 2.4vh;
  color: #8b98a6;
}

.referee {
  margin-left: 2vw;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 2.4vh;
  color: #f0c674;
}

.actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}


.btn::after {
  border: none;
}

.btn[disabled] {
  opacity: 0.4;
  color: #ffffff;
}

.btn-undo {
  background: #2a3542;
}

.btn-finish {
  background: var(--color-primary);
}

.btn-exit {
  background: transparent;
  border: 1rpx solid #3a4655;
  color: #c9d1d9;
}

/* ---------- 球场 ---------- */
/* min-height: 0 是让 flex 子项真的能收缩，否则内容会把整页顶出屏幕 */
.court {
  flex: 1;
  min-height: 0;
  display: flex;
}

.side {
  flex: 1;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: background 0.15s;
}

.side-a {
  background: #16222e;
  border-right: 2rpx solid #22303f;
}

.side-b {
  background: #1a1a26;
}

/* 领先一方整块点亮，扫一眼就知道谁在前 */
.side.is-leading {
  background: #143d2c;
}

.side.is-finished {
  opacity: 0.72;
}

.team-name {
  max-width: 88%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 4vh;
  color: #c9d1d9;
}

/* 比分是主角：用 vh 定尺寸，横屏多高就给多大，且始终留在这一屏里 */
.points {
  margin: 2vh 0;
  font-size: 36vh;
  font-weight: 700;
  line-height: 1;
}

.side.is-leading .points {
  color: #4ade80;
}

.tap-hint {
  font-size: 3.2vh;
  color: #6b7785;
}

/* ---------- 底部提示 ---------- */
/* 绝对定位浮在底部：提示出现时不占布局高度，比分区不会因此被挤下去 */
.notice {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 1.6vh 3vw;
  text-align: center;
  font-size: 2.8vh;
  color: #ffb4a2;
  background: rgba(42, 26, 26, 0.95);
}

.finished-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 1.6vh 3vw;
  text-align: center;
  font-size: 2.8vh;
  color: #8ff0b5;
  background: rgba(16, 37, 27, 0.95);
}

/* ==================== 网球（三层比分） ====================
   盘分用「盘 1 : 0」标出来，否则一排数字分不清哪层是哪层；
   本盘局分沿用 .games，本局分（15/30/40/AD）是左右两块大号文字。 */

.sets {
  flex-shrink: 0;
  margin-right: 2vw;
  padding: 0.2vh 1.2vw;
  border-radius: 1vh;
  background: rgba(255, 255, 255, 0.12);
  color: #cfe8d2;
  font-size: 2.8vh;
  font-weight: 600;
}

/* 抢七要显眼：这时的大数字是抢七分，不是局分 */
.tiebreak {
  flex-shrink: 0;
  margin-left: 1.5vw;
  padding: 0.2vh 1.2vw;
  border-radius: 1vh;
  background: #c6d93b;
  color: #1b3a1f;
  font-size: 2.6vh;
  font-weight: 600;
}

/* 网球的大数字是两个字（15/30/40/AD），36vh 会顶到边 */
.points.points-text {
  font-size: 26vh;
  letter-spacing: 0.2vw;
}

.side.is-waiting{opacity:.7}.sync-state{font-size:2.8vh;line-height:1.5;text-align:center;padding:1vh;color:var(--color-on-primary);flex-shrink:0}.points,.sets,.games{font-variant-numeric:tabular-nums}.team-name{white-space:normal;overflow-wrap:anywhere;line-height:1.25}.actions button{min-height:44px}.topbar{gap:2vw}.scoreline{flex-wrap:wrap;gap:1vh 0}
@media(max-height:360px){.actions{flex-wrap:wrap}.actions button{font-size:3vh}.topbar{padding-top:1vh;padding-bottom:1vh}}
