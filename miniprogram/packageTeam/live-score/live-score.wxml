<!-- 实时计分台：横屏，左右两块大按钮。布局以「点得到、看得清」为准 -->
<view class="page {{themeClass}}">
  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <view wx:elif="{{error}}" class="hint">{{error}}</view>
  <view wx:elif="{{blockReason}}" class="hint">{{blockReason}}</view>

  <block wx:else>
    <!-- 顶栏：比分、赛制与三个操作。
         网球是三层：盘分（大）→ 本盘局分 → 本局分（左右两块大数字），
         其余项目只有「局数 + 局分」两层，盘分那一行整个不出现。 -->
    <view class="topbar">
      <view class="scoreline">
        <text wx:if="{{view.setsText}}" class="sets">盘 {{view.setsText}}</text>
        <text class="games">{{view.gamesText}}</text>
        <text class="game-index">{{view.gameIndexText}}</text>
        <text wx:if="{{view.tiebreakText}}" class="tiebreak">{{view.tiebreakText}}</text>
        <text class="format">{{formatText}}</text>
        <text wx:if="{{refereeNotice}}" class="referee">{{refereeNotice}}</text>
      </view>
      <view class="actions">
        <button class="btn btn-undo" bindtap="onUndo" disabled="{{!canUndo || scorePending > 0 || finishing}}">撤销上一判球</button>
        <button class="btn btn-finish" bindtap="onFinish" disabled="{{!canFinish || finishing || scorePending > 0}}">
          {{finishing ? '定稿中…' : '结束比赛'}}
        </button>
        <button class="btn btn-exit" bindtap="onExit">退出</button>
      </view>
    </view>

    <!-- 球场：左 A 右 B，各占一半，整块可点 -->
    <view class="court">
      <view
        class="side side-a {{view.leading === 'A' ? 'is-leading' : ''}} {{view.finished ? 'is-finished' : ''}} {{scorePending > 0 || finishing ? 'is-waiting' : ''}}"
        data-side="A"
        bindtap="onScoreTap"
      >
        <text class="team-name">{{labelA}}</text>
        <text class="points {{view.scoring === 'tennis' ? 'points-text' : ''}}">{{view.pointsTextA}}</text>
        <text class="tap-hint">判 A 得分</text>
      </view>
      <view
        class="side side-b {{view.leading === 'B' ? 'is-leading' : ''}} {{view.finished ? 'is-finished' : ''}} {{scorePending > 0 || finishing ? 'is-waiting' : ''}}"
        data-side="B"
        bindtap="onScoreTap"
      >
        <text class="team-name">{{labelB}}</text>
        <text class="points {{view.scoring === 'tennis' ? 'points-text' : ''}}">{{view.pointsTextB}}</text>
        <text class="tap-hint">判 B 得分</text>
      </view>
    </view>

    <view class="sync-state">{{scorePending > 0 ? '正在同步判球，请稍候…' : finishing ? '正在提交定稿…' : '比分已同步 · 左 A / 右 B'}}</view>
    <view wx:if="{{notice}}" class="notice">{{notice}}</view>
    <view wx:if="{{view.finished}}" class="finished-tip">本场已分出胜负，点「结束比赛」定稿</view>
  </block>
</view>
