/* 我的球队与团队成绩 */
.total-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.total-cell { width: calc(50% - 8rpx); box-sizing: border-box; padding: 22rpx; border-radius: 12rpx; background: var(--color-bg, #f5f7f8); }
.total-label { color: var(--color-text-secondary); font-size: 26rpx; }
.total-value { font-size: 38rpx; font-weight: 600; margin: 8rpx 0; }
.season-stats { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 12rpx; }
.season-cell { width: 100%; font-size: 27rpx; }
.hero {
  padding: var(--space-lg) 0 var(--space-md);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.hero-subtitle {
  margin-top: var(--space-xs);
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.card {
  margin-bottom: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: var(--space-sm);
}

/* 汇总条：四格平分，数字在上、说明在下 */
.summary {
  display: flex;
  align-items: center;
}

.summary-cell {
  flex: 1;
  text-align: center;
}

.summary-value {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.summary-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* 一行一队 / 一届 */
.row {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.row-meta {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.row-side {
  display: flex;
  align-items: center;
  flex: none;
  margin-left: var(--space-sm);
}

.status {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.arrow {
  margin-left: var(--space-xs);
  font-size: 30rpx;
  color: var(--color-text-tertiary, #B9BDC6);
}

.tag {
  margin-left: var(--space-xs);
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: var(--color-primary-light);
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-primary-dark);
}

.tag-muted {
  background: var(--color-bg-subtle, #F2F3F5);
  color: var(--color-text-secondary);
}

.tag-medal {
  background: #FFF3D6;
  color: #9A6B00;
}

/* 荣誉：名次方块 + 赛事与球队 */
.honor {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
}

.honor-medal {
  width: 88rpx;
  flex: none;
  padding: 8rpx 0;
  border-radius: var(--radius-md);
  background: #FFF3D6;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #9A6B00;
}

.honor-main {
  margin-left: var(--space-sm);
}

.honor-event {
  font-size: 27rpx;
  color: var(--color-text-primary);
}

.honor-team {
  margin-top: 2rpx;
  font-size: 23rpx;
  color: var(--color-text-secondary);
}

/* 累计表 */
.stat-head {
  display: flex;
  align-items: center;
  padding: var(--space-xs) 0;
  border-bottom: 1rpx solid var(--color-border);
  font-size: 23rpx;
  color: var(--color-text-secondary);
}

.stat-row {
  display: flex;
  align-items: center;
  padding: var(--space-xs) 0;
  border-bottom: 1rpx solid var(--color-border);
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.stat-total {
  border-bottom: none;
  font-weight: 600;
}

.col-name {
  flex: 2;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.col {
  flex: 1;
  text-align: center;
}

.hint-inline {
  margin: var(--space-xs) 0;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.hint {
  padding: var(--space-xl) 0;
  text-align: center;
  font-size: 27rpx;
  color: var(--color-text-secondary);
}
