/*
 * 全部赛事 / 全部学院赛
 * 行样式与赛事页共用 templates/event-list.wxss，这里只补探索器与分页控件。
 */
@import "../../templates/event-list.wxss";

.explorer {
  padding: var(--space-md);
}

.explorer-search {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  min-height: var(--control-min-height);
  padding: 0 var(--space-xs) 0 var(--space-md);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg);
  box-sizing: border-box;
}

.explorer-input {
  flex: 1;
  min-width: 0;
  min-height: var(--control-min-height);
  font-size: var(--font-body);
}

.explorer-clear,
.explorer-submit,
.explorer-reset {
  min-height: var(--control-min-height);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-sm);
  font-size: var(--font-sm);
  border-radius: var(--radius-sm);
  box-sizing: border-box;
}

.explorer-clear {
  color: var(--color-text-secondary);
}

.explorer-submit {
  color: var(--color-primary-dark);
  background: var(--color-primary-light);
  font-weight: 600;
}

.explorer-filters {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-sm);
}

.explorer-picker {
  flex: 1;
  min-width: 180rpx;
}

.explorer-select {
  min-height: var(--control-min-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--space-md);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
  box-sizing: border-box;
}

.explorer-reset {
  color: var(--color-primary-dark);
  padding: 0 var(--space-md);
}

.explorer-summary {
  margin-top: var(--space-sm);
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
}

.event-assoc-glyph {
  flex-shrink: 0;
  margin-right: 6rpx;
  color: var(--color-primary-dark);
  font-weight: 600;
}

.explorer-foot {
  margin-top: var(--space-md);
  text-align: center;
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
}

.explorer-more-error {
  margin-top: var(--space-sm);
  text-align: center;
  color: var(--color-danger-text);
  font-size: var(--font-caption);
}

.event-more {
  margin-top: var(--space-sm);
}

.event-retry,
.event-empty-reset {
  margin-top: var(--space-md);
}

.event-empty {
  padding-top: var(--space-lg);
}

@media (max-width: 360px) {
  .explorer-picker {
    min-width: 100%;
  }
}
