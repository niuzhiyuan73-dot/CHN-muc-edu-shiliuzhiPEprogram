/*
 * 赛事详情样式
 * 名单行、名次行与「我」的标记复用 templates/rank-board.wxss，与榜单同一副面孔。
 * 这里只写本页独有的赛事信息与名单右侧的动作。
 */
@import "../../templates/rank-board.wxss";

/* ==================== 赛事信息 ==================== */

.event-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--space-sm);
  border-bottom: 2rpx solid var(--color-divider);
}

.event-title {
  font-size: var(--font-lg);
  font-weight: 600;
  margin-right: var(--space-sm);
}

.event-info {
  padding-top: var(--space-sm);
}

.event-info-row {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
}

.event-info-label {
  width: 110rpx;
  flex-shrink: 0;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.event-info-value {
  flex: 1;
  min-width: 0;
  font-size: var(--font-sm);
  color: var(--color-text);
}

/* 说明文字是补充信息，压小压淡，不跟时间地点抢 */
.event-desc {
  margin-top: var(--space-sm);
  padding-top: var(--space-sm);
  border-top: 2rpx solid var(--color-divider);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.7;
}

/* ==================== 我的报名 ==================== */

.signup-line {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-md);
}

.signup-state {
  color: var(--color-primary);
  font-weight: 600;
}

.signup-note {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

/* ==================== 管理动作 ==================== */

/* 两个管理按钮叠在一起时留一道缝，免得点错 */
.btn-gap {
  margin-top: var(--space-sm);
}

/* ==================== 名单右侧的动作 ==================== */

.signup-checkin {
  flex-shrink: 0;
  margin-left: var(--space-sm);
  padding: 8rpx 24rpx;
  font-size: var(--font-sm);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-sm);
}

.signup-checked {
  flex-shrink: 0;
  margin-left: var(--space-sm);
  font-size: var(--font-md);
  color: var(--color-success);
}

/* ==================== 签表 ==================== */

/* 一轮一行：左边轮次标签，右边对阵与动作，窄屏也好读 */
.bracket-row {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.bracket-row:last-child {
  border-bottom: none;
}

.bracket-round {
  flex-shrink: 0;
  width: 130rpx;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.bracket-main {
  flex: 1;
  min-width: 0;
}

.bracket-teams {
  display: flex;
  align-items: center;
  font-size: var(--font-sm);
}

.bracket-team.is-winner {
  color: var(--color-primary);
  font-weight: 600;
}

.bracket-vs {
  margin: 0 var(--space-sm);
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.bracket-meta {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

.bracket-score {
  margin-right: var(--space-sm);
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* 与「比赛」页的小按钮同款：这里不 import 那张样式表，只抄这一小块 */
.mini-btn {
  flex-shrink: 0;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 var(--space-md);
  margin-left: var(--space-sm);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  border: 2rpx solid var(--color-border);
  color: var(--color-text-secondary);
}

.mini-btn.is-primary {
  border-color: var(--color-primary);
  color: var(--color-primary);
}

/* ==================== 演示口径提示 ==================== */

.demo-notice {
  font-size: var(--font-xs);
  color: #b45309;
  background: #fef3c7;
  border-radius: var(--radius-sm);
  padding: var(--space-sm) var(--space-md);
  margin-bottom: var(--space-md);
  line-height: 1.5;
}

/* ==================== 手工指定种子面板 ==================== */

/* 与会员审核页的驳回面板同款（.sheet-*）：页面样式表按页隔离，这里写一份 */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.sheet {
  width: 100%;
  background: var(--color-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: var(--space-lg);
  padding-bottom: calc(var(--space-lg) + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: var(--font-lg);
  font-weight: 600;
}

.sheet-hint {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-top: var(--space-xs);
  line-height: 1.5;
}

.sheet-error {
  margin-top: var(--space-xs);
  font-size: var(--font-xs);
  color: var(--color-danger);
}

.sheet-actions {
  display: flex;
  margin-top: var(--space-md);
}

.sheet-btn {
  flex: 1;
}

.sheet-btn + .sheet-btn {
  margin-left: var(--space-sm);
}

/* 人数可能十来个，给一个限高的滚动区，免得面板顶到屏幕外 */
.seed-list {
  max-height: 640rpx;
  margin-top: var(--space-md);
}

.seed-row {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.seed-row:last-child {
  border-bottom: none;
}

/* 已选的行整条染上主色，一眼看出点了哪些 */
.seed-row.is-picked {
  background: rgba(20, 122, 63, 0.06);
}

.seed-order {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  margin-right: var(--space-sm);
  border-radius: 50%;
  text-align: center;
  font-size: var(--font-sm);
  color: #ffffff;
  background: var(--color-divider);
}

.seed-row.is-picked .seed-order {
  background: var(--color-primary);
}

.seed-avatar {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin-right: var(--space-sm);
  border-radius: 50%;
  overflow: hidden;
  text-align: center;
  font-size: var(--font-md);
  color: #ffffff;
  background: var(--color-primary);
}

.seed-avatar-img {
  width: 64rpx;
  height: 64rpx;
  display: block;
}

.seed-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-md);
}

.seed-mark {
  flex-shrink: 0;
  margin-left: var(--space-sm);
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.seed-row.is-picked .seed-mark {
  color: var(--color-primary);
}
