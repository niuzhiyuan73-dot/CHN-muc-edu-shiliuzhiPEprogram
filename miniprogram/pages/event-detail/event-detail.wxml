<!--
  赛事详情
  数据形状见 services/events-view.js 的 loadEventDetailView。
  名单行与名次行复用 templates/rank-board.wxss 的样式，与榜单同一副面孔。
-->
<view class="page-container">

  <!-- 加载中。必须排在出错之前，否则首屏会一闪而过地报错 -->
  <view wx:if="{{loading}}" class="loading">正在加载…</view>

  <view wx:elif="{{error}}" class="empty-state">
    <view class="empty-state-icon">⚠️</view>
    <view class="empty-state-text">{{error}}</view>
  </view>

  <view wx:elif="{{!view.found}}" class="empty-state">
    <view class="empty-state-icon">🔒</view>
    <view class="empty-state-text">{{view.notFoundText}}</view>
  </view>

  <block wx:else>

    <!-- ========== 赛事信息 ========== -->
    <view class="card">
      <view class="event-head">
        <view class="event-title">{{view.event.title}}</view>
        <text class="tag {{view.event.isSignup ? 'tag-success' : (view.event.isOngoing ? 'tag-warning' : 'tag-gray')}}">{{view.event.statusLabel}}</text>
      </view>

      <view class="event-info">
        <view class="event-info-row">
          <text class="event-info-label">时间</text>
          <text class="event-info-value">{{view.event.timeText}}</text>
        </view>
        <view class="event-info-row">
          <text class="event-info-label">场地</text>
          <text class="event-info-value">{{view.event.location || '待定'}}</text>
        </view>
        <view class="event-info-row">
          <text class="event-info-label">项目</text>
          <text class="event-info-value">{{view.event.levelLabel}} · {{view.event.matchTypeLabel}}{{view.event.disciplineLabel ? ' · ' + view.event.disciplineLabel : ''}} · {{view.event.formatLabel}}</text>
        </view>
        <view class="event-info-row">
          <text class="event-info-label">名额</text>
          <text class="event-info-value">{{view.event.quotaText}}</text>
        </view>
      </view>

      <view wx:if="{{view.event.description}}" class="event-desc">{{view.event.description}}</view>
    </view>

    <!-- ========== 我的报名 ========== -->
    <view wx:if="{{view.event.isSignup}}" class="card">
      <view class="card-title">报名</view>
      <view class="signup-line">我的状态：<text class="signup-state">{{view.event.mySignupLabel}}</text></view>

      <view wx:if="{{view.event.canSignUp}}" class="btn btn-primary btn-block" bindtap="onSignUp">报名</view>
      <view wx:elif="{{view.event.canCancelSignup}}" class="btn btn-outline btn-block" bindtap="onCancelSignup">取消报名</view>
      <view wx:else class="signup-note">报名已截止，或你当前的状态不能报名</view>
    </view>

    <!-- ========== 管理动作 ========== -->
    <!-- 没有管理权时整张卡不渲染，不给点了再被拒的机会 -->
    <view wx:if="{{view.event.canStart || view.event.canFinish}}" class="card">
      <view class="card-title">管理</view>
      <view wx:if="{{view.event.canStart}}" class="btn btn-primary btn-block" bindtap="onStart">开始赛事</view>
      <view wx:if="{{view.event.canFinish}}" class="btn btn-accent btn-block btn-gap" bindtap="onOpenPlacement">录入名次并结束</view>
    </view>

    <!-- ========== 抽签 ========== -->
    <!-- 只有「已抽签」或「当前能抽签」时才出现，普通会员看没抽签的赛事不必被打扰 -->
    <view wx:if="{{view.event.canDraw || view.event.drawn}}" class="card">
      <view class="rank-head">
        <view class="rank-head-title">抽签</view>
        <view wx:if="{{view.drawText}}" class="rank-head-count">{{view.drawText}}</view>
      </view>

      <view wx:if="{{view.byeText}}" class="empty-note">{{view.byeText}}</view>

      <!-- 手工指定种子：说清要点几位，免得点开了面板不知道点几个 -->
      <view wx:if="{{view.event.isManualSeed}}" class="empty-note">
        本场手工指定种子：抽签前按顺序点名 {{view.manualSeedNeeded}} {{view.seedUnit}}，先点的排 1 号
      </view>

      <view
        wx:if="{{view.event.canDraw}}"
        class="btn btn-primary btn-block {{acting ? 'btn-disabled' : ''}}"
        bindtap="onDraw"
      >{{view.event.drawn ? '重新抽签' : '开始抽签'}}</view>
    </view>

    <!-- ========== 积分表（循环赛 / 小组赛） ========== -->
    <view wx:if="{{view.hasStandings}}" class="card">
      <view class="rank-head">
        <view class="rank-head-title">积分表</view>
      </view>

      <view wx:for="{{view.standings}}" wx:for-item="group" wx:key="group" class="standings-group">
        <view class="standings-group-title">{{group.groupLabel}}</view>

        <view class="standings-row standings-head">
          <text class="standings-rank">名次</text>
          <text class="standings-name">姓名</text>
          <text class="standings-cell">胜</text>
          <text class="standings-cell">负</text>
          <text class="standings-cell">净胜局</text>
          <text class="standings-cell">净胜分</text>
        </view>

        <view
          wx:for="{{group.rows}}"
          wx:key="userId"
          class="standings-row {{item.isMe ? 'is-me' : ''}}"
        >
          <text class="standings-rank">{{item.rank}}</text>
          <view class="standings-name">
            <image wx:if="{{item.avatarUrl}}" class="standings-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
            <text wx:else class="standings-avatar-text">{{item.avatarText}}</text>
            <text class="standings-nick">{{item.nickName}}</text>
          </view>
          <text class="standings-cell">{{item.wins}}</text>
          <text class="standings-cell">{{item.losses}}</text>
          <text class="standings-cell">{{item.gameDiffText}}</text>
          <text class="standings-cell">{{item.pointDiffText}}</text>
        </view>
      </view>
    </view>

    <!-- ========== 签表 ========== -->
    <view wx:if="{{view.hasBracket}}" class="card">
      <view class="rank-head">
        <view class="rank-head-title">签表</view>
      </view>

      <view wx:for="{{view.bracketRows}}" wx:key="matchId" class="bracket-row">
        <view class="bracket-round">{{item.groupText ? item.groupText + ' · ' : ''}}{{item.roundText}}</view>

        <view class="bracket-main">
          <view class="bracket-teams">
            <text class="bracket-team {{item.winnerSide === 'A' ? 'is-winner' : ''}}">{{item.teamAText}}</text>
            <text class="bracket-vs">vs</text>
            <text class="bracket-team {{item.winnerSide === 'B' ? 'is-winner' : ''}}">{{item.teamBText}}</text>
          </view>
          <view class="bracket-meta">
            <text wx:if="{{item.scoreText}}" class="bracket-score">{{item.scoreText}}</text>
            <text class="tag {{item.statusClass}}">{{item.statusLabel}}</text>
          </view>

          <!-- 正在逐球计分的场次：当前比分与局分顶在原名次位置，标「进行中 / 已结束」 -->
          <view wx:if="{{item.liveActive}}" class="bracket-live">
            <text class="live-tag {{item.live.finished ? 'is-done' : ''}}">{{item.live.statusLabel}}</text>
            <text class="live-score">{{item.live.scoreText}}</text>
            <text class="live-games">局分 {{item.live.gamesText}} · {{item.live.gameIndexText}}</text>
          </view>

          <!-- 裁判：指派的场次标出是谁执法；他自己也在场上时给个提示（Q5） -->
          <view wx:if="{{item.hasReferee}}" class="bracket-referee">
            <text class="referee-label">裁判</text>
            <text class="referee-name">{{item.refereeName}}</text>
            <text wx:if="{{item.refereeIsParticipant}}" class="referee-flag">兼参赛</text>
          </view>
          <view wx:if="{{item.refereeNotice}}" class="bracket-referee-notice">{{item.refereeNotice}}</view>
        </view>

        <!-- 还没比分先录分；录完才轮到对手确认。指派裁判只给管理员 -->
        <view
          wx:if="{{item.canAssignReferee}}"
          class="mini-btn"
          data-match-id="{{item.matchId}}"
          bindtap="onOpenReferee"
        >{{item.hasReferee ? '改派裁判' : '指派裁判'}}</view>
        <view
          wx:if="{{item.canRecord}}"
          class="mini-btn is-primary"
          data-match-id="{{item.matchId}}"
          bindtap="onRecordMatch"
        >录分</view>
        <view
          wx:elif="{{item.canConfirm}}"
          class="mini-btn is-primary"
          data-match-id="{{item.matchId}}"
          bindtap="onConfirmMatch"
        >确认</view>
      </view>
    </view>

    <!-- ========== 报名名单（未结束） ========== -->
    <view wx:if="{{!view.event.isFinished}}" class="card">
      <view class="rank-head">
        <view class="rank-head-title">报名名单</view>
        <view class="rank-head-count">{{view.event.quotaText}}</view>
      </view>

      <view wx:if="{{!view.hasSignups}}" class="empty-note">{{view.signupsEmptyNote}}</view>

      <view
        wx:for="{{view.signupRows}}"
        wx:key="userId"
        class="rank-row {{item.isMe ? 'is-me' : ''}}"
      >
        <view class="rank-avatar">
          <image wx:if="{{item.avatarUrl}}" class="rank-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" />
          <text wx:else>{{item.avatarText}}</text>
        </view>

        <view class="rank-main">
          <view class="rank-name">
            <text>{{item.nickName}}</text>
            <text wx:if="{{item.isMe}}" class="rank-me-tag">我</text>
          </view>
          <view class="rank-detail">
            <text>{{item.statusLabel}}</text>
            <text wx:if="{{item.statText}}" class="signup-stat">{{item.statText}}</text>
          </view>
        </view>

        <!-- 代签：进行中且未签到时才出现 -->
        <view
          wx:if="{{item.canCheckIn}}"
          class="signup-checkin"
          data-user-id="{{item.userId}}"
          catchtap="onCheckIn"
        >代签</view>
        <view wx:elif="{{item.checkedIn}}" class="signup-checked">✓</view>
      </view>
    </view>

    <!-- ========== 最终名次（已结束） ========== -->
    <view wx:if="{{view.event.isFinished}}" class="card">
      <view class="rank-head">
        <view class="rank-head-title">最终名次</view>
      </view>

      <view wx:if="{{!view.hasResults}}" class="empty-note">这场赛事还没有录入名次</view>

      <view
        wx:for="{{view.resultRows}}"
        wx:key="userId"
        class="rank-row {{item.isMe ? 'is-me' : ''}}"
        data-user-id="{{item.userId}}"
        bindtap="onOpenMember"
      >
        <view class="rank-no {{item.medal ? 'is-' + item.medal : ''}}">{{item.placement}}</view>

        <view class="rank-avatar">
          <image wx:if="{{item.avatarUrl}}" class="rank-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" />
          <text wx:else>{{item.avatarText}}</text>
        </view>

        <view class="rank-main">
          <view class="rank-name">
            <text>{{item.nickName}}</text>
            <text wx:if="{{item.isMe}}" class="rank-me-tag">我</text>
          </view>
        </view>

        <view class="rank-value-box">
          <view class="rank-note">{{item.placementText}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{isMock}}" class="mock-note">
      当前为本地模拟数据，报名与名次只写入内存，重启小程序即清空
    </view>
  </block>

  <!-- ========== 手工指定种子 ========== -->
  <!-- 用页内面板而不是 wx.showModal：要挑的人可能有十来个，弹窗里放不下列表 -->
  <view wx:if="{{seedDialogOpen}}" class="sheet-mask" bindtap="onCloseSeedDialog">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">指定种子顺序</view>
      <view class="sheet-hint">
        按顺序点选 {{view.manualSeedNeeded}} {{view.seedUnit}}，先点的排 1 号；再点一次可取消。
        已选 {{seedPicked.length}}/{{view.manualSeedNeeded}}
        <block wx:if="{{view.event.isDoubles}}">（相邻两人自动组成一队）</block>
      </view>

      <scroll-view scroll-y class="seed-list">
        <view
          wx:for="{{seedRows}}"
          wx:key="userId"
          class="seed-row {{item.order ? 'is-picked' : ''}}"
          data-user-id="{{item.userId}}"
          bindtap="onToggleSeed"
        >
          <view class="seed-order">{{item.order ? item.order : ''}}</view>
          <view class="seed-avatar">
            <image wx:if="{{item.avatarUrl}}" class="seed-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" />
            <text wx:else>{{item.avatarText}}</text>
          </view>
          <view class="seed-name">{{item.nickName}}</view>
          <view class="seed-mark">{{item.order ? '已选' : '点选'}}</view>
        </view>
      </scroll-view>

      <view wx:if="{{seedError}}" class="sheet-error">{{seedError}}</view>

      <view class="sheet-actions">
        <view class="btn btn-outline sheet-btn" bindtap="onClearSeeds">清空</view>
        <view
          class="btn btn-primary sheet-btn {{acting ? 'btn-disabled' : ''}}"
          bindtap="onConfirmSeeds"
        >开始抽签</view>
      </view>
    </view>
  </view>

  <!-- ========== 指派裁判面板 ========== -->
  <!-- 与比赛页同一套面板，管理员在两处用起来一致 -->
  <view wx:if="{{referee.open}}" class="sheet-mask" bindtap="onCancelReferee">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{referee.hasReferee ? '改派裁判' : '指派裁判'}}</view>
      <view class="sheet-hint">指定后，这一场的录分与确认都只由该裁判与管理员处理</view>
      <input
        class="sheet-input referee-search"
        value="{{referee.keyword}}"
        placeholder="搜索昵称或真实姓名"
        bindinput="onInputRefereeKeyword"
      />
      <!-- 已经指派过才给「撤下」；没指派时摆一个空按钮只会让人误点 -->
      <view
        wx:if="{{referee.hasReferee}}"
        class="btn btn-outline btn-block referee-clear {{refereeActing ? 'btn-disabled' : ''}}"
        bindtap="onClearReferee"
      >撤下裁判</view>
      <scroll-view scroll-y class="referee-list">
        <view wx:if="{{referee.rows.length === 0}}" class="empty-note">{{referee.emptyText}}</view>
        <view
          wx:for="{{referee.rows}}"
          wx:key="id"
          class="referee-row {{item.selected ? 'is-selected' : ''}}"
          data-user-id="{{item.id}}"
          bindtap="onPickReferee"
        >
          <view class="referee-avatar">{{item.avatarText}}</view>
          <view class="referee-row-name">{{item.name}}</view>
          <text wx:if="{{item.selected}}" class="referee-check">当前</text>
        </view>
      </scroll-view>
      <view class="sheet-actions">
        <view class="btn btn-outline sheet-btn" bindtap="onCancelReferee">关闭</view>
      </view>
    </view>
  </view>
</view>
