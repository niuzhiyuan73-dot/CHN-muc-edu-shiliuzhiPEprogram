<!--
  赛季管理
  数据形状见 services/season-view.js 的 loadSeasonManageView。
  这里不做任何权限推导：allowed 是视图模型算好的，不够就整页挡住。
-->
<view class="page-container">

  <!-- 加载中。必须排在出错之前，否则首屏会一闪而过地报错 -->
  <view wx:if="{{loading}}" class="loading">正在加载…</view>

  <view wx:elif="{{error}}" class="empty-state">
    <view class="empty-state-icon">⚠️</view>
    <view class="empty-state-text">{{error}}</view>
  </view>

  <!-- 没有管理权时不给任何赛季数据 -->
  <view wx:elif="{{!view.allowed}}" class="empty-state">
    <view class="empty-state-icon">🔒</view>
    <view class="empty-state-text">{{view.blockedText}}</view>
  </view>

  <block wx:else>

    <!-- ========== 当前赛季 ========== -->
    <view class="card">
      <view class="season-head">
        <text class="season-version">{{view.versionText}}</text>
        <text class="tag season-state {{view.hasReset ? 'is-reset' : 'is-clean'}}">
          {{view.hasReset ? '已重置' : '进行中'}}
        </text>
      </view>

      <view class="season-row">
        <text class="season-label">赛季锚点</text>
        <text class="season-value">{{view.anchorText}}</text>
      </view>

      <view class="season-row">
        <text class="season-label">上次重置</text>
        <text class="season-value">{{view.resetText}}</text>
      </view>
    </view>

    <!-- ========== 重置说明 ========== -->
    <view class="card">
      <view class="card-title">重置后会怎么压分</view>
      <view class="season-policy">{{view.policyText}}</view>
      <view class="season-warn">
        重置只记录分界点，全俱乐部的分数会在下一次读取时按上述规则统一重算；
        起点分（进步榜用）也会一起刷新，因此进步榜不会把上赛季的积累算进来。
      </view>

      <view
        class="btn btn-danger btn-block {{acting ? 'is-disabled' : ''}}"
        bindtap="onReset"
      >{{acting ? '正在重置…' : '开始新赛季（重置）'}}</view>
    </view>

    <!-- 重置权来自演示口径时必须在页面上说清楚，别被当成真实规则 -->
    <view wx:if="{{view.demoNotice}}" class="demo-notice">{{view.demoNotice}}</view>

    <view wx:if="{{isMock}}" class="mock-note">
      当前为本地模拟数据，重置只写入内存，重启小程序即清空
    </view>
  </block>
</view>
