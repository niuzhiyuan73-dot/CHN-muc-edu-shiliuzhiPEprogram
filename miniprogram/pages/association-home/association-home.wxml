<!--
  协会工作台
  顶部是当前协会的名头 + 「协会空间 / 排行榜 / 比赛 / 赛事」四个页签，
  下面按页签挂载对应的面板组件。各面板各自取数，互不干扰。
-->
<view class="page-container {{themeClass}}">

  <!-- 当前协会的名头。工作台只服务一个协会，页面内不再提供切换（切换回「协会」页签） -->
  <!-- 名头：渐变圆底 + 运动线条图标（缺省退回文字徽标） -->
  <view class="ws-head">
    <view class="ws-head-glyph">
      <image wx:if="{{associationIcon}}" class="ws-head-glyph-icon" src="{{associationIcon}}" mode="aspectFit" />
      <text wx:else>{{associationGlyph}}</text>
    </view>
    <view class="ws-head-main">
      <view class="ws-head-name">{{associationName}}</view>
      <view class="ws-head-note">协会空间 · 排行榜 · 比赛 · 赛事</view>
    </view>
  </view>

  <!-- 一级页签：下划线式（二级胶囊、三级药丸，样式分级见 wxss 内说明） -->
  <view class="pool-tabs ws-tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="tab"
      class="pool-tab {{item.active ? 'is-active' : ''}}"
      data-tab="{{item.tab}}"
      bindtap="onSwitchTab"
    >
      <view class="pool-tab-label">{{item.label}}</view>
    </view>
  </view>

  <!-- 面板：挂过的保持挂载，用 hidden 收起来，来回切页签不丢状态 -->
  <view wx:if="{{mounted.space}}" hidden="{{activeTab !== 'space'}}">
    <association-space-panel id="space" />
  </view>
  <view wx:if="{{mounted.rank}}" hidden="{{activeTab !== 'rank'}}">
    <rank-panel id="rank" />
  </view>
  <view wx:if="{{mounted.match}}" hidden="{{activeTab !== 'match'}}">
    <match-panel id="match" />
  </view>
  <view wx:if="{{mounted.events}}" hidden="{{activeTab !== 'events'}}">
    <events-panel id="events" />
  </view>

</view>
