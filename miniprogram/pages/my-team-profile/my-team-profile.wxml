<!--
  我的球队与团队成绩
  一段一段说清楚：我在哪支队 → 拿过什么名次 → 打过哪几届 → 累计多少。
  「—」表示这项没记录，不等于 0。
-->
<view class="page-container {{themeClass}}">
  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <view wx:elif="{{error}}" class="hint">{{error}}</view>

  <block wx:else>
    <view class="hero">
      <view class="hero-title">我的球队</view>
      <view class="hero-subtitle">{{profile.name}} · {{profile.totals.recordText}}</view>
    </view>

    <!-- 汇总：出场 / 胜负 / 场均得分，一眼看完 -->
    <view class="card summary">
      <view class="summary-cell">
        <view class="summary-value">{{profile.totals.games}}</view>
        <view class="summary-label">{{isFootball ? '已记录出场' : '出场'}}</view>
      </view>
      <view class="summary-cell" wx:if="{{!isFootball}}">
        <view class="summary-value">{{profile.totals.wins}}</view>
        <view class="summary-label">胜</view>
      </view>
      <view class="summary-cell" wx:if="{{!isFootball}}">
        <view class="summary-value">{{profile.totals.losses}}</view>
        <view class="summary-label">负</view>
      </view>
      <view class="summary-cell" wx:if="{{!isFootball}}">
        <view class="summary-value">{{profile.totals.pointsPerGameText}}</view>
        <view class="summary-label">场均得分</view>
      </view>
      <view class="summary-cell" wx:if="{{isFootball}}"><view class="summary-value">{{profile.totals.goalsText}}</view><view class="summary-label">进球</view></view>
      <view class="summary-cell" wx:if="{{isFootball}}"><view class="summary-value">{{profile.totals.assistsText}}</view><view class="summary-label">助攻</view></view>
    </view>

    <!-- 我的球队：在队的排在前面，离队的留作历史 -->
    <view class="card">
      <view class="card-title">我的球队</view>
      <view wx:if="{{profile.teams.length === 0}}" class="hint-inline">
        还没有加入球队。在「组队」页签里可以申请入队，或自己建一支。
      </view>
      <view
        wx:for="{{profile.teams}}"
        wx:key="teamId"
        class="row"
        data-teamid="{{item.teamId}}"
        bindtap="onOpenTeam"
      >
        <view class="row-main">
          <view class="row-title">
            {{item.name}}
            <text wx:if="{{item.isCaptain}}" class="tag">队长</text>
            <text wx:if="{{!item.current}}" class="tag tag-muted">{{item.memberStatusLabel}}</text>
          </view>
          <view class="row-meta">{{item.memberCount}} 人 · {{item.recordText}}</view>
        </view>
        <view class="row-side">
          <view class="status">{{item.statusLabel}}</view>
          <view class="arrow">›</view>
        </view>
      </view>
    </view>

    <!-- 团队荣誉：只算前三名 -->
    <view wx:if="{{profile.honors.length > 0}}" class="card">
      <view class="card-title">团队荣誉</view>
      <view wx:for="{{profile.honors}}" wx:key="eventId" class="honor">
        <view class="honor-medal">{{item.placementText}}</view>
        <view class="honor-main">
          <view class="honor-event">{{item.eventName}}</view>
          <view class="honor-team">{{item.teamName}}{{isFootball ? ' · 报名成员' : ''}}</view>
        </view>
      </view>
    </view>

    <!-- 参赛经历：按赛事列，退队后仍然在 -->
    <view class="card">
      <view class="card-title">参赛经历</view>
      <view wx:if="{{profile.events.length === 0}}" class="hint-inline">还没有代表球队报名过赛事。</view>
      <view
        wx:for="{{profile.events}}"
        wx:key="eventId"
        class="row"
        data-eventid="{{item.eventId}}"
        bindtap="onOpenEvent"
      >
        <view class="row-main">
          <view class="row-title">
            {{item.name}}
            <text wx:if="{{item.placementText}}" class="tag tag-medal">{{item.placementText}}</text>
          </view>
          <view class="row-meta">{{item.teamName}} · {{item.recordText}}</view>
        </view>
        <view class="row-side">
          <view class="status">{{item.statusLabel}}</view>
          <view class="arrow">›</view>
        </view>
      </view>
    </view>

    <!-- 跨赛事累计：按赛事分组，不同届不混算 -->
    <view class="card" wx:if="{{!isFootball}}">
      <view class="card-title">跨赛事累计</view>
      <view class="hint-inline">只算已发布的比赛；「—」表示这项没记录，不等于 0。</view>
      <view class="stat-head">
        <view class="col-name">赛事</view>
        <view class="col">场次</view>
        <view class="col">得分</view>
        <view class="col">篮板</view>
        <view class="col">助攻</view>
      </view>
      <view wx:for="{{profile.statEvents}}" wx:key="eventId" class="stat-row">
        <view class="col-name">{{item.name}}</view>
        <view class="col">{{item.games}}</view>
        <view class="col">{{item.pointsText}}</view>
        <view class="col">{{item.reboundsText}}</view>
        <view class="col">{{item.assistsText}}</view>
      </view>
      <view class="stat-row stat-total">
        <view class="col-name">合计</view>
        <view class="col">{{profile.totals.games}}</view>
        <view class="col">{{profile.totals.pointsText}}</view>
        <view class="col">{{profile.totals.reboundsText}}</view>
        <view class="col">{{profile.totals.assistsText}}</view>
      </view>
      <view class="hint-inline">
        场均：得分 {{profile.totals.pointsPerGameText}} · 篮板 {{profile.totals.reboundsPerGameText}}
        · 助攻 {{profile.totals.assistsPerGameText}}
      </view>
    </view>
    <view class="card" wx:if="{{isFootball}}">
      <view class="card-title">足球累计 · 已发布报告</view>
      <view class="hint-inline">未记录显示「—」；出场只认具名报告。球队已发布 {{profile.totals.eligibleMatchCount}} 场、名单已记录 {{profile.totals.lineupRecordedMatches}} 场；未记录名单不推定缺席。牌不推定出场，点球大战不计进球。</view>
      <view wx:for="{{profile.statEvents}}" wx:key="eventId" class="row"><view class="row-main"><view class="row-title">{{item.name}}</view><view class="row-meta">出场 {{item.games}} · 进球 {{item.goalsText}} · 助攻 {{item.assistsText}}</view><view class="row-meta">黄牌 {{item.yellowCardsText}} · 罚下 {{item.dismissalsText}} · 进球已记录 {{item.goalsRecordedMatches || 0}} 场</view></view></view>
      <view class="hint-inline">累计黄牌 {{profile.totals.yellowCardsText}} · 累计罚下 {{profile.totals.dismissalsText}}</view>
    </view>
  </block>
</view>
