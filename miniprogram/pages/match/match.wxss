/*
 * 比赛页样式
 * 标签栏（.pool-tabs）与按钮（.btn）的样式在 app.wxss 里，与其它页共用。
 */

/* ==================== 录入入口 ==================== */

.entry-bar {
  padding: var(--space-md) var(--space-lg);
}

.entry-hint {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-sm);
  text-align: center;
}

/* ==================== 标签上的待确认数量 ==================== */

/* 做成小圆点挂在文字后面，扫一眼就知道有没有事要做 */
.tab-count {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  margin-left: 6rpx;
  border-radius: 16rpx;
  font-size: var(--font-xs);
  text-align: center;
  background: var(--color-accent);
  color: #ffffff;
}

/* ==================== 演示口径提示 ==================== */

/* 这条不能做成淡淡的小字——它说明的是权限规则被放宽了，
   看漏了就会把演示口径当成正式规则 */
.demo-notice {
  font-size: var(--font-xs);
  color: #b45309;
  background: #fef3c7;
  border-radius: var(--radius-sm);
  padding: var(--space-sm) var(--space-md);
  margin-bottom: var(--space-md);
  line-height: 1.5;
}

.more-note {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  padding-bottom: var(--space-sm);
}

/* ==================== 一场比赛 ==================== */

.match-row {
  padding: var(--space-md) 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.match-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

/* 项目 · 赛制 · 胜负 · 状态挤在一行，用换行兜底窄屏 */
.match-line1 {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.match-type {
  font-size: var(--font-sm);
  font-weight: 600;
}

/* 赛制（11 分制 · 三局两胜）是这一版的落点，
   给它比正文淡、比其它标记显眼的位置 */
.match-format {
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: var(--radius-sm);
  padding: 2rpx 10rpx;
  margin-left: var(--space-xs);
}

.match-result {
  margin-left: var(--space-xs);
  font-size: var(--font-sm);
  font-weight: 600;
}

.match-result.is-win {
  color: var(--color-success);
}

.match-result.is-loss {
  color: var(--color-danger);
}

/* 状态标签推到最右边，四种状态各一个颜色 */
.match-status {
  margin-left: auto;
}

.tag.is-pending {
  background: #fef3c7;
  color: #b45309;
}

.tag.is-active {
  background: #dcfce7;
  color: #15803d;
}

.tag.is-revoked {
  background: var(--color-divider);
  color: var(--color-text-tertiary);
}

.tag.is-unknown {
  background: var(--color-divider);
  color: var(--color-text-secondary);
}

/* ---------- 对阵 ---------- */

.match-teams {
  display: flex;
  align-items: flex-start;
  margin-top: var(--space-xs);
}

.team {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
}

/* 胜方的名字加粗，一眼看出谁赢了 */
.team.is-winner .team-name {
  font-weight: 600;
  color: var(--color-text);
}

/* 队名可点，给一条淡淡的下划线暗示 */
.team-name {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  margin-right: var(--space-xs);
  border-bottom: 2rpx solid var(--color-divider);
}

.match-vs {
  flex-shrink: 0;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  padding: 0 var(--space-sm);
  line-height: 2;
}

.match-score {
  margin-top: var(--space-xs);
  font-size: var(--font-lg);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.match-meta {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.match-reason {
  margin-top: var(--space-xs);
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  padding: var(--space-xs) var(--space-sm);
  line-height: 1.5;
}

/* ---------- 行内操作 ---------- */

.match-actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--space-sm);
}

.mini-btn {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 var(--space-md);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  margin-right: var(--space-sm);
  border: 2rpx solid var(--color-border);
  color: var(--color-text-secondary);
}

.mini-btn.is-primary {
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.mini-btn.is-danger {
  border-color: var(--color-danger);
  color: var(--color-danger);
}

/* ==================== 撤销 / 驳回面板 ==================== */

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.sheet {
  width: 100%;
  background: var(--color-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: var(--space-lg);
  padding-bottom: calc(var(--space-lg) + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: var(--font-lg);
  font-weight: 600;
}

.sheet-hint {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-top: var(--space-xs);
  line-height: 1.5;
}

.sheet-input {
  width: 100%;
  box-sizing: border-box;
  height: 160rpx;
  margin-top: var(--space-md);
  padding: var(--space-sm);
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
}

.sheet-error {
  margin-top: var(--space-xs);
  font-size: var(--font-xs);
  color: var(--color-danger);
}

.sheet-actions {
  display: flex;
  margin-top: var(--space-md);
}

.sheet-btn {
  flex: 1;
}

.sheet-btn + .sheet-btn {
  margin-left: var(--space-sm);
}
