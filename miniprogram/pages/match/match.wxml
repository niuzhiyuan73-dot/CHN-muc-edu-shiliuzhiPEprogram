<!--
  比赛页
  数据形状见 services/match-view.js 的 loadMatchView。
  canConfirm / canRevoke 是视图模型算好的，这里不做任何权限推导。
-->
<view class="page-container {{themeClass}}">

  <!-- 加载中。必须排在出错之前，否则首屏会一闪而过地报错 -->
  <view wx:if="{{loading}}" class="loading">正在加载…</view>

  <view wx:elif="{{error}}" class="empty-state">
    <view class="empty-state-icon">⚠️</view>
    <view class="empty-state-text">{{error}}</view>
  </view>

  <block wx:else>

    <!-- 切到外校为只读浏览：比赛是对方学校的演示内容，入口与操作一概不给 -->
    <view wx:if="{{demoSchool}}" class="readonly-banner">
      正在浏览 {{demoSchoolName}}（只读）· 比赛记录为演示内容
    </view>

    <!-- ========== 录入入口 ========== -->
    <!-- 不能录入时把原因写在按钮上方，免得用户点了没反应还不知道为什么 -->
    <view wx:if="{{!demoSchool}}" class="card entry-bar">
      <view class="entry-hint">{{entryHint}}</view>
      <view
        class="btn btn-block {{auth.canRecord ? 'btn-accent' : 'btn-disabled'}}"
        bindtap="onGoEntry"
      >录入比赛成绩</view>
    </view>

    <!-- ========== 标签 ========== -->
    <view class="pool-tabs {{switching ? 'is-switching' : ''}}">
      <view
        wx:for="{{view.tabs}}"
        wx:key="tab"
        class="pool-tab {{item.active ? 'is-active' : ''}}"
        data-tab="{{item.tab}}"
        bindtap="onSwitchTab"
      >
        <view class="pool-tab-label">
          {{item.label}}
          <text wx:if="{{item.tab === 'pending' && view.pendingCount > 0}}" class="tab-count">{{view.pendingCount}}</text>
        </view>
      </view>
    </view>

    <!-- 确认权来自演示口径时必须在页面上说清楚，别被当成真实规则 -->
    <view wx:if="{{view.demoNotice}}" class="demo-notice">{{view.demoNotice}}</view>

    <!-- ========== 台账 ========== -->
    <view class="card">
      <view wx:if="{{view.records.length === 0}}" class="empty-note">{{view.emptyText}}</view>

      <!-- 访客没有「自己的比赛」可言，空态里补一个登录入口 -->
      <view
        wx:if="{{view.needLogin}}"
        class="btn btn-primary btn-block guest-btn"
        bindtap="onGoLogin"
      >登录 / 注册</view>

      <!-- 不做翻页，超出的部分如实交代，不假装已经翻到底 -->
      <view wx:if="{{view.hasMore}}" class="more-note">
        只显示最近 {{view.records.length}} 场，共 {{view.total}} 场
      </view>

      <view wx:for="{{view.records}}" wx:key="matchId" class="match-row">
        <view class="match-line1">
          <text class="match-type">{{item.typeLabel}}</text>
          <text wx:if="{{item.formatText}}" class="match-format">{{item.formatText}}</text>
          <text wx:if="{{item.resultText}}" class="match-result {{item.isWin ? 'is-win' : 'is-loss'}}">{{item.resultText}}</text>
          <text class="tag {{item.statusClass}} match-status">{{item.statusLabel}}</text>
        </view>

        <view class="match-teams">
          <view class="team {{item.winnerSide === 'A' ? 'is-winner' : ''}}">
            <text
              wx:for="{{item.teamAList}}"
              wx:for-item="player"
              wx:key="userId"
              class="team-name"
              data-user-id="{{player.userId}}"
              bindtap="onOpenMember"
            >{{player.nickName}}</text>
          </view>
          <text class="match-vs">vs</text>
          <view class="team {{item.winnerSide === 'B' ? 'is-winner' : ''}}">
            <text
              wx:for="{{item.teamBList}}"
              wx:for-item="player"
              wx:key="userId"
              class="team-name"
              data-user-id="{{player.userId}}"
              bindtap="onOpenMember"
            >{{player.nickName}}</text>
          </view>
        </view>

        <!-- 正在逐球计分的场次：当前比分顶在终局比分的位置上，并标「进行中 / 已结束」 -->
        <view wx:if="{{item.liveActive}}" class="match-score is-live">
          <text class="live-tag {{item.live.finished ? 'is-done' : ''}}">{{item.live.statusLabel}}</text>
          <text class="live-score">{{item.live.scoreText}}</text>
          <text class="live-games">局分 {{item.live.gamesText}} · {{item.live.gameIndexText}}</text>
        </view>
        <view wx:else class="match-score">{{item.scoreText}}</view>

        <view class="match-meta">
          {{item.dateText}}
          <text wx:if="{{item.courtText}}" class="match-court">{{item.courtText}}</text>
          <text wx:if="{{item.locationText}}"> · {{item.locationText}}</text>
        </view>

        <!-- 裁判：指派的场次标出是谁执法；他自己也在场上时给个提示（Q5） -->
        <view wx:if="{{item.hasReferee}}" class="match-referee">
          <text class="referee-label">裁判</text>
          <text class="referee-name">{{item.refereeName}}</text>
          <text wx:if="{{item.refereeIsParticipant}}" class="referee-flag">兼参赛</text>
        </view>
        <view wx:if="{{item.refereeNotice}}" class="match-referee-notice">{{item.refereeNotice}}</view>

        <!-- 作废的比赛把理由亮出来，否则看到「已撤销」会一头雾水 -->
        <view wx:if="{{item.statusReason}}" class="match-reason">理由：{{item.statusReason}}</view>

        <view wx:if="{{item.canRecord || item.canConfirm || item.canRevoke || item.canForfeit || item.canAssignReferee}}" class="match-actions">
          <!-- 抽签排出的比赛还没有比分：先录分，之后才有「确认」可谈 -->
          <view
            wx:if="{{item.canRecord}}"
            class="mini-btn is-primary"
            data-match-id="{{item.matchId}}"
            bindtap="onRecordMatch"
          >录分</view>
          <!-- 本人自选弃权：对手直接晋级，且不计个人等级分 -->
          <view
            wx:if="{{item.canForfeit}}"
            class="mini-btn is-danger"
            data-match-id="{{item.matchId}}"
            bindtap="onForfeit"
          >弃权</view>
          <view
            wx:if="{{item.canConfirm}}"
            class="mini-btn is-primary"
            data-match-id="{{item.matchId}}"
            bindtap="onConfirm"
          >确认比分</view>
          <view
            wx:if="{{item.canConfirm}}"
            class="mini-btn"
            data-match-id="{{item.matchId}}"
            data-kind="reject"
            bindtap="onOpenAction"
          >驳回</view>
          <view
            wx:if="{{item.canRevoke}}"
            class="mini-btn is-danger"
            data-match-id="{{item.matchId}}"
            data-kind="revoke"
            bindtap="onOpenAction"
          >撤销</view>
          <!-- 指派裁判：仅管理员，且只在还没生效的场次上开 -->
          <view
            wx:if="{{item.canAssignReferee}}"
            class="mini-btn"
            data-match-id="{{item.matchId}}"
            bindtap="onOpenReferee"
          >{{item.hasReferee ? '改派裁判' : '指派裁判'}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{isMock}}" class="mock-note">
      当前为本地模拟数据，用于开发预览，并非真实成绩
    </view>
  </block>

  <!-- ========== 撤销 / 驳回面板 ========== -->
  <!-- 用页内面板而不是 wx.showModal：理由需要校验，且撤销与驳回的文案不同 -->
  <view wx:if="{{action.open}}" class="sheet-mask" bindtap="onCancelAction">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{action.title}}</view>
      <view class="sheet-hint">{{action.hint}}</view>
      <textarea
        class="sheet-input"
        value="{{reason}}"
        placeholder="{{action.placeholder}}"
        maxlength="60"
        bindinput="onInputReason"
      />
      <view wx:if="{{actionError}}" class="sheet-error">{{actionError}}</view>
      <view class="sheet-actions">
        <view class="btn btn-outline sheet-btn" bindtap="onCancelAction">取消</view>
        <view
          class="btn btn-primary sheet-btn {{acting ? 'btn-disabled' : ''}}"
          bindtap="onSubmitAction"
        >确定</view>
      </view>
    </view>
  </view>

  <!-- ========== 指派裁判面板 ========== -->
  <!-- 一个人名一个圆牌，与录分页找搭档 / 对手的面板同款，管理员照着习惯用 -->
  <view wx:if="{{referee.open}}" class="sheet-mask" bindtap="onCancelReferee">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{referee.hasReferee ? '改派裁判' : '指派裁判'}}</view>
      <view class="sheet-hint">指定后，这一场的录分与确认都只由该裁判与管理员处理</view>
      <input
        class="sheet-input referee-search"
        value="{{referee.keyword}}"
        placeholder="搜索昵称或真实姓名"
        bindinput="onInputRefereeKeyword"
      />
      <!-- 已经指派过才给「撤下」；没指派时摆一个空按钮只会让人误点 -->
      <view
        wx:if="{{referee.hasReferee}}"
        class="btn btn-outline btn-block referee-clear {{refereeActing ? 'btn-disabled' : ''}}"
        bindtap="onClearReferee"
      >撤下裁判</view>
      <scroll-view scroll-y class="referee-list">
        <view wx:if="{{referee.rows.length === 0}}" class="empty-note">{{referee.emptyText}}</view>
        <view
          wx:for="{{referee.rows}}"
          wx:key="id"
          class="referee-row {{item.selected ? 'is-selected' : ''}}"
          data-user-id="{{item.id}}"
          bindtap="onPickReferee"
        >
          <view class="referee-avatar">{{item.avatarText}}</view>
          <view class="referee-row-name">{{item.name}}</view>
          <text wx:if="{{item.selected}}" class="referee-check">当前</text>
        </view>
      </scroll-view>
      <view class="sheet-actions">
        <view class="btn btn-outline sheet-btn" bindtap="onCancelReferee">关闭</view>
      </view>
    </view>
  </view>
</view>
