<!--
  排行榜
  数据形状见 services/rank-view.js 的 loadRankView。
  只剩「等级分榜」，不再有榜单类型切换；项目仍可切换。
  列表只列前 10 名，「我的排名」卡不受截断影响；搜索框覆盖全量会员。
-->
<view class="page-container">

  <!-- 加载中。必须排在出错之前，否则首屏会一闪而过地报错 -->
  <view wx:if="{{loading}}" class="loading">正在加载…</view>

  <view wx:elif="{{error}}" class="empty-state">
    <view class="empty-state-icon">⚠️</view>
    <view class="empty-state-text">{{error}}</view>
  </view>

  <block wx:else>

    <!-- ========== 项目切换 ========== -->
    <view class="pool-tabs {{switching ? 'is-switching' : ''}}">
      <view
        wx:for="{{view.projectTabs}}"
        wx:key="project"
        class="pool-tab {{item.active ? 'is-active' : ''}}"
        data-project="{{item.project}}"
        bindtap="onSwitchProject"
      >
        <view class="pool-tab-label">{{item.label}}</view>
      </view>
    </view>

    <!-- ========== 我在这个项目的排名 ========== -->
    <!-- 先给一个个人锚点，否则面对一屏陌生人名不知道该看哪儿 -->
    <view wx:if="{{view.me}}" class="card my-rank">
      <view class="my-rank-value">
        {{view.me.rank}}<text class="my-rank-total">/{{view.me.total}}</text>
      </view>
      <view class="my-rank-line1">我在{{view.activeProjectLabel}}的排名</view>
      <view class="my-rank-line2">{{view.me.beatText}}</view>
    </view>

    <!-- 我不在这个榜上时也要交代一句，空着会让人以为页面坏了 -->
    <view wx:else class="my-rank-hint">{{view.meHint}}</view>

    <!-- ========== 按名字找会员 ========== -->
    <!-- 只是把上面的榜过一遍，不重新排名；搜索词在切项目/榜单时会保留 -->
    <view class="search-bar">
      <input
        class="search-input"
        type="text"
        value="{{keyword}}"
        confirm-type="search"
        placeholder="输入名字找会员"
        bindinput="onInputKeyword"
      />
      <view wx:if="{{keyword}}" class="search-clear" catchtap="onClearKeyword">✕</view>
    </view>

    <!-- ========== 榜单 ========== -->
    <view class="card">
      <view class="rank-head">
        <view class="rank-head-title">{{view.activeProjectLabel}} · {{view.activeBoardLabel}}</view>
        <view class="rank-head-count">{{playerCountText}}</view>
      </view>

      <view wx:if="{{empty}}" class="empty-note">{{emptyNote}}</view>

      <!-- 点一行就去看这个人的完整战绩 -->
      <view
        wx:for="{{rows}}"
        wx:key="userId"
        class="rank-row {{item.isMe ? 'is-me' : ''}}"
        data-user-id="{{item.userId}}"
        bindtap="onOpenMember"
      >
        <view class="rank-no {{item.medal ? 'is-' + item.medal : ''}}">{{item.rank}}</view>

        <view class="rank-avatar">
          <image wx:if="{{item.avatarUrl}}" class="rank-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" />
          <text wx:else>{{item.avatarText}}</text>
        </view>

        <view class="rank-main">
          <view class="rank-name">
            <text>{{item.nickName}}</text>
            <text wx:if="{{item.isMe}}" class="rank-me-tag">我</text>
            <text wx:if="{{item.badge}}" class="rank-badge">{{item.badge}}</text>
          </view>
          <view class="rank-detail">{{item.detailText}}</view>
        </view>

        <view class="rank-value-box">
          <view class="rank-value {{item.valueClass}}">{{item.valueText}}</view>
          <view class="rank-note">{{item.noteText}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{isMock}}" class="mock-note">
      当前为本地模拟数据，用于开发预览，并非真实成绩
    </view>

  </block>
</view>
