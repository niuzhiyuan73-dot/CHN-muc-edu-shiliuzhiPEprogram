<!--
  赛程编排：定赛制 → 分组/编排 → 排时间场地 → 指派裁判 → 发布赛程。
  顺序不能颠倒：分几组、分几枪由报名人数与跑道数算出来，所以赛制放在这个阶段，
  而不是项目刚建好、报名还没开始的时候。
-->
<view class="page-container">

  <view wx:if="{{notice}}" class="meet-notice">{{notice}}</view>
  <view wx:if="{{error}}" class="meet-error">{{error}}</view>

  <view wx:if="{{loading}}" class="loading">正在加载…</view>

  <block wx:else>
    <view wx:if="{{!canManage}}" class="empty-state">
      <view class="empty-state-text">只有校级管理员及以上可以编排赛程</view>
    </view>

    <block wx:else>
      <view wx:for="{{items}}" wx:key="eventKey" class="card meet-row">
        <view class="meet-row-head" data-event-key="{{item.eventKey}}" bindtap="onOpenEvent">
          <view class="meet-row-main">
            <view class="meet-row-name">{{item.name}} · {{item.group === 'male' ? '男子' : item.group === 'female' ? '女子' : '混合'}}</view>
            <view class="meet-row-meta">{{item.procedureLabel}}</view>
            <view class="meet-row-meta">
              <block wx:if="{{item.sessions.length > 0}}">
                {{item.sessions.length}} 个场次 · {{item.sessions[0].startAt || '未排期'}}
              </block>
              <block wx:else>还没有场次</block>
            </view>
          </view>
          <view class="meet-row-tag {{item.ready ? 'is-ok' : ''}}">{{item.ready ? '已配齐' : '未配齐'}}</view>
        </view>

        <!-- 赛制与编排：报名截止后在这里定 -->
        <view class="meet-actions">
          <view class="meet-btn" data-event-key="{{item.eventKey}}" bindtap="onOpenProcedure">设置赛制</view>
          <!-- 单场项目（田赛、评分展示）没有分组这一步，按钮不出现 -->
          <view
            wx:if="{{item.canDraw}}"
            class="meet-btn is-primary"
            data-event-key="{{item.eventKey}}"
            data-versus="{{item.scoreType === 'versus' ? 1 : 0}}"
            bindtap="onDraw"
          >{{item.scoreType === 'versus' ? '编排签表' : '抽签分组'}}</view>
          <view wx:else class="meet-btn is-disabled">单场项目</view>
        </view>

        <!-- 赛制编辑面板 -->
        <view wx:if="{{procedureEventKey === item.eventKey}}" class="meet-editor">
          <block wx:if="{{proc.isVersus}}">
            <view class="meet-form-row">
              <text class="meet-form-label">赛制</text>
              <view class="meet-seg">
                <view class="meet-seg-item {{proc.format === 'single_elim' ? 'is-on' : ''}}" data-format="single_elim" bindtap="onProcPickFormat">单败淘汰</view>
                <view class="meet-seg-item {{proc.format === 'round_robin' ? 'is-on' : ''}}" data-format="round_robin" bindtap="onProcPickFormat">循环赛</view>
                <view class="meet-seg-item {{proc.format === 'group_knockout' ? 'is-on' : ''}}" data-format="group_knockout" bindtap="onProcPickFormat">小组+淘汰</view>
              </view>
            </view>
            <view wx:if="{{proc.format === 'group_knockout'}}" class="meet-form-row">
              <text class="meet-form-label">小组设置</text>
              <input class="meet-num" type="number" value="{{proc.groupCount}}" data-field="groupCount" bindinput="onProcInput" />
              <text class="meet-form-unit">组，每组出线</text>
              <input class="meet-num" type="number" value="{{proc.advancePerGroup}}" data-field="advancePerGroup" bindinput="onProcInput" />
              <text class="meet-form-unit">队</text>
            </view>
          </block>

          <!-- 单场项目：田赛与评分展示，一个场次按顺序进行到底 -->
          <block wx:elif="{{proc.heatMode === 'single'}}">
            <view class="meet-hint">
              该项目只有一个场次：按顺序依次进行，不分组、不分枪。填好时间与场地即可。
            </view>
          </block>

          <block wx:else>
            <view class="meet-form-row">
              <text class="meet-form-label">轮次</text>
              <view class="meet-seg">
                <view class="meet-seg-item {{proc.rounds === 'final' ? 'is-on' : ''}}" data-rounds="final" bindtap="onProcPickRounds">直接决赛</view>
                <view class="meet-seg-item {{proc.rounds === 'heat_final' ? 'is-on' : ''}}" data-rounds="heat_final" bindtap="onProcPickRounds">预赛+决赛</view>
              </view>
            </view>
            <view class="meet-form-row">
              <!-- 分道跑按道数分批；长跑/次数/趣味按人数上限分批。两者语义不同，标签必须分开 -->
              <text class="meet-form-label">{{proc.heatMode === 'lane' ? '跑道数' : '每组上限'}}</text>
              <input class="meet-num" type="number" value="{{proc.heatCapacity}}" data-field="heatCapacity" bindinput="onProcInput" />
              <text class="meet-form-unit">{{proc.heatMode === 'lane' ? '人/队（组数按报名数自动算）' : '人（组数按报名人数自动算）'}}</text>
            </view>
            <view wx:if="{{proc.rounds === 'heat_final'}}" class="meet-form-row">
              <text class="meet-form-label">晋级方式</text>
              <picker range="{{advanceModes}}" range-key="label" value="{{proc.advanceModeIndex}}" bindchange="onProcAdvanceMode"><view>{{advanceModes[proc.advanceModeIndex].label}}</view></picker>
              <text class="meet-form-label">{{proc.advanceModeIndex === 0 ? '每组晋级' : '晋级总数'}}</text>
              <input class="meet-num" type="number" value="{{proc.advanceCount}}" data-field="advanceCount" bindinput="onProcInput" />
              <text class="meet-form-unit">人</text>
            </view>
          </block>

          <button class="btn btn-primary" bindtap="onSaveProcedure" disabled="{{busy}}">保存赛制</button>
        </view>

        <!-- 批量指派：一批裁判一次派到多个场次 -->
        <view class="meet-actions">
          <view class="meet-btn is-primary" data-event-key="{{item.eventKey}}" bindtap="onOpenBulk">批量派裁判</view>
        </view>

        <view wx:if="{{bulkOpen && activeEventKey === item.eventKey}}" class="meet-editor">
          <view class="meet-form-label">选裁判（{{bulkJudges.length}} 人）</view>
          <input class="meet-search" placeholder="搜索姓名或学院" value="{{bulkKeyword}}" bindinput="onBulkKeyword" />
          <view class="meet-hint">已选：{{bulkJudgeNames || '尚未选择'}}</view>
          <view class="meet-chips">
            <view
              wx:for="{{filteredBulkJudges}}"
              wx:for-item="judge"
              wx:key="userId"
              class="meet-chip {{bulkJudgesSelected[judge.userId] ? 'is-on' : ''}}"
              data-user-id="{{judge.userId}}"
              bindtap="onToggleBulkJudge"
            >{{judge.name}}</view>
          </view>

          <view wx:if="{{bulkHasMore}}" bindtap="onMoreBulkJudges" class="meet-hint">加载更多裁判</view>
          <view class="meet-form-label">派到哪些场次</view>
          <view class="meet-actions">
            <view class="meet-btn" bindtap="onBulkAllSessions">本项目全部场次</view>
          </view>
          <view class="meet-chips">
            <view
              wx:for="{{item.sessions}}"
              wx:for-item="rnd"
              wx:key="sessionKey"
              class="meet-chip {{bulkSessionsSelected[rnd.sessionKey] ? 'is-on' : ''}}"
              data-session-key="{{rnd.sessionKey}}"
              bindtap="onToggleBulkSession"
            >{{rnd.displayLabel}}</view>
          </view>
          <view class="meet-form-row">
            <text class="meet-form-label">或按日期</text>
            <input class="meet-input" placeholder="2026-10-24" value="{{bulkDate}}" bindinput="onBulkDateInput" />
          </view>

          <button class="btn btn-primary" bindtap="onSubmitBulk" disabled="{{busy}}">
            指派 {{bulkJudges.length}} 人到 {{bulkSessions.length > 0 ? bulkSessions.length + ' 个场次' : (bulkDate ? bulkDate + ' 全部场次' : '本项目全部场次')}}
          </button>
        </view>

        <!-- 场次排期与裁判 -->
        <view wx:if="{{activeEventKey === item.eventKey}}" class="meet-editor">
          <scroll-view wx:if="{{item.sessions.length > 1}}" scroll-x class="meet-rounds">
            <view
              wx:for="{{item.sessions}}"
              wx:for-item="rnd"
              wx:key="sessionKey"
              class="meet-round {{editSessionKey === rnd.sessionKey ? 'is-active' : ''}}"
              data-session-key="{{rnd.sessionKey}}"
              bindtap="onPickSession"
            >{{rnd.displayLabel}}</view>
          </scroll-view>

          <view wx:if="{{current && current.entryKeys.length > 0}}" class="meet-hint">
            本场 {{current.entryKeys.length}} 条参赛记录
          </view>

          <view class="meet-field">
            <text class="meet-label">开始</text>
            <view class="meet-time">
              <picker mode="date" value="{{editDate}}" bindchange="onStartDateChange">
                <view class="meet-time-part">{{editDate || '选日期'}}</view>
              </picker>
              <picker mode="time" value="{{editTime}}" bindchange="onStartTimeChange">
                <view class="meet-time-part">{{editTime || '选时间'}}</view>
              </picker>
            </view>
          </view>
          <view class="meet-field">
            <text class="meet-label">显示为</text>
            <input class="meet-input" placeholder="也可直接填，如：下午三点" value="{{editStartAt}}" bindinput="onStartInput" />
          </view>
          <view class="meet-field">
            <text class="meet-label">场地</text>
            <input class="meet-input" placeholder="如：田径场直道" value="{{editVenue}}" bindinput="onVenueInput" />
          </view>
          <button class="btn btn-primary" bindtap="onSaveSession" disabled="{{busy}}">保存场次</button>

          <view wx:if="{{current}}" class="meet-judges">
            <view class="meet-judges-title">裁判（{{current.judgeIds.length}} 人）</view>
            <view wx:for="{{current.judges}}" wx:for-item="judge" wx:key="judgeId" class="meet-judge">
              <text>{{judge.name}}</text>
              <text class="meet-judge-remove" data-session-key="{{current.sessionKey}}" data-judge-id="{{judge.judgeId}}" bindtap="onRemoveJudge">撤销</text>
            </view>

            <!-- 搜索 + 直接点人指派：不再用 picker，避免「搜完还要再点一次」 -->
            <input class="meet-search" placeholder="搜索姓名或学院" value="{{judgeKeyword}}" bindinput="onJudgeKeyword" />
            <scroll-view scroll-y class="meet-judge-list">
              <view wx:if="{{judgeHasMore}}" bindtap="onMoreJudges" class="meet-hint">加载更多裁判</view>
              <view wx:if="{{filteredJudges.length === 0}}" class="meet-hint">没有匹配的本校成员</view>
              <view
                wx:for="{{filteredJudges}}"
                wx:key="userId"
                class="meet-judge-pick"
                data-judge-id="{{item.userId}}"
                bindtap="onAssignJudge"
              >
                <text class="meet-judge-name">{{item.name}}</text>
                <text class="meet-judge-college">{{item.collegeName}}</text>
                <text class="meet-judge-add-btn">指派</text>
              </view>
            </scroll-view>

            <button class="btn btn-ghost" data-session-key="{{current.sessionKey}}" bindtap="onStartSession" disabled="{{busy || current.judgeIds.length === 0}}">开赛</button>
          </view>
        </view>
      </view>

      <button class="btn btn-primary" bindtap="onPublishSchedule" disabled="{{busy}}">发布赛程</button>
      <view class="meet-college-link" bindtap="onOpenScore">进入录分 / 成绩发布 ›</view>
    </block>
  </block>
</view>
