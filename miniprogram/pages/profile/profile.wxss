/* 我的页样式。主体样式在 templates/member-view.wxss 里，与「他人主页」共用。
   入口卡片（.entry-card 系列）在 app.wxss，个人详情页也要用。 */
@import "../../templates/member-view.wxss";

/* ==================== 当前分数 ==================== */

/* 单打、双打并排各显示一个等级分，两个格子都是切换入口：
   点哪个哪个变绿，下方的排名跟着换成那个项目 */
.score-duo {
  display: flex;
  align-items: stretch;
}

/* 切换中给一点淡出反馈，免得点了没反应 */
.score-duo.is-switching {
  opacity: 0.5;
}

.score-duo-cell {
  flex: 1;
  min-width: 0;
  text-align: center;
}

/* 两项之间才画线，第一项左边不画 */
.score-duo-cell + .score-duo-cell {
  border-left: 2rpx solid var(--color-divider);
}

.score-duo-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.score-duo-value {
  margin-top: 4rpx;
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.2;
}

/* 默认展示的那个项目用主色，和切池标签的选中态一个意思 */
.score-duo-cell.is-active .score-duo-value {
  color: var(--color-primary);
}

/* ==================== 退出登录 ==================== */

/* 与页脚的模拟数据说明留出间距，免得两个都是灰字挤成一片 */
.logout-btn {
  margin-top: var(--space-md);
  background: transparent;
  border: none;
  color: var(--color-text-secondary);
}

.profile-services { padding: 0 var(--space-md); box-shadow: none; }
.profile-service { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); min-height: var(--control-min-height); padding: var(--space-md) 0; border-bottom: 2rpx solid var(--color-divider); }
.profile-service:last-child { border-bottom: none; }
.profile-service > view { min-width: 0; }
.profile-service-title { font-size: var(--font-body); font-weight: 500; margin-bottom: var(--space-xs); }
.profile-service .experience-caption { overflow-wrap: anywhere; }

/* ==================== 未登录引导 ==================== */

/* 没有战绩数据可渲染时，这一页只剩这张卡，给它一点上边距别贴着顶栏 */
.guest-card {
  margin-top: var(--space-md);
}

.guest-btn {
  margin-top: var(--space-md);
}

/* ==================== 协议入口 ==================== */

/* 两条灰字居中排在页脚。字号比正文小一档：
   它是备查入口，不该抢「退出登录」的注意力 */
.legal-links {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--space-lg);
  padding: var(--space-sm) 0;
}

.legal-link {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.legal-sep {
  margin: 0 var(--space-sm);
  font-size: var(--font-xs);
  color: var(--color-border);
}
