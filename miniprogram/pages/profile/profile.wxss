/* 我的页样式。主体样式在 templates/member-view.wxss 里，与「他人主页」共用。 */
@import "../../templates/member-view.wxss";

/* ==================== 管理入口卡片 ==================== */

/* 会员审核与公告管理共用一套样式：
   都是「标题 + 一句说明 + 箭头」的可点卡片 */
.entry-card {
  display: flex;
  align-items: center;
}

.entry-card-main {
  flex: 1;
  min-width: 0;
}

.entry-card-title {
  font-size: var(--font-md);
  font-weight: 600;
}

.entry-card-hint {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* ==================== 退出登录 ==================== */

/* 与页脚的模拟数据说明留出间距，免得两个都是灰字挤成一片 */
.logout-btn {
  margin-top: var(--space-xl);
}

/* 一个朴素的方向箭头，暗示这张卡可以点 */
.entry-card-arrow {
  flex-shrink: 0;
  margin-left: var(--space-sm);
  font-size: var(--font-xl);
  color: var(--color-text-tertiary);
  line-height: 1;
}
