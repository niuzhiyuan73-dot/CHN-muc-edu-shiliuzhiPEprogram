/* 我的页样式。主体样式在 templates/member-view.wxss 里，与「他人主页」共用。
   入口卡片（.entry-card 系列）在 app.wxss，个人详情页也要用。 */
@import "../../templates/member-view.wxss";

/* ==================== 当前分数 ==================== */

/* 单打、双打并排各显示一个等级分。两个项目用一条竖线隔开，
   一眼分得清哪个数是哪个项目的，不用再来回切换 */
.score-duo {
  display: flex;
  align-items: stretch;
}

.score-duo-cell {
  flex: 1;
  min-width: 0;
  text-align: center;
}

/* 两项之间才画线，第一项左边不画 */
.score-duo-cell + .score-duo-cell {
  border-left: 2rpx solid var(--color-divider);
}

.score-duo-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.score-duo-value {
  margin-top: 4rpx;
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.2;
}

/* 默认展示的那个项目用主色，和切池标签的选中态一个意思 */
.score-duo-cell.is-active .score-duo-value {
  color: var(--color-primary);
}

/* ==================== 退出登录 ==================== */

/* 与页脚的模拟数据说明留出间距，免得两个都是灰字挤成一片 */
.logout-btn {
  margin-top: var(--space-xl);
}

/* ==================== 未登录引导 ==================== */

/* 没有战绩数据可渲染时，这一页只剩这张卡，给它一点上边距别贴着顶栏 */
.guest-card {
  margin-top: var(--space-md);
}

.guest-btn {
  margin-top: var(--space-md);
}
