<import src="../../templates/member-view.wxml" />
<view class="page-container profile-page">
  <block wx:if="{{loggedIn}}"><template is="profileView" data="{{...view, loading: loading, error: error, showSwitch: true, switchValue: associationId}}" /></block>
  <view wx:else class="card guest-card"><view class="card-title">参与校园体育活动</view><view class="card-subtitle">登录后查看个人成绩、赛事经历与学校身份</view><button class="btn btn-primary btn-block guest-btn" bindtap="onGoLogin">登录 / 注册</button></view>
  <view class="experience-heading"><view class="experience-heading-title">个人服务</view></view>
  <view class="card profile-services">
    <view class="profile-service" bindtap="onGoSchoolIdentity"><view><view class="profile-service-title">学校身份</view><view class="experience-caption">学籍信息、管理授权与审核结果</view></view><text>›</text></view>
    <view class="profile-service" bindtap="onGoSchoolExchange"><view><view class="profile-service-title">跨校邀请赛</view><view class="experience-caption">受邀学校交流 · 不计校内等级分</view></view><text>›</text></view>
  </view>
  <block wx:if="{{reviewEntry.visible || adminEntry.visible}}"><view class="experience-heading"><view class="experience-heading-title">管理工具</view><text class="experience-caption">按当前身份开放</text></view><view class="card profile-services">
    <view wx:if="{{reviewEntry.visible}}" class="profile-service" bindtap="onGoReview"><view><view class="profile-service-title">会员审核</view><view class="experience-caption">{{reviewEntry.hint}}</view></view><text>›</text></view>
    <view wx:if="{{adminEntry.visible}}" class="profile-service" bindtap="onGoAnnouncementsAdmin"><view><view class="profile-service-title">公告管理</view><view class="experience-caption">{{adminEntry.hint}}</view></view><text>›</text></view>
  </view></block>
  <view class="legal-links"><text class="legal-link" bindtap="onOpenPrivacyContract">隐私保护指引</text><text class="legal-sep">·</text><text class="legal-link" bindtap="onGoAgreement">用户协议</text></view>
  <button wx:if="{{loggedIn}}" class="btn btn-danger btn-block logout-btn" bindtap="onLogout">退出登录</button>
  <view wx:if="{{isMock}}" class="mock-note">当前为本地模拟数据，用于开发预览，并非真实成绩</view>
</view>
