<view class="page-container home-page">
  <view class="hero">
    <view class="hero-head"><view class="hero-main"><view class="hero-title">石榴籽体育</view><view class="hero-school">{{schoolName || '校园体育活动'}}</view></view><view class="hero-badges">
      <association-switch wx:if="{{auth.loggedIn}}" value="{{associationId}}" bind:change="onAssociationChange" />
      <school-switch wx:if="{{schoolList.length > 1}}" value="{{schoolId}}" list="{{schoolList}}" bind:change="onSchoolChange" />
    </view></view>
    <view wx:if="{{isMock}}" class="home-demo">本地模拟预览</view>
  </view>
  <view wx:if="{{readOnlySchool}}" class="readonly-banner">正在浏览 {{schoolName}}（只读）· 可访问内容以当前账号权限为准</view>
  <view wx:if="{{loading}}" class="experience-skeleton" aria-label="正在加载首页"><view class="experience-skeleton-line is-short"/><view class="experience-skeleton-line"/><view class="experience-skeleton-line"/></view>
  <view wx:elif="{{error}}" class="empty-state"><view class="empty-state-text">{{error}}</view><button class="btn btn-outline" bindtap="refresh">重新加载</button></view>
  <block wx:else>
    <view wx:if="{{refreshing}}" class="experience-update">正在更新当前学校的赛事…</view>
    <block wx:if="{{view.loggedIn}}">
      <view class="experience-heading"><view class="experience-heading-title">近期赛事</view><button class="home-text-button" bindtap="onGoEvents">进入赛事 ›</button></view>
      <view wx:for="{{view.upcomingEvents}}" wx:key="id" class="home-event {{index === 0 ? 'is-featured' : ''}}" data-event-id="{{item.id}}" data-event-kind="{{item.eventKind}}" data-association="{{item.association}}" bindtap="onOpenEvent">
        <view class="home-event-top"><view class="home-date"><text>{{item.dateText || '日期待定'}}</text><text class="home-time">{{item.clockText || '时间待定'}}</text></view><view class="home-event-main"><text class="tag {{item.isOngoing ? 'tag-success' : 'tag-primary'}}">{{item.statusLabel}}</text><view class="event-title">{{item.title}}</view><view class="event-meta">{{item.associationName}} · {{item.eventKind === 'team' ? '团队赛事' : '个人赛事'}}<text wx:if="{{item.signedUp}}" class="event-mine"> · 已报名</text></view></view></view>
        <view class="home-event-foot"><text>{{item.location || '场地待定'}}</text><text wx:if="{{item.quotaText}}">{{item.quotaText}}</text></view>
        <view wx:if="{{index === 0}}" class="home-event-action">查看赛事 <text>↗</text></view>
      </view>
      <view wx:if="{{view.upcomingEvents.length === 0}}" class="card empty-state"><view class="empty-state-text">当前没有近期赛事</view><button class="btn btn-outline" bindtap="onGoAssociations">进入协会查看活动</button></view>
    </block>
    <view class="experience-heading"><view class="experience-heading-title">学校公告</view><button class="home-text-button" bindtap="onGoAnnouncements">全部公告 ›</button></view>
    <view class="card home-notices"><view wx:for="{{view.announcements.rows}}" wx:key="id" class="notice-item" data-notice-id="{{item.id}}" bindtap="onOpenAnnouncement"><view class="notice-head"><text wx:if="{{item.pinned}}" class="notice-pin">置顶</text><text class="notice-title">{{item.title}}</text></view><view class="notice-content">{{item.content}}</view><view class="notice-date">{{item.dateText}}</view></view><view wx:if="{{view.announcements.rows.length === 0}}" class="empty-note">还没有发布学校公告</view></view>
    <view wx:if="{{view.summary}}" class="home-stats">{{view.summary.memberCount}} 名会员 · {{view.summary.matchCount}} 场比赛 · {{view.summary.eventCount}} 场赛事</view>
    <view wx:if="{{!view.loggedIn}}" class="card home-guest"><view class="card-title">参与校园体育活动</view><view class="card-subtitle">登录后查看近期赛事、报名与个人成绩</view><button class="btn btn-primary btn-block" bindtap="onGoLogin">登录 / 注册</button></view>
    <view wx:if="{{isMock}}" class="mock-note">当前为本地模拟数据，用于开发预览，并非真实成绩</view>
  </block>
</view>
