.hero { padding: var(--space-sm) 0 var(--space-md); }
.hero-head { display: flex; align-items: center; gap: var(--space-md); justify-content: space-between; }
.hero-main { flex: 1; min-width: 0; }
.hero-title { font-size: var(--font-xl); font-weight: 600; color: var(--color-text); }
.hero-school { font-size: var(--font-sm); color: var(--color-text-secondary); margin-top: var(--space-xs); overflow-wrap: anywhere; }
.hero-badges { display: flex; align-items: flex-end; flex-direction: column; gap: var(--space-xs); }
.home-demo { display: inline-block; font-size: var(--font-caption); color: var(--color-warning-text); background: var(--color-warning-light); padding: var(--space-xs) var(--space-sm); border-radius: var(--radius-sm); margin-top: var(--space-sm); }
.readonly-banner { background: var(--color-warning-light); color: var(--color-warning-text); border-radius: var(--radius-md); padding: var(--space-md); font-size: var(--font-sm); }
.home-text-button { background: transparent; border: none; padding: var(--space-xs); margin: 0; min-height: var(--control-min-height); color: var(--color-primary-dark); font-size: var(--font-sm); display: flex; align-items: center; }
.home-text-button::after { border: none; }
.home-event { background: var(--color-card); border-radius: var(--radius-md); padding: var(--space-md); margin-bottom: var(--space-sm); }
.home-event.is-featured { padding: var(--space-lg); border-top: 6rpx solid var(--color-primary); }
.home-event-top { display: flex; align-items: center; gap: var(--space-md); }
.home-event-main { flex: 1; min-width: 0; }
.home-date { width: 148rpx; flex-shrink: 0; color: var(--color-primary-dark); font-size: var(--font-caption); display: flex; align-items: center; flex-direction: column; padding-right: var(--space-md); border-right: 2rpx solid var(--color-divider); }
.home-time { font-size: var(--font-lg); font-weight: 600; font-variant-numeric: tabular-nums; }
.event-title { font-size: var(--font-md); font-weight: 600; margin: var(--space-xs) 0; overflow-wrap: anywhere; }
.event-meta { font-size: var(--font-caption); color: var(--color-text-secondary); }
.event-mine { color: var(--color-success-text); }
.home-event-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-sm); margin-top: var(--space-md); font-size: var(--font-caption); color: var(--color-text-secondary); }
.home-event-action { display: flex; justify-content: space-between; align-items: center; background: var(--color-primary-dark); color: var(--color-on-primary); border-radius: var(--radius-sm); padding: var(--space-sm) var(--space-md); min-height: var(--control-min-height); box-sizing: border-box; margin-top: var(--space-md); font-size: var(--font-sm); }
.home-notices { padding: 0 var(--space-md); box-shadow: none; }
.notice-item { padding: var(--space-md) 0; border-bottom: 2rpx solid var(--color-divider); }
.notice-item:last-child { border-bottom: none; }
.notice-head { display: flex; align-items: baseline; gap: var(--space-xs); }
.notice-pin { color: var(--color-honor); font-size: var(--font-caption); flex-shrink: 0; }
.notice-title { font-size: var(--font-body); font-weight: 500; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.notice-content { font-size: var(--font-sm); color: var(--color-text-secondary); margin-top: var(--space-xs); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.notice-date { font-size: var(--font-caption); color: var(--color-text-secondary); margin-top: var(--space-xs); }
.home-stats { font-size: var(--font-caption); color: var(--color-text-secondary); text-align: center; margin: var(--space-lg) 0; }
.home-guest .btn { margin-top: var(--space-md); }
.personal-next{background:var(--color-card);border-radius:var(--radius-md);border-left:6rpx solid var(--color-primary);padding:var(--space-lg)}.personal-next-top,.personal-task-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--space-sm);font-size:var(--font-caption);color:var(--color-text-secondary)}.personal-next-title{font-size:var(--font-lg);font-weight:600;margin:var(--space-sm) 0;overflow-wrap:anywhere}.personal-next-opponents{font-size:var(--font-body);line-height:1.6;overflow-wrap:anywhere}.personal-next-time{font-size:var(--font-body);color:var(--color-primary-dark);margin-top:var(--space-md);line-height:1.6}.personal-next-link{min-height:44px;display:flex;align-items:center;justify-content:flex-end;color:var(--color-primary-dark);font-size:var(--font-body)}.personal-empty{padding:var(--space-md);border-radius:var(--radius-md);background:var(--color-card);color:var(--color-text-secondary);font-size:var(--font-body);line-height:1.6}.personal-task-head{margin-top:var(--space-md);font-size:var(--font-body)}.personal-task-list{padding:0 var(--space-md);box-shadow:none}.personal-task{display:flex;align-items:center;justify-content:space-between;gap:var(--space-sm);min-height:44px;padding:var(--space-md) 0;font-size:var(--font-body);border-bottom:1rpx solid var(--color-divider);overflow-wrap:anywhere}.personal-task:last-child{border-bottom:0}.personal-task-action{flex-shrink:0;max-width:38%;text-align:right;color:var(--color-primary-dark);font-size:var(--font-caption);line-height:1.5;overflow-wrap:anywhere}
@media (max-width: 360px) { .home-date { width: 100rpx; padding-right: var(--space-sm); } .home-event.is-featured { padding: var(--space-md); } }

/* 默认项目说明：把“切协会只影响工作台”说清，并给出直达入口 */
.hero-default-hint {
  margin-top: var(--space-sm);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-xs);
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  line-height: 1.6;
}

.hero-workspace-link {
  min-height: var(--control-min-height);
  display: inline-flex;
  align-items: center;
  color: var(--color-primary-dark);
  font-weight: 600;
}
