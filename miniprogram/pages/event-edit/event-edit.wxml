<!--
  发布赛事
  表单的校验在 services/event.js，这里只渲染，并把用户的操作交回去。
-->
<view class="page-container">

  <!-- 没有发布权时不给表单：填完再被拒，比一开始就说清楚糟得多 -->
  <view wx:if="{{blockReason}}" class="empty-state">
    <view class="empty-state-icon">🔒</view>
    <view class="empty-state-text">{{blockReason}}</view>
    <view class="btn btn-outline block-back" bindtap="onCancel">返回</view>
  </view>

  <block wx:else>

    <!-- ========== 基本信息 ========== -->
    <view class="card">
      <view class="card-title">赛事信息</view>

      <view class="field-row">
        <view class="field-label">赛事名称</view>
        <input
          class="field-input"
          value="{{form.title}}"
          maxlength="{{titleMax}}"
          placeholder="例如：2026 春季单打赛"
          bindinput="onInputTitle"
        />
      </view>
      <view wx:if="{{errors.title}}" class="field-error">{{errors.title}}</view>

      <view class="field-row">
        <view class="field-label">项目</view>
        <picker mode="selector" range="{{matchTypes}}" value="{{matchTypeIndex}}" bindchange="onPickMatchType">
          <view class="field-value">{{matchTypes[matchTypeIndex]}} ›</view>
        </picker>
      </view>
      <view wx:if="{{errors.matchType}}" class="field-error">{{errors.matchType}}</view>

      <!-- 等级与三四名赛方式必须选定，所以初值不留默认 -->
      <view class="field-row">
        <view class="field-label">赛事等级</view>
        <picker mode="selector" range="{{levels}}" value="{{levelIndex}}" bindchange="onPickLevel">
          <view class="field-value {{form.level === null ? 'is-placeholder' : ''}}">
            {{form.level === null ? '请选择赛事等级' : levels[levelIndex]}} ›
          </view>
        </picker>
      </view>
      <view wx:if="{{errors.level}}" class="field-error">{{errors.level}}</view>
      <view class="field-hint">等级决定名次分的倍数：一级 ×4、二级 ×2、三级 ×1</view>

      <view class="field-row">
        <view class="field-label">三四名赛</view>
        <picker mode="selector" range="{{bronzeModes}}" value="{{bronzeIndex}}" bindchange="onPickBronzeMode">
          <view class="field-value {{form.bronzeMode === '' ? 'is-placeholder' : ''}}">
            {{form.bronzeMode === '' ? '请选择三四名赛方式' : bronzeModes[bronzeIndex]}} ›
          </view>
        </picker>
      </view>
      <view wx:if="{{errors.bronzeMode}}" class="field-error">{{errors.bronzeMode}}</view>
      <view class="field-hint">并列：两位半决赛负者都记季军；打三四名：加赛一场，分出第三、第四名</view>

      <!-- 抽签只对单打开放（决策 1），双打不显示这两项 -->
      <block wx:if="{{form.matchType === 1}}">
        <view class="field-row">
          <view class="field-label">种子来源</view>
          <picker mode="selector" range="{{seedModes}}" value="{{seedModeIndex}}" bindchange="onPickSeedMode">
            <view class="field-value {{form.seedMode === '' ? 'is-placeholder' : ''}}">
              {{form.seedMode === '' ? '请选择种子来源' : seedModes[seedModeIndex]}} ›
            </view>
          </picker>
        </view>
        <view wx:if="{{errors.seedMode}}" class="field-error">{{errors.seedMode}}</view>

        <view class="field-row">
          <view class="field-label">种子数量</view>
          <picker mode="selector" range="{{seedCounts}}" value="{{seedCountIndex}}" bindchange="onPickSeedCount">
            <view class="field-value">{{seedCounts[seedCountIndex]}} ›</view>
          </picker>
        </view>
        <view wx:if="{{errors.seedCount}}" class="field-error">{{errors.seedCount}}</view>
        <view class="field-hint">抽签时按来源排出种子，强手分散、轮空优先给高种子；只在报名阶段由管理员手动抽签</view>
      </block>
    </view>

    <!-- ========== 时间与场地 ========== -->
    <view class="card">
      <view class="card-title">时间与场地</view>

      <view class="field-row">
        <view class="field-label">日期</view>
        <picker mode="date" value="{{form.date}}" start="{{today}}" bindchange="onPickDate">
          <view class="field-value {{form.date ? '' : 'is-placeholder'}}">
            {{form.date ? form.date : '请选择日期'}} ›
          </view>
        </picker>
      </view>

      <view class="field-row">
        <view class="field-label">时间</view>
        <picker mode="time" value="{{form.time}}" bindchange="onPickTime">
          <view class="field-value {{form.time ? '' : 'is-placeholder'}}">
            {{form.time ? form.time : '请选择开始时间'}} ›
          </view>
        </picker>
      </view>
      <view wx:if="{{errors.startTime}}" class="field-error">{{errors.startTime}}</view>

      <view class="field-row">
        <view class="field-label">场地</view>
        <input
          class="field-input"
          value="{{form.location}}"
          maxlength="{{locationMax}}"
          placeholder="例如：体育馆 1 号场"
          bindinput="onInputLocation"
        />
      </view>
      <view wx:if="{{errors.location}}" class="field-error">{{errors.location}}</view>

      <view class="field-row">
        <view class="field-label">名额</view>
        <input
          class="field-input"
          type="number"
          value="{{form.quota}}"
          placeholder="不填视为不限"
          bindinput="onInputQuota"
        />
      </view>
      <view wx:if="{{errors.quota}}" class="field-error">{{errors.quota}}</view>
    </view>

    <!-- ========== 说明 ========== -->
    <view class="card">
      <view class="card-title">赛事说明</view>
      <view class="card-subtitle">把赛制、报名要求写清楚，最多 {{descriptionMax}} 个字</view>

      <textarea
        class="content-input"
        value="{{form.description}}"
        maxlength="{{descriptionMax}}"
        placeholder="例如：淘汰赛制，每局 11 分三局两胜，请提前 15 分钟到场热身。"
        bindinput="onInputDescription"
      />
      <view wx:if="{{errors.description}}" class="field-error">{{errors.description}}</view>
    </view>

    <view wx:if="{{errorText}}" class="submit-error">{{errorText}}</view>

    <view class="submit-bar">
      <view class="btn btn-outline submit-btn" bindtap="onCancel">取消</view>
      <view
        class="btn btn-primary submit-btn {{submitting ? 'btn-disabled' : ''}}"
        bindtap="onSubmit"
      >发布</view>
    </view>

    <view wx:if="{{isMock}}" class="mock-note">
      当前为本地模拟数据，发布后只写入内存，重启小程序即清空
    </view>
  </block>
</view>
