/*
 * 公告列表样式
 * 标签栏（.pool-tabs）、卡片（.card）、标签（.tag）都在 app.wxss 里，与其它页共用。
 */

/* ==================== 标签上的条数 ==================== */
/* 做成小圆点挂在文字后面，扫一眼就知道每个分类有多少条 */
.tab-count {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  margin-left: 6rpx;
  border-radius: 16rpx;
  font-size: var(--font-xs);
  text-align: center;
  background: var(--color-primary);
  color: #ffffff;
}

/* ==================== 协会分栏 ==================== */
/* 每个协会一段。段容器挂 .assoc-<id>，段内这些元素的 var() 就取该协会颜色 */

.assoc-section {
  margin-bottom: var(--space-md);
}

.assoc-section-head {
  display: flex;
  align-items: center;
  padding: 0 var(--space-xs);
  margin-bottom: var(--space-sm);
}

/* 徽标用协会主色，是整段里最醒目的一处，归属一眼可辨 */
.assoc-badge {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  font-weight: 600;
  background: var(--color-primary);
  color: #ffffff;
}

.assoc-section-name {
  margin-left: var(--space-sm);
  font-size: var(--font-md);
  font-weight: 600;
}

.assoc-section-count {
  margin-left: var(--space-xs);
  padding: 0 12rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 18rpx;
  font-size: var(--font-xs);
  background: var(--color-primary-light);
  color: var(--color-primary);
}

/* ==================== 一条公告 ==================== */

.notice-row {
  padding: var(--space-md) 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.notice-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.notice-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.notice-category {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

/* 置顶用暖色，和普通分类一眼就能分开 */
.notice-pin {
  margin-left: var(--space-xs);
  background: #fef3c7;
  color: #b45309;
}

/* 发布时间推到最右边 */
.notice-date {
  margin-left: auto;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.notice-title {
  margin-top: var(--space-xs);
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 1.5;
}

.notice-content {
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.7;
}
