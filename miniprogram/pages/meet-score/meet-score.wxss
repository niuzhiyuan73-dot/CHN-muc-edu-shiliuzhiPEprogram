.meet-section-title { margin: 24rpx 0 12rpx; font-size: 26rpx; font-weight: 600; color: #555; }
.meet-row { padding: 20rpx 24rpx; margin-bottom: 12rpx; }
.meet-row-head { display: flex; justify-content: space-between; align-items: center; }
.meet-row-name { font-size: 28rpx; font-weight: 500; }
.meet-row-meta { margin-top: 6rpx; font-size: 22rpx; color: #888; }
.meet-row-tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 999rpx; background: #f2f2f2; color: #777; }
.meet-editor { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f0f0; }
.meet-hint { font-size: 24rpx; color: #888; padding: 8rpx 0; }
.meet-warn { font-size: 24rpx; color: #b23a2e; background: #fdece9; padding: 10rpx 16rpx; border-radius: 10rpx; margin-bottom: 10rpx; }
.meet-score-row { display: flex; align-items: center; gap: 12rpx; padding: 10rpx 0; }
.meet-score-college { width: 120rpx; font-size: 24rpx; color: #555; }
.meet-score-input { flex: 1; height: 64rpx; padding: 0 16rpx; background: #f7f8fa; border-radius: 10rpx; font-size: 24rpx; }
.meet-score-state { width: 100rpx; font-size: 20rpx; color: #999; text-align: center; }
.meet-score-submit { padding: 8rpx 18rpx; border-radius: 999rpx; background: #b23a2e; color: #fff; font-size: 22rpx; }
.meet-preview-row { display: flex; align-items: center; gap: 12rpx; padding: 10rpx 0; font-size: 24rpx; }
.meet-preview-college { flex: 1; }
.meet-preview-value { width: 120rpx; text-align: right; }
.meet-preview-void { padding: 6rpx 14rpx; border-radius: 999rpx; background: #f2f2f2; color: #777; font-size: 20rpx; }
.meet-preview-void.is-void { background: #fdece9; color: #b23a2e; }
.meet-notice { margin-bottom: 16rpx; padding: 12rpx 20rpx; border-radius: 12rpx; background: #e8f5ec; color: #1f7a3d; font-size: 24rpx; }
.meet-error { margin-bottom: 16rpx; padding: 12rpx 20rpx; border-radius: 12rpx; background: #fdece9; color: #b23a2e; font-size: 24rpx; }

/* 预赛/决赛切换 */
.meet-rounds { white-space: nowrap; margin: 12rpx 0; }
.meet-round { display: inline-block; padding: 8rpx 20rpx; margin-right: 12rpx; border-radius: 999rpx; background: #f2f3f5; font-size: 22rpx; color: #555; }
.meet-round.is-active { background: #b23a2e; color: #fff; }
/* 签表：点队伍名即判胜 */
.meet-match { padding: 12rpx 0; border-bottom: 1rpx solid #f4f4f4; }
.meet-match-head { font-size: 22rpx; color: #888; margin-bottom: 8rpx; }
.meet-side { padding: 12rpx 18rpx; border-radius: 10rpx; background: #f7f8fa; font-size: 26rpx; margin-bottom: 8rpx; }
.meet-side.is-winner { background: #e8f5ec; color: #1f7a3d; font-weight: 600; }
.meet-side.is-empty { color: #bbb; background: #fbfbfb; }
.meet-ok { font-size: 24rpx; color: #1f7a3d; background: #e8f5ec; padding: 10rpx 16rpx; border-radius: 10rpx; margin-bottom: 10rpx; }

/* 录分页的场次切换与「下一场」 */
.meet-next { margin-top: 16rpx; padding: 16rpx; text-align: center; border-radius: 12rpx; background: #f7f8fa; font-size: 24rpx; color: #b23a2e; }
