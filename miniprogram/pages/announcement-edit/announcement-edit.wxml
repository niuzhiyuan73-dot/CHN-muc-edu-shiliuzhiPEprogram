<!--
  发布公告
  表单的校验在 services/announcement.js，这里只渲染，并把用户的操作交回去。
-->
<view class="page-container {{themeClass}}">

  <!-- 没有发布权时不给表单：填完再被拒，比一开始就说清楚糟得多 -->
  <view wx:if="{{blockReason}}" class="empty-state">
    <view class="empty-state-icon">🔒</view>
    <view class="empty-state-text">{{blockReason}}</view>
    <view class="btn btn-outline block-back" bindtap="onCancel">返回</view>
  </view>

  <block wx:else>

    <!-- ========== 基本信息 ========== -->
    <view class="card">
      <view class="card-title">公告信息</view>

      <view class="field-row">
        <view class="field-label">标题</view>
        <input
          class="field-input"
          value="{{form.title}}"
          maxlength="{{titleMax}}"
          placeholder="例如：本周训练时间调整"
          bindinput="onInputTitle"
        />
      </view>
      <view wx:if="{{errors.title}}" class="field-error">{{errors.title}}</view>

      <view class="field-row">
        <view class="field-label">分类</view>
        <picker
          mode="selector"
          range="{{categories}}"
          value="{{categoryIndex}}"
          bindchange="onPickCategory"
        >
          <view class="field-value">{{form.category}} ›</view>
        </picker>
      </view>
      <view wx:if="{{errors.category}}" class="field-error">{{errors.category}}</view>

      <view class="field-row">
        <view class="field-label">置顶</view>
        <switch checked="{{form.pinned}}" color="#2f6fed" bindchange="onTogglePinned" />
      </view>
      <view class="field-hint">置顶的公告会排在首页与列表的最前面，适合招新、规则变更这类必须让所有人看到的信息</view>
    </view>

    <!-- ========== 正文 ========== -->
    <view class="card">
      <view class="card-title">正文</view>
      <view class="card-subtitle">把时间、地点、要带的东西写清楚，最多 {{contentMax}} 个字</view>

      <textarea
        class="content-input"
        value="{{form.content}}"
        maxlength="{{contentMax}}"
        placeholder="例如：本周起每周三、周五 18:00 在体育馆 1 号场常规训练，请自备球拍。"
        bindinput="onInputContent"
      />
      <view wx:if="{{errors.content}}" class="field-error">{{errors.content}}</view>
    </view>

    <view wx:if="{{errorText}}" class="submit-error">{{errorText}}</view>

    <view class="submit-bar">
      <view class="btn btn-outline submit-btn" bindtap="onCancel">取消</view>
      <view
        class="btn btn-primary submit-btn {{submitting ? 'btn-disabled' : ''}}"
        bindtap="onSubmit"
      >发布</view>
    </view>

    <view wx:if="{{isMock}}" class="mock-note">
      当前为本地模拟数据，发布后只写入内存，重启小程序即清空
    </view>
  </block>
</view>
