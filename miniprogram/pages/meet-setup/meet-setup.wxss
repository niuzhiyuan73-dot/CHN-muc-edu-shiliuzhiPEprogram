.meet-form { padding: 20rpx 24rpx; margin-bottom: 20rpx; }
.meet-field { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid var(--color-divider, #f0f0f0); }
.meet-field:last-child { border-bottom: none; }
.meet-label { font-size: 26rpx; color: #555; width: 120rpx; }
.meet-input { flex: 1; text-align: right; font-size: 26rpx; }
.meet-value { font-size: 26rpx; color: #222; }
.meet-toolbar { margin-bottom: 16rpx; }
.meet-search { height: 72rpx; padding: 0 20rpx; border-radius: 12rpx; background: var(--color-bg-subtle, #f5f6f8); font-size: 26rpx; }
.meet-cats { white-space: nowrap; margin-bottom: 16rpx; }
.meet-cat { display: inline-block; padding: 10rpx 22rpx; margin-right: 12rpx; border-radius: 999rpx; background: var(--color-bg-subtle, #f5f6f8); font-size: 24rpx; color: #555; }
.meet-cat.is-active { background: #b23a2e; color: #fff; }
.meet-tpl { padding: 20rpx 24rpx; margin-bottom: 12rpx; }
.meet-tpl-head { display: flex; justify-content: space-between; align-items: center; }
.meet-tpl-name { font-size: 28rpx; font-weight: 500; }
.meet-tpl-cat { font-size: 20rpx; color: #999; }
.meet-tpl-groups { margin-top: 12rpx; display: flex; gap: 12rpx; align-items: center; flex-wrap: wrap; }
.meet-group { padding: 6rpx 20rpx; border-radius: 999rpx; border: 1rpx solid #ddd; font-size: 22rpx; color: #555; }
.meet-group.is-picked { background: #b23a2e; border-color: #b23a2e; color: #fff; }
.meet-tpl-note { font-size: 20rpx; color: #999; }
.meet-section-title { margin: 24rpx 0 12rpx; font-size: 26rpx; font-weight: 600; color: #555; }
.meet-pick { padding: 18rpx 24rpx; margin-bottom: 12rpx; }
.meet-pick-name { font-size: 26rpx; font-weight: 500; }
.meet-pick-meta { margin-top: 6rpx; font-size: 22rpx; color: #888; display: flex; gap: 16rpx; }
.meet-pick-ops { margin-top: 12rpx; display: flex; align-items: center; gap: 10rpx; }
.meet-step { width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center; border-radius: 10rpx; background: var(--color-bg-subtle, #f5f6f8); font-size: 28rpx; color: #333; }
.meet-step-value { min-width: 48rpx; text-align: center; font-size: 24rpx; }
.meet-notice { margin-bottom: 16rpx; padding: 12rpx 20rpx; border-radius: 12rpx; background: #e8f5ec; color: #1f7a3d; font-size: 24rpx; }
.meet-error { margin-bottom: 16rpx; padding: 12rpx 20rpx; border-radius: 12rpx; background: #fdece9; color: #b23a2e; font-size: 24rpx; }

/* 赛制 / 轮次切换 */
.meet-pick-opts { margin-top: 12rpx; display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.meet-chip { padding: 6rpx 20rpx; border-radius: 999rpx; border: 1rpx solid #ddd; font-size: 22rpx; color: #555; }
.meet-chip.is-on { background: #b23a2e; border-color: #b23a2e; color: #fff; }
.meet-advance { display: flex; align-items: center; gap: 8rpx; }
.meet-advance-label { font-size: 22rpx; color: #888; }
