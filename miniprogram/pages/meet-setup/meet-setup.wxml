<!--
  发起运动会：第一步基本信息（新发起才显示）→ 第二步逐项目勾选组别并设限额。
  继续配置（带 meetId 进入）直接落在第二步。
-->
<view class="page-container">

  <view wx:if="{{notice}}" class="meet-notice">{{notice}}</view>
  <view wx:if="{{error}}" class="meet-error">{{error}}</view>

  <!-- 第一步：基本信息 -->
  <block wx:if="{{step === 1}}">
    <view class="card meet-form">
      <view class="meet-field">
        <text class="meet-label">名称</text>
        <input class="meet-input" placeholder="如：第 59 届田径运动会" value="{{name}}" data-field="name" bindinput="onFieldInput" />
      </view>
      <view class="meet-field">
        <text class="meet-label">年份</text>
        <input class="meet-input" type="number" value="{{year}}" data-field="year" bindinput="onFieldInput" />
      </view>
      <view class="meet-field">
        <text class="meet-label">开始</text>
        <picker mode="date" value="{{startDate}}" data-field="startDate" bindchange="onDateChange">
          <view class="meet-value">{{startDate}}</view>
        </picker>
      </view>
      <view class="meet-field">
        <text class="meet-label">结束</text>
        <picker mode="date" value="{{endDate}}" data-field="endDate" bindchange="onDateChange">
          <view class="meet-value">{{endDate}}</view>
        </picker>
      </view>
      <view class="meet-field">
        <text class="meet-label">地点</text>
        <input class="meet-input" placeholder="如：学校田径场" value="{{location}}" data-field="location" bindinput="onFieldInput" />
      </view>
    </view>
    <button class="btn btn-primary" bindtap="onNext" disabled="{{busy}}">{{busy ? '创建中…' : '下一步：选择项目'}}</button>
  </block>

  <!-- 第二步：项目选择 -->
  <block wx:else>
    <view class="meet-toolbar">
      <input class="meet-search" placeholder="搜索项目（100米 / 百米）" value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="onSearch" confirm-type="search" />
    </view>

    <scroll-view class="meet-cats" scroll-x>
      <view class="meet-cat {{activeCategory === '' ? 'is-active' : ''}}" data-category="" bindtap="onCategoryTap">全部</view>
      <view
        wx:for="{{categories}}"
        wx:key="category"
        class="meet-cat {{activeCategory === item.category ? 'is-active' : ''}}"
        data-category="{{item.category}}"
        bindtap="onCategoryTap"
      >{{item.label}}</view>
    </scroll-view>

    <view wx:if="{{loading}}" class="loading">正在加载项目库…</view>

    <view wx:for="{{templates}}" wx:key="templateId" class="card meet-tpl">
      <view class="meet-tpl-head">
        <view class="meet-tpl-name">{{item.name}}</view>
        <view class="meet-tpl-cat">{{item.categoryLabel}}</view>
      </view>
      <view class="meet-tpl-groups">
        <view
          wx:for="{{item.groupOptions}}"
          wx:for-item="option"
          wx:key="group"
          class="meet-group {{option.picked ? 'is-picked' : ''}}"
          data-template-id="{{item.templateId}}"
          data-group="{{option.group}}"
          bindtap="onToggleGroup"
        >{{option.label}}</view>
        <text wx:if="{{item.fixedMembers}}" class="meet-tpl-note">固定 {{item.fixedMembers}} 人一组</text>
        <text wx:elif="{{!item.defaultScored}}" class="meet-tpl-note">默认不计分</text>
      </view>
    </view>

    <view wx:if="{{picked.length > 0}}" class="meet-section-title">已选 {{pickedCount}} 项（改动立即保存）</view>
    <view wx:for="{{picked}}" wx:key="key" class="card meet-pick">
      <view class="meet-pick-main">
        <view class="meet-pick-name">
          {{item.name}} · {{item.groupLabel}}
          <text wx:if="{{savingKey === item.key}}" class="meet-pick-saving">保存中…</text>
          <text wx:elif="{{!item.saved}}" class="meet-pick-failed">未保存</text>
        </view>
        <view wx:if="{{item.saveError}}" class="meet-pick-error">{{item.saveError}}</view>
      </view>

      <!-- 人数：可直接输入，也可设为不限 -->
      <view wx:if="{{item.entryForm !== 'single'}}" class="meet-form-row">
        <text class="meet-form-label">每组人数</text>
        <block wx:if="{{item.fixedMembers}}">
          <text class="meet-form-fixed">固定 {{item.fixedMembers}} 人</text>
        </block>
        <block wx:else>
          <input
            class="meet-num"
            type="number"
            value="{{item.membersUnlimited ? '' : item.members}}"
            placeholder="不限"
            disabled="{{item.membersUnlimited}}"
            data-index="{{index}}"
            bindinput="onMembersInput"
          />
          <text class="meet-form-unit">人</text>
          <view
            class="meet-chip {{item.membersUnlimited ? 'is-on' : ''}}"
            data-index="{{index}}"
            bindtap="onToggleMembersUnlimited"
          >不限</view>
        </block>
      </view>

      <!-- 每院上限：可直接输入，也可设为不限 -->
      <view class="meet-form-row">
        <text class="meet-form-label">每院上限</text>
        <input
          class="meet-num"
          type="number"
          value="{{item.limitUnlimited ? '' : item.limit}}"
          placeholder="不限"
          disabled="{{item.limitUnlimited}}"
          data-index="{{index}}"
          bindinput="onLimitInput"
        />
        <text class="meet-form-unit">{{item.limitUnit}}</text>
        <view
          class="meet-chip {{item.limitUnlimited ? 'is-on' : ''}}"
          data-index="{{index}}"
          bindtap="onToggleLimitUnlimited"
        >不限</view>
      </view>

      <!-- 赛制（轮次/分组/签表）不在这里定：它取决于报名人数，放到报名截止后的编排页 -->
      <view class="meet-form-row">
        <text class="meet-form-hint">轮次与赛制在报名截止后、赛程编排页设置</text>
      </view>
    </view>

    <button class="btn btn-primary" bindtap="onSubmit" disabled="{{busy}}">完成</button>
    <button class="btn btn-ghost" bindtap="onBackToBasic" disabled="{{busy}}">{{isContinue ? '返回详情' : '上一步'}}</button>
  </block>
</view>
