<!--
  协会：tabBar 的第 2 个页签
  列出当前学校的协会，每个协会一个按钮，点进去进它的工作台（排行榜 / 比赛 / 赛事）。
--><view class="page-container {{themeClass}}">

  <!-- 加载中。排在出错之前，否则首屏会一闪而过地报错 -->
  <view wx:if="{{loading}}" class="loading">正在加载…</view>

  <view wx:elif="{{error}}" class="empty-state">
    <view class="empty-state-icon">⚠️</view>
    <view class="empty-state-text">{{error}}</view>
  </view>

  <block wx:else>

    <!-- 切到外校为只读浏览：协会清单是对方学校的，点进去看的是演示内容 -->
    <view wx:if="{{readOnlySchool}}" class="readonly-banner">
      正在浏览 {{schoolName}}（只读）· 榜单 / 比赛 / 赛事均为演示内容
    </view>

    <view class="assoc-intro">
      <view class="assoc-intro-title">选择协会</view>
      <view class="assoc-intro-note">进入后可查看该协会的排行榜、比赛与赛事</view>
    </view>

    <!-- 图标式网格：squircle 渐变图标在上、文字提示在下（参照主流体育 App 首页宫格） -->
    <view class="assoc-grid">
      <view
        wx:for="{{associations}}"
        wx:key="id"
        class="assoc-item {{item.active ? 'is-active' : ''}}"
        data-association="{{item.id}}"
        bindtap="onChooseAssociation"
      >
        <view wx:if="{{item.active}}" class="assoc-item-current">当前</view>
        <view class="assoc-item-icon">
          <image wx:if="{{item.icon}}" class="assoc-item-icon-img" src="{{item.icon}}" mode="aspectFit" />
          <text wx:else>{{item.glyph}}</text>
        </view>
        <view class="assoc-item-name">{{item.name}}</view>
        <view class="assoc-item-sport">{{item.sportName}}</view>
      </view>
    </view>

    <view wx:if="{{associations.length === 0}}" class="empty-note">这所学校还没有协会</view>

  </block>
</view>
