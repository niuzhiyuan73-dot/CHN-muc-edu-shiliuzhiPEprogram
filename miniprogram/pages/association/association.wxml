<!--
  协会：tabBar 的第 2 个页签
  分成上下两档：
    · 校级活动：运动会（学校级栏目，不属于任何协会），单独占一行；
    · 协会：当前学校的各协会，每个一个按钮，点进去进它的工作台。
--><view class="page-container {{themeClass}}">

  <!-- 加载中。排在出错之前，否则首屏会一闪而过地报错 -->
  <view wx:if="{{loading}}" class="loading">正在加载…</view>

  <view wx:elif="{{error}}" class="empty-state">
    <view class="empty-state-icon">⚠️</view>
    <view class="empty-state-text">{{error}}</view>
  </view>

  <block wx:else>

    <!-- 外校为只读浏览；可见内容仍由服务端权限决定 -->
    <view wx:if="{{readOnlySchool}}" class="readonly-banner">
      正在浏览 {{schoolName}}（只读）· 可访问内容以当前账号权限为准
    </view>

    <!-- 上档：校级活动。运动会与石榴籽杯都是学校级栏目，不属于任何协会；
         一行三个、卡片更大，与下面的协会密集宫格区分主次。 -->
    <view class="assoc-section">
      <view class="assoc-section-title">校级活动<text class="assoc-section-note">全校都能参加</text></view>

      <view class="assoc-grid assoc-grid--three">
        <view class="assoc-item assoc-item-meet" data-kind="meet" bindtap="onChooseMeet">
          <view class="assoc-item-icon"><text>🏟️</text></view>
          <view class="assoc-item-name">运动会</view>
          <view class="assoc-item-sport">校级赛事</view>
        </view>

        <view class="assoc-item assoc-item-cup" data-kind="cup" bindtap="onChooseCup">
          <view class="assoc-item-icon"><text>🏆</text></view>
          <view class="assoc-item-name">石榴籽杯</view>
          <view class="assoc-item-sport">学院赛</view>
        </view>
      </view>
    </view>

    <!-- 下档：协会。图标式宫格，一行四个（四列放得下五个字以内的协会名），
         四个之后自动换行，后续继续加协会不必再改布局。 -->
    <view class="assoc-section">
      <view class="assoc-section-title">协会<text class="assoc-section-note">按协会查看排行榜、比赛与赛事</text></view>

      <view class="assoc-grid assoc-grid--four">
        <view
          wx:for="{{associations}}"
          wx:key="id"
          class="assoc-item {{item.themeClass}} {{item.active ? 'is-active' : ''}}"
          data-association="{{item.id}}"
          bindtap="onChooseAssociation"
        >
          <view wx:if="{{item.active}}" class="assoc-item-current">当前</view>
          <view class="assoc-item-icon">
            <image wx:if="{{item.icon}}" class="assoc-item-icon-img" src="{{item.icon}}" mode="aspectFit" />
            <text wx:else>{{item.glyph}}</text>
          </view>
          <view class="assoc-item-name">{{item.name}}</view>
          <view class="assoc-item-sport">{{item.sportName}}</view>
        </view>
      </view>

      <view wx:if="{{associations.length === 0}}" class="empty-note">这所学校还没有协会</view>
    </view>

  </block>
</view>
