/*
 * 协会页样式
 * 页面骨架（.page-container / .empty-note / .loading）在 app.wxss 里。
 */

/* 只读浏览提示条：切到外校时出现在页面顶部，与首页同款 */
.readonly-banner {
  margin-bottom: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background: #fff4e5;
  color: #9a5b00;
  font-size: var(--font-sm);
  line-height: 1.6;
}

/* ==================== 分档标题 ==================== */

/* 上下两档：校级活动 / 协会。标题左侧留一点缩进，与宫格对齐 */
.assoc-section {
  margin-top: var(--space-md);
}

.assoc-section-title {
  display: flex;
  align-items: baseline;
  margin: 0 var(--space-xs) var(--space-sm);
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
}

.assoc-section-note {
  margin-left: var(--space-sm);
  font-size: var(--font-xs);
  font-weight: 400;
  color: var(--color-text-tertiary);
}

/* ==================== 校级活动 ==================== */

/* 运动会：学校级栏目，不属于任何协会，图标底用浅灰以示区别 */
.assoc-item-meet .assoc-item-icon {
  background: linear-gradient(135deg, #f4f6f9, #e3e8ef);
}

/* 石榴籽杯（学院赛）：香槟金浅底，与运动会的冷灰形成暖冷对照。
   不用深金/琥珀——金色奖杯图标压在金色底上会糊在一起；
   也不能用红色——红色是学校品牌色，会和导航栏、其他协会混作一谈 */
.assoc-item-cup .assoc-item-icon {
  background: linear-gradient(135deg, #fbebc8 0%, #f2d9a0 100%);
}

.assoc-item-meet:active,
.assoc-item:active {
  background: #f7f7f7;
}

/* ==================== 宫格（两档共用） ====================
   列数由修饰类决定，.assoc-item 只负责卡片外观：
     .assoc-grid--three  校级活动，一行三个，卡片更大；
     .assoc-grid--four   协会，一行四个（五个字以内的协会名放得下，
                         之后再加协会自动换行，不必再改布局）。
   列宽必须与 gap 成对计算，否则每行最后一格会被挤到下一行。 */
.assoc-grid {
  display: flex;
  flex-wrap: wrap;
}

.assoc-grid--three {
  gap: var(--space-md);
}

.assoc-grid--four {
  gap: var(--space-md);
}

.assoc-item {
  position: relative;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: var(--color-card);
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.07);
}

/* —— 校级活动：一行三个，图标与文字整体放大一档 —— */
.assoc-grid--three .assoc-item {
  width: calc((100% - 2 * var(--space-md)) / 3);
  padding: var(--space-lg) var(--space-sm);
  border-radius: var(--radius-lg);
}

.assoc-grid--three .assoc-item-icon {
  width: 136rpx;
  height: 136rpx;
  border-radius: 36rpx;
  font-size: 56rpx;
}

.assoc-grid--three .assoc-item-name {
  margin-top: var(--space-md);
  font-size: var(--font-md);
}

.assoc-grid--three .assoc-item-sport {
  margin-top: 4rpx;
  font-size: var(--font-sm);
}

/* —— 协会：一行四个。四列宽度容得下五个字的协会名，副行恢复显示，
      图标与字号相应放大一档，避免五列时的局促感。 */
.assoc-grid--four .assoc-item {
  width: calc((100% - 3 * var(--space-md)) / 4);
  padding: var(--space-md) var(--space-xs);
  border-radius: var(--radius-lg);
}

.assoc-grid--four .assoc-item-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 26rpx;
  font-size: var(--font-lg);
}

.assoc-grid--four .assoc-item-icon-img {
  width: 58rpx;
  height: 58rpx;
}

.assoc-grid--four .assoc-item-name {
  margin-top: var(--space-sm);
  font-size: var(--font-sm);
}

/* 「当前」角标在四列里收到贴角位置，避免压住放大的图标 */
.assoc-grid--four .assoc-item-current {
  top: var(--space-xs);
  right: var(--space-xs);
  font-size: 20rpx;
  padding: 0 10rpx;
}

/* 当前全局协会：主色描边 + 浅色底，扫一眼就知道「我现在在哪个协会」 */
.assoc-item.is-active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

/* 「当前」小角标：挂在卡片右上角，不占文字行的位置 */
.assoc-item-current {
  position: absolute;
  top: var(--space-sm);
  right: var(--space-sm);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-xs);
  line-height: 1.5;
}

/* 图标：主题色渐变 squircle（App 图标式的圆角方），白色运动线条图标居中。
   图标来自 tools/gen_assoc_icons.py；缺省退回文字徽标。 */
.assoc-item-icon {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: #fff;
  font-size: var(--font-xl);
  font-weight: 600;
  overflow: hidden;
}

.assoc-item-icon-img {
  width: 64rpx;
  height: 64rpx;
}

/* 文字提示：协会名一行 + 项目名一行弱化显示 */
.assoc-item-name {
  margin-top: var(--space-sm);
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text);
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.assoc-item-sport {
  margin-top: 2rpx;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}
