.school-page .card { margin-bottom: 24rpx; }
.hint { color: #666; font-size: 26rpx; line-height: 1.7; margin-top: 12rpx; }
.selection { padding: 24rpx 0; font-size: 30rpx; display: flex; justify-content: space-between; }
.selection text { color: #777; font-size: 26rpx; }
.identity-input { background: #f5f6f8; padding: 20rpx; margin: 16rpx 0 24rpx; border-radius: 12rpx; }
.demo-card { border-left: 6rpx solid #b23a2e; }
.error-box { color: #a12622; }
.application { border-top: 1rpx solid #eee; margin-top: 24rpx; padding-top: 24rpx; }
.applicant-name { font-size: 30rpx; font-weight: 600; }
.actions { display: flex; gap: 20rpx; }
.actions button { flex: 1; margin: 0; }
.member-row { display: flex; align-items: center; justify-content: space-between;
  border-top: 1rpx solid #eee; margin-top: 24rpx; padding-top: 24rpx; }
.member-main { flex: 1; }
.member-meta { margin-top: 6rpx; }
