<!-- 团队赛事详情：一页走完 报名 → 锁定 → 抽签 → 录分 → 发布 → 名次 -->
<view class="page-container {{themeClass}}">
  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <view wx:elif="{{error}}" class="hint">{{error}}</view>

  <block wx:else>
    <!-- 名头 -->
    <view class="head">
      <view class="head-name">{{event.name}}</view>
      <view class="head-meta">
        <text class="status status-{{event.status}}">{{event.statusLabel}}</text>
        <text class="head-count">{{event.entryCount}} 支球队</text>
      </view>
      <view class="head-rules">{{event.rulesText}}</view>
    </view>

    <view wx:if="{{notice}}" class="notice {{noticeError ? 'notice-error' : ''}}">{{notice}}</view>

    <!-- 管理动作：按状态只显示此刻该做的那一个 -->
    <view wx:if="{{canManage && supportsMatchData}}" class="action-bar">
      <view
        wx:if="{{event.status === 'registration'}}"
        class="btn btn-primary"
        bindtap="onLock"
      >锁定名单</view>
      <view
        wx:if="{{event.status === 'locked'}}"
        class="btn btn-primary"
        bindtap="onDraw"
      >抽签并生成赛程</view>
      <view
        wx:if="{{event.format === 'single_elim' && (event.status === 'scheduled' || event.status === 'running') && rounds.length > 0}}"
        class="btn btn-ghost"
        bindtap="onAdvance"
      >排下一轮</view>
      <view
        wx:if="{{(event.status === 'scheduled' || event.status === 'running') && rounds.length > 0}}"
        class="btn btn-ghost"
        bindtap="onSettle"
      >结算名次</view>
    </view>

    <!-- 报名 -->
    <view class="card">
      <view class="card-title">报名（{{entries.length}}）</view>

      <!-- 我能报的队：队长看到自己队，管理者看到所有还没报的队 -->
      <view wx:if="{{submitCandidates.length > 0}}" class="submit-block">
        <view
          wx:for="{{submitCandidates}}"
          wx:key="teamId"
          class="submit-row"
        >
          <view class="row-main">
            <view class="row-name">{{item.name}}</view>
            <view class="row-meta {{item.enough ? '' : 'text-warn'}}">
              {{item.memberCount}} / {{item.need}} 人{{item.enough ? '' : ' · 人数不足，先凑齐队员'}}
            </view>
          </view>
          <view
            wx:if="{{item.enough}}"
            class="mini mini-primary"
            data-teamid="{{item.teamId}}"
            bindtap="onSubmitEntry"
          >报名</view>
        </view>
      </view>

      <view wx:if="{{entries.length === 0 && submitCandidates.length === 0}}" class="hint-inline">还没有球队报名</view>
      <view wx:else class="row-list">
        <view wx:for="{{entries}}" wx:key="teamId" class="row">
          <view class="row-main">
            <view class="row-name">
              {{item.teamName}}
              <text wx:if="{{item.placement}}" class="tag tag-rank">第 {{item.placement}} 名</text>
            </view>
            <view class="row-meta">{{item.rosterCount}} 人 · {{item.statusLabel}}</view>
          </view>
          <view wx:if="{{canManage && item.status === 'submitted'}}" class="row-actions">
            <view class="mini mini-primary" data-teamid="{{item.teamId}}" bindtap="onApproveEntry">通过</view>
            <view class="mini" data-teamid="{{item.teamId}}" bindtap="onRejectEntry">退回</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 赛程 -->
    <view wx:if="{{rounds.length > 0}}" class="card">
      <view class="card-title">赛程</view>
      <view wx:if="{{isFootball && footballByes.length > 0}}" class="hint-inline">首轮轮空：<text wx:for="{{footballByes}}" wx:key="*this">{{item}} </text>（直接晋级，不计比分或出场）</view>
      <view wx:for="{{rounds}}" wx:key="key" class="round">
        <view class="round-head">
          <view class="round-label">{{item.label}}</view>
          <view
            wx:if="{{canManage}}"
            class="mini"
            data-round="{{item.round}}"
            data-stage="{{item.stage}}"
            data-label="{{item.label}}"
            bindtap="onOpenShift"
          >整轮顺延</view>
        </view>
        <view
          wx:for="{{item.matches}}"
          wx:for-item="match"
          wx:key="matchId"
          class="match"
        >
          <view class="match-line">
            <view class="side {{match.winner === 'A' ? 'side-win' : ''}}">{{match.teamAName}}</view>
            <view class="score">{{match.scoreText}}</view>
            <view class="side side-b {{match.winner === 'B' ? 'side-win' : ''}}">{{match.teamBName}}</view>
          </view>
          <view class="match-meta">
            <text wx:if="{{match.matchTimeText}}">{{match.matchTimeText}}</text>
            <text wx:if="{{match.location}}">{{match.location}}</text>
            <text>{{match.statusLabel}}</text>
            <text wx:if="{{match.live}}" class="tag">{{match.live.periodLabel}} · 非最终结果</text>
            <text wx:if="{{match.overtime}}" class="tag tag-ot">加时</text>
            <text wx:if="{{match.forfeit}}" class="tag tag-ot">{{match.forfeit === 'A' ? match.teamAName : match.teamBName}} 弃权</text>
            <text wx:if="{{match.statPending}}" class="tag tag-ot">统计待审核</text>
          </view>
          <view wx:if="{{match.refereeName || match.recorderName}}" class="match-meta">
            <text wx:if="{{match.refereeName}}">裁判 {{match.refereeName}}</text>
            <text wx:if="{{match.recorderName}}">记录 {{match.recorderName}}</text>
          </view>
          <view class="match-actions">
            <view wx:if="{{!isFootball && match.canRecord && (match.status === 'scheduled' || match.status === 'live')}}"
              class="mini mini-primary" data-matchid="{{match.matchId}}" bindtap="onOpenLiveScore">
              {{match.status === 'live' ? '继续计分' : '实时计分'}}
            </view>
            <view
              wx:if="{{!isFootball && match.canRecord && (match.status === 'scheduled' || match.status === 'reviewing')}}"
              class="mini mini-primary"
              data-matchid="{{match.matchId}}"
              bindtap="onOpenRecord"
            >{{match.status === 'reviewing' ? '重录' : '录分'}}</view>
            <view
              wx:if="{{!isFootball && match.canPublish && match.status === 'reviewing'}}"
              class="mini mini-primary"
              data-matchid="{{match.matchId}}"
              bindtap="onPublish"
            >发布</view>
            <view
              wx:if="{{!isFootball && match.canPublish && match.status === 'reviewing'}}"
              class="mini"
              data-matchid="{{match.matchId}}"
              bindtap="onRejectScore"
            >驳回</view>
            <view
              wx:if="{{!isFootball && match.canRecord && match.status !== 'canceled'}}"
              class="mini"
              data-matchid="{{match.matchId}}"
              bindtap="onOpenStats"
            >{{match.status === 'live' ? '球员统计' : match.statPending && match.canPublish ? '审核统计' : '统计'}}</view>
            <view
              wx:if="{{canManage && match.status !== 'canceled'}}"
              class="mini"
              data-matchid="{{match.matchId}}"
              bindtap="onOpenSchedule"
            >赛程</view>
            <view
              wx:if="{{!isFootball && match.canRecord && match.status !== 'published' && match.status !== 'canceled'}}"
              class="mini"
              data-matchid="{{match.matchId}}"
              bindtap="onOpenLineup"
            >{{match.hasLineup ? '改出场' : '定出场'}}</view>
            <view wx:if="{{isFootball && match.status !== 'canceled' && (match.canRecord || match.status === 'published')}}" class="mini mini-primary" data-matchid="{{match.matchId}}" bindtap="onOpenFootball">{{match.canRecord ? '赛后报告 / 审核' : '查看赛后报告'}}</view>
            <view wx:if="{{isFootball && match.canSetLineup && match.status === 'scheduled'}}" class="mini" data-matchid="{{match.matchId}}" data-lineup="true" bindtap="onOpenFootball">单场名单</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 积分表 -->
    <view wx:if="{{table.length > 0 && !isFootball}}" class="card">
      <view class="card-title">积分表</view>
      <view class="table-head">
        <view class="col-name">球队</view>
        <view class="col">场次</view>
        <view class="col">胜</view>
        <view class="col">负</view>
        <view class="col">净胜</view>
      </view>
      <view wx:for="{{table}}" wx:key="teamId" class="table-row">
        <view class="col-name">{{item.rank}}. {{item.teamName}}</view>
        <view class="col">{{item.played}}</view>
        <view class="col">{{item.wins}}</view>
        <view class="col">{{item.losses}}</view>
        <view class="col">{{item.diff > 0 ? '+' : ''}}{{item.diff}}</view>
      </view>
    </view>

    <view wx:if="{{table.length > 0 && isFootball && event.format === 'round_robin'}}" class="card">
      <view class="card-title">足球积分表</view>
      <view wx:for="{{table}}" wx:key="teamId" class="row">
        <view class="row-main">
          <view class="row-name">{{item.rank === null ? '同分待确认' : item.rank + '.'}} {{item.teamName}}</view>
          <view class="row-meta">{{item.played}} 场 · {{item.wins}} 胜 {{item.draws}} 平 {{item.losses}} 负 · 进 {{item.goalsFor}} / 失 {{item.goalsAgainst}}</view>
        </view>
        <view>{{item.points}} 分</view>
      </view>
    </view>

    <!-- 名次 -->
    <view wx:if="{{placements.length > 0}}" class="card">
      <view class="card-title">最终名次</view>
      <view wx:for="{{placements}}" wx:key="teamId" class="row">
        <view class="rank-no">{{item.rank}}</view>
        <view class="row-main">
          <view class="row-name">{{item.teamName}}</view>
          <view class="row-meta">{{item.note}}</view>
        </view>
      </view>
    </view>

    <!-- 报名选人浮层：勾人 + 填号码，不再默认带入全队 -->
    <view wx:if="{{entryEditing}}" class="mask" bindtap="onCloseEntry"></view>
    <view wx:if="{{entryEditing}}" class="sheet sheet-tall">
      <view class="sheet-title">{{entryEditing.teamName}} · 报名名单</view>
      <view class="sheet-sub">已选 {{entryEditing.selectedCount}} 人 · 上限 {{entryEditing.max}} 人 · 至少 {{entryEditing.min}} 人</view>
      <scroll-view scroll-y class="stats-scroll">
        <view wx:for="{{entryEditing.members}}" wx:key="userId" class="pick-row">
          <view
            class="pick-check {{item.checked ? 'pick-check-on' : ''}}"
            data-userid="{{item.userId}}"
            bindtap="onToggleEntryMember"
          >{{item.checked ? '✓' : ''}}</view>
          <view class="pick-name">{{item.name}}</view>
          <input
            class="pick-no"
            type="number"
            value="{{item.noText}}"
            placeholder="号码"
            data-userid="{{item.userId}}"
            bindinput="onInputJersey"
          />
        </view>
      </scroll-view>
      <view class="sheet-note">
        球衣号码 0–99，同队不能重号；不填也可以，先报名后补。改动已通过的名单会重新进审核。
      </view>
      <view class="sheet-actions">
        <view class="btn btn-ghost" bindtap="onCloseEntry">取消</view>
        <view class="btn btn-primary {{busy ? 'is-disabled' : ''}}" bindtap="onSaveEntry">提交报名</view>
      </view>
    </view>

    <!-- 单场出场名单：从报名名单里勾这一场真正上的人 -->
    <view wx:if="{{lineupEditing}}" class="mask" bindtap="onCloseLineup"></view>
    <view wx:if="{{lineupEditing}}" class="sheet sheet-tall">
      <view class="sheet-title">本场出场名单</view>
      <view class="side-switch">
        <view
          wx:for="{{lineupEditing.sides}}"
          wx:key="side"
          class="side-tab {{index === lineupEditing.activeIndex ? 'side-tab-on' : ''}}"
          data-index="{{index}}"
          bindtap="onSwitchLineupSide"
        >{{item.teamName}}{{item.editable ? '' : ' · 只读'}}</view>
      </view>
      <scroll-view scroll-y class="stats-scroll">
        <view wx:for="{{lineupPlayers}}" wx:key="userId" class="pick-row">
          <view
            class="pick-check {{item.checked ? 'pick-check-on' : ''}}"
            data-userid="{{item.userId}}"
            bindtap="onToggleLineupPlayer"
          >{{item.checked ? '✓' : ''}}</view>
          <view class="pick-name">{{item.name}}</view>
          <view class="pick-no-text">{{item.no === null ? '—' : item.no}}</view>
        </view>
      </scroll-view>
      <view class="sheet-note">
        没定过就默认全选。定过之后，统计面板只列上过场的人——没上场的人不该挂一排 0 分。
      </view>
      <view class="sheet-actions">
        <view class="btn btn-ghost" bindtap="onCloseLineup">取消</view>
        <view class="btn btn-primary {{busy ? 'is-disabled' : ''}}" bindtap="onSaveLineup">保存</view>
      </view>
    </view>

    <!-- 赛程浮层：时间 / 场地 / 裁判 / 记录员一次改完 -->
    <view wx:if="{{scheduleEditing}}" class="mask" bindtap="onCloseSchedule"></view>
    <view wx:if="{{scheduleEditing}}" class="sheet">
      <view class="sheet-title">{{scheduleEditing.title}}</view>
      <view wx:if="{{isFootball}}" class="ot-row"><text>预留时长（分钟）</text><input class="sheet-input" type="number" value="{{scheduleEditing.durationMinutes}}" data-field="durationMinutes" bindinput="onInputSchedule"/></view>
      <view wx:if="{{isFootball}}" class="sheet-note">默认按常规、中场、可能加时及 20 分钟缓冲计算；只可延长。球队、场地、裁判不能重叠。</view>
      <view class="ot-row">
        <text>开赛时间</text>
        <input
          class="sheet-input"
          value="{{scheduleEditing.matchTime}}"
          placeholder="2026-10-21 14:00"
          data-field="matchTime"
          bindinput="onInputSchedule"
        />
      </view>
      <view class="ot-row">
        <text>场地</text>
        <input
          class="sheet-input"
          value="{{scheduleEditing.location}}"
          placeholder="体育馆主馆"
          data-field="location"
          bindinput="onInputSchedule"
        />
      </view>
      <view class="ot-row">
        <text>裁判</text>
        <picker
          mode="selector"
          range="{{scheduleEditing.refereeLabels}}"
          value="{{scheduleEditing.refereeIndex}}"
          data-role="referee"
          bindchange="onPickSchedulePerson"
        >
          <view class="picker">{{scheduleEditing.refereeLabels[scheduleEditing.refereeIndex]}}</view>
        </picker>
      </view>
      <view class="ot-row">
        <text>记录员</text>
        <picker
          mode="selector"
          range="{{scheduleEditing.recorderLabels}}"
          value="{{scheduleEditing.recorderIndex}}"
          data-role="recorder"
          bindchange="onPickSchedulePerson"
        >
          <view class="picker">{{scheduleEditing.recorderLabels[scheduleEditing.recorderIndex]}}</view>
        </picker>
      </view>
      <view class="sheet-note">
        只有本协会在册会员能指派；参赛队队长不出现在裁判名单里。被指派的记录员可以直接录这一场。
      </view>
      <view class="sheet-actions">
        <view class="btn btn-ghost" bindtap="onCloseSchedule">取消</view>
        <view class="btn btn-primary {{scheduleBusy ? 'is-disabled' : ''}}" bindtap="onSubmitSchedule">保存</view>
      </view>
    </view>

    <!-- 整轮顺延浮层 -->
    <view wx:if="{{shiftEditing}}" class="mask" bindtap="onCloseShift"></view>
    <view wx:if="{{shiftEditing}}" class="sheet">
      <view class="sheet-title">{{shiftEditing.label}} · 整轮顺延</view>
      <view class="ot-row">
        <text>顺延分钟</text>
        <input
          class="sheet-input"
          type="number"
          value="{{shiftEditing.minutes}}"
          placeholder="30"
          bindinput="onInputShift"
        />
      </view>
      <view class="sheet-note">
        只挪这一轮里「还没发布、且已经排了时间」的场次；负数表示提前。
      </view>
      <view class="sheet-actions">
        <view class="btn btn-ghost" bindtap="onCloseShift">取消</view>
        <view class="btn btn-primary {{scheduleBusy ? 'is-disabled' : ''}}" bindtap="onSubmitShift">顺延</view>
      </view>
    </view>

    <!-- 录分浮层 -->
    <view wx:if="{{recording}}" class="mask" bindtap="onCloseRecord"></view>
    <view wx:if="{{recording}}" class="sheet">
      <view class="sheet-title">{{recording.teamAName}} vs {{recording.teamBName}}</view>
      <view class="score-form">
        <input
          class="score-input"
          type="number"
          value="{{scoreA}}"
          data-side="A"
          bindinput="onInputScore"
          placeholder="0"
        />
        <view class="score-colon">:</view>
        <input
          class="score-input"
          type="number"
          value="{{scoreB}}"
          data-side="B"
          bindinput="onInputScore"
          placeholder="0"
        />
      </view>
      <view class="ot-row">
        <text>本场结果</text>
        <picker mode="selector" range="{{forfeitLabels}}" value="{{forfeitIndex}}" bindchange="onPickForfeit">
          <view class="picker">{{forfeitLabels[forfeitIndex]}}</view>
        </picker>
      </view>
      <view wx:if="{{forfeitIndex > 0}}" class="forfeit-note">
        弃权按 20:0 记（弃权方 0 分、对手胜），比分可以按实际改。
      </view>
      <view wx:if="{{forfeitIndex === 0}}" class="ot-row">
        <text>打了加时</text>
        <switch checked="{{overtime}}" color="#2E7D32" bindchange="onToggleOvertime" />
      </view>
      <view class="sheet-note">录完只是「待审核」，协会负责人发布之后才进积分表与名次。</view>
      <view class="sheet-actions">
        <view class="btn btn-ghost" bindtap="onCloseRecord">取消</view>
        <view class="btn btn-primary {{busy ? 'is-disabled' : ''}}" bindtap="onSubmitScore">提交</view>
      </view>
    </view>

    <!-- 个人统计浮层：按锁定名单列人；按节模式一节一张小表 -->
    <view wx:if="{{statsEditing}}" class="mask" bindtap="onCloseStats"></view>
    <view wx:if="{{statsEditing}}" class="sheet sheet-tall">
      <view class="sheet-title">{{statsEditing.title}}</view>
      <view class="stats-mode">
        {{statsEditing.mode === 'detailed' ? '按节统计 · 共 ' + statsEditing.periods + ' 节' : '整场统计'}}
      </view>
      <scroll-view scroll-y class="stats-scroll">
        <view wx:for="{{statGroups}}" wx:for-item="group" wx:key="period" class="stats-team">
          <view wx:if="{{group.period > 0}}" class="stats-team-name">第 {{group.period}} 节</view>
          <view class="stats-head">
            <view class="stats-col-name">球员</view>
            <view wx:for="{{statFields}}" wx:key="field" class="stats-col">{{item.label}}</view>
          </view>
          <view wx:for="{{group.rows}}" wx:for-item="row" wx:key="key" class="stats-row">
            <view class="stats-col-name">{{row.name}}</view>
            <input
              wx:for="{{statFields}}"
              wx:for-item="col"
              wx:key="field"
              class="stats-input"
              type="number"
              value="{{row[col.field]}}"
              placeholder="—"
              data-key="{{row.key}}"
              data-field="{{col.field}}"
              bindinput="onInputStat"
            />
          </view>
        </view>
      </scroll-view>
      <view class="sheet-note">
        空着的格子表示「这场没统计」，不等于 0 分；合计与球队得分不一致时会提示差额。
      </view>
      <view wx:if="{{statsReview.needReview}}" class="sheet-note">
        这场已发布：改动会存为待审核版本，协会负责人通过后才影响到球员榜。
      </view>
      <view wx:if="{{statsReview.canReview}}" class="sheet-actions">
        <view class="btn btn-ghost {{statsBusy ? 'is-disabled' : ''}}" data-approve="false" bindtap="onReviewStats">退回新版</view>
        <view class="btn btn-primary {{statsBusy ? 'is-disabled' : ''}}" data-approve="true" bindtap="onReviewStats">通过并发布</view>
      </view>
      <view class="sheet-actions">
        <view class="btn btn-ghost" bindtap="onCloseStats">取消</view>
        <view class="btn btn-primary {{statsBusy ? 'is-disabled' : ''}}" bindtap="onSaveStats">保存</view>
      </view>
    </view>

    <!-- 球员数据榜：只算已发布的比赛 -->
    <view wx:if="{{playerStats.length > 0 && !isFootball}}" class="card">
      <view class="card-title">球员数据榜</view>
      <view class="table-head">
        <view class="col-name">球员</view>
        <view class="col">场次</view>
        <view class="col">得分</view>
        <view class="col">场均</view>
        <view class="col">篮板</view>
        <view class="col">助攻</view>
      </view>
      <view wx:for="{{playerStats}}" wx:key="userId" class="table-row">
        <view class="col-name">{{item.name}}</view>
        <view class="col">{{item.games}}</view>
        <view class="col">{{item.pointsText}}</view>
        <view class="col">{{item.pointsPerGameText}}</view>
        <view class="col">{{item.reboundsText}}</view>
        <view class="col">{{item.assistsText}}</view>
      </view>
      <view class="hint-inline">只统计已发布的比赛；没录的指标显示「—」，不计入场均。</view>
    </view>
    <view wx:if="{{isFootball}}" class="card">
      <view class="card-title">射手榜 · 已录入统计</view>
      <view class="hint-inline">{{footballCoverage || '尚无已发布统计'}}{{playerStatsError}}</view>
      <view wx:for="{{playerStats}}" wx:key="userId" class="row"><view class="row-main"><view class="row-name">{{item.name}}</view><view class="row-meta">实际出场 {{item.games}} 场 · 进球记录 {{item.goalsRecordedMatches}} 场</view></view><view>{{item.goalsText}} 球</view></view>
      <view class="card-title">助攻榜 · 已录入统计</view>
      <view wx:for="{{footballAssists}}" wx:key="userId" class="row"><view class="row-main"><view class="row-name">{{item.name}}</view><view class="row-meta">助攻记录 {{item.assistsRecordedMatches}} 场</view></view><view>{{item.assistsText}} 次</view></view>
    </view>
    <view wx:if="{{rankingEditing}}" class="mask" bindtap="onCloseRanking"></view>
    <view wx:if="{{rankingEditing}}" class="sheet sheet-tall">
      <view class="sheet-title">同分名次 · 抽签确认</view>
      <scroll-view scroll-y class="stats-scroll">
        <view wx:for="{{rankingEditing}}" wx:for-item="group" wx:for-index="gi" wx:key="tieKey">
          <view class="sheet-note">本组抽签后填写 1 起的顺序，各队不能重复。</view>
          <view wx:for="{{group.rows}}" wx:key="teamId" class="ot-row"><text>{{item.name}}</text><input type="number" class="sheet-input" value="{{item.order}}" data-group="{{gi}}" data-index="{{index}}" data-field="order" bindinput="onRankingInput" placeholder="组内顺序"/></view>
          <input class="sheet-input" value="{{group.reason}}" data-group="{{gi}}" data-field="reason" bindinput="onRankingInput" placeholder="抽签过程、结果及理由（必填）"/>
        </view>
      </scroll-view>
      <view class="sheet-actions"><view class="btn btn-ghost" bindtap="onCloseRanking">取消</view><view class="btn btn-primary" bindtap="onConfirmRanking">保存确认并结算</view></view>
    </view>
  </block>
</view>
