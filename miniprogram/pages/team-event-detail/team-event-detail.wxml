<!-- 团队赛事详情：一页走完 报名 → 锁定 → 抽签 → 录分 → 发布 → 名次 -->
<view class="page-container {{themeClass}}">
  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <view wx:elif="{{error}}" class="hint">{{error}}</view>

  <block wx:else>
    <!-- 名头 -->
    <view class="head">
      <view class="head-name">{{event.name}}</view>
      <view class="head-meta">
        <text class="status status-{{event.status}}">{{event.statusLabel}}</text>
        <text class="head-count">{{event.entryCount}} 支球队</text>
      </view>
      <view class="head-rules">{{event.rulesText}}</view>
    </view>

    <view wx:if="{{notice}}" class="notice {{noticeError ? 'notice-error' : ''}}">{{notice}}</view>

    <!-- 管理动作：按状态只显示此刻该做的那一个 -->
    <view wx:if="{{canManage}}" class="action-bar">
      <view
        wx:if="{{event.status === 'registration'}}"
        class="btn btn-primary"
        bindtap="onLock"
      >锁定名单</view>
      <view
        wx:if="{{event.status === 'locked'}}"
        class="btn btn-primary"
        bindtap="onDraw"
      >抽签并生成赛程</view>
      <view
        wx:if="{{event.format === 'single_elim' && (event.status === 'scheduled' || event.status === 'running') && rounds.length > 0}}"
        class="btn btn-ghost"
        bindtap="onAdvance"
      >排下一轮</view>
      <view
        wx:if="{{(event.status === 'scheduled' || event.status === 'running') && rounds.length > 0}}"
        class="btn btn-ghost"
        bindtap="onSettle"
      >结算名次</view>
    </view>

    <!-- 报名 -->
    <view class="card">
      <view class="card-title">报名（{{entries.length}}）</view>

      <!-- 我能报的队：队长看到自己队，管理者看到所有还没报的队 -->
      <view wx:if="{{submitCandidates.length > 0}}" class="submit-block">
        <view
          wx:for="{{submitCandidates}}"
          wx:key="teamId"
          class="submit-row"
        >
          <view class="row-main">
            <view class="row-name">{{item.name}}</view>
            <view class="row-meta {{item.enough ? '' : 'text-warn'}}">
              {{item.memberCount}} / {{item.need}} 人{{item.enough ? '' : ' · 人数不足，先凑齐队员'}}
            </view>
          </view>
          <view
            wx:if="{{item.enough}}"
            class="mini mini-primary"
            data-teamid="{{item.teamId}}"
            bindtap="onSubmitEntry"
          >报名</view>
        </view>
      </view>

      <view wx:if="{{entries.length === 0 && submitCandidates.length === 0}}" class="hint-inline">还没有球队报名</view>
      <view wx:else class="row-list">
        <view wx:for="{{entries}}" wx:key="teamId" class="row">
          <view class="row-main">
            <view class="row-name">
              {{item.teamName}}
              <text wx:if="{{item.placement}}" class="tag tag-rank">第 {{item.placement}} 名</text>
            </view>
            <view class="row-meta">{{item.rosterCount}} 人 · {{item.statusLabel}}</view>
          </view>
          <view wx:if="{{canManage && item.status === 'submitted'}}" class="row-actions">
            <view class="mini mini-primary" data-teamid="{{item.teamId}}" bindtap="onApproveEntry">通过</view>
            <view class="mini" data-teamid="{{item.teamId}}" bindtap="onRejectEntry">退回</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 赛程 -->
    <view wx:if="{{rounds.length > 0}}" class="card">
      <view class="card-title">赛程</view>
      <view wx:for="{{rounds}}" wx:key="key" class="round">
        <view class="round-label">{{item.label}}</view>
        <view
          wx:for="{{item.matches}}"
          wx:for-item="match"
          wx:key="matchId"
          class="match"
        >
          <view class="match-line">
            <view class="side {{match.winner === 'A' ? 'side-win' : ''}}">{{match.teamAName}}</view>
            <view class="score">{{match.scoreText}}</view>
            <view class="side side-b {{match.winner === 'B' ? 'side-win' : ''}}">{{match.teamBName}}</view>
          </view>
          <view class="match-meta">
            <text>{{match.statusLabel}}</text>
            <text wx:if="{{match.overtime}}" class="tag tag-ot">加时</text>
            <text wx:if="{{match.forfeit}}" class="tag tag-ot">{{match.forfeit === 'A' ? match.teamAName : match.teamBName}} 弃权</text>
            <text wx:if="{{match.statPending}}" class="tag tag-ot">统计待审核</text>
          </view>
          <view class="match-actions">
            <view
              wx:if="{{match.canRecord && (match.status === 'scheduled' || match.status === 'reviewing')}}"
              class="mini mini-primary"
              data-matchid="{{match.matchId}}"
              bindtap="onOpenRecord"
            >{{match.status === 'reviewing' ? '重录' : '录分'}}</view>
            <view
              wx:if="{{match.canPublish && match.status === 'reviewing'}}"
              class="mini mini-primary"
              data-matchid="{{match.matchId}}"
              bindtap="onPublish"
            >发布</view>
            <view
              wx:if="{{match.canPublish && match.status === 'reviewing'}}"
              class="mini"
              data-matchid="{{match.matchId}}"
              bindtap="onRejectScore"
            >驳回</view>
            <view
              wx:if="{{match.canRecord && match.status !== 'canceled'}}"
              class="mini"
              data-matchid="{{match.matchId}}"
              bindtap="onOpenStats"
            >{{match.statPending && match.canPublish ? '审核统计' : '统计'}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 积分表 -->
    <view wx:if="{{table.length > 0}}" class="card">
      <view class="card-title">积分表</view>
      <view class="table-head">
        <view class="col-name">球队</view>
        <view class="col">场次</view>
        <view class="col">胜</view>
        <view class="col">负</view>
        <view class="col">净胜</view>
      </view>
      <view wx:for="{{table}}" wx:key="teamId" class="table-row">
        <view class="col-name">{{item.rank}}. {{item.teamName}}</view>
        <view class="col">{{item.played}}</view>
        <view class="col">{{item.wins}}</view>
        <view class="col">{{item.losses}}</view>
        <view class="col">{{item.diff > 0 ? '+' : ''}}{{item.diff}}</view>
      </view>
    </view>

    <!-- 名次 -->
    <view wx:if="{{placements.length > 0}}" class="card">
      <view class="card-title">最终名次</view>
      <view wx:for="{{placements}}" wx:key="teamId" class="row">
        <view class="rank-no">{{item.rank}}</view>
        <view class="row-main">
          <view class="row-name">{{item.teamName}}</view>
          <view class="row-meta">{{item.note}}</view>
        </view>
      </view>
    </view>

    <!-- 录分浮层 -->
    <view wx:if="{{recording}}" class="mask" bindtap="onCloseRecord"></view>
    <view wx:if="{{recording}}" class="sheet">
      <view class="sheet-title">{{recording.teamAName}} vs {{recording.teamBName}}</view>
      <view class="score-form">
        <input
          class="score-input"
          type="number"
          value="{{scoreA}}"
          data-side="A"
          bindinput="onInputScore"
          placeholder="0"
        />
        <view class="score-colon">:</view>
        <input
          class="score-input"
          type="number"
          value="{{scoreB}}"
          data-side="B"
          bindinput="onInputScore"
          placeholder="0"
        />
      </view>
      <view class="ot-row">
        <text>本场结果</text>
        <picker mode="selector" range="{{forfeitLabels}}" value="{{forfeitIndex}}" bindchange="onPickForfeit">
          <view class="picker">{{forfeitLabels[forfeitIndex]}}</view>
        </picker>
      </view>
      <view wx:if="{{forfeitIndex > 0}}" class="forfeit-note">
        弃权按 20:0 记（弃权方 0 分、对手胜），比分可以按实际改。
      </view>
      <view wx:if="{{forfeitIndex === 0}}" class="ot-row">
        <text>打了加时</text>
        <switch checked="{{overtime}}" color="#2E7D32" bindchange="onToggleOvertime" />
      </view>
      <view class="sheet-note">录完只是「待审核」，协会负责人发布之后才进积分表与名次。</view>
      <view class="sheet-actions">
        <view class="btn btn-ghost" bindtap="onCloseRecord">取消</view>
        <view class="btn btn-primary {{busy ? 'is-disabled' : ''}}" bindtap="onSubmitScore">提交</view>
      </view>
    </view>

    <!-- 个人统计浮层：按锁定名单列人；按节模式一节一张小表 -->
    <view wx:if="{{statsEditing}}" class="mask" bindtap="onCloseStats"></view>
    <view wx:if="{{statsEditing}}" class="sheet sheet-tall">
      <view class="sheet-title">{{statsEditing.title}}</view>
      <view class="stats-mode">
        {{statsEditing.mode === 'detailed' ? '按节统计 · 共 ' + statsEditing.periods + ' 节' : '整场统计'}}
      </view>
      <scroll-view scroll-y class="stats-scroll">
        <view wx:for="{{statGroups}}" wx:for-item="group" wx:key="period" class="stats-team">
          <view wx:if="{{group.period > 0}}" class="stats-team-name">第 {{group.period}} 节</view>
          <view class="stats-head">
            <view class="stats-col-name">球员</view>
            <view wx:for="{{statFields}}" wx:key="field" class="stats-col">{{item.label}}</view>
          </view>
          <view wx:for="{{group.rows}}" wx:for-item="row" wx:key="key" class="stats-row">
            <view class="stats-col-name">{{row.name}}</view>
            <input
              wx:for="{{statFields}}"
              wx:for-item="col"
              wx:key="field"
              class="stats-input"
              type="number"
              value="{{row[col.field]}}"
              placeholder="—"
              data-key="{{row.key}}"
              data-field="{{col.field}}"
              bindinput="onInputStat"
            />
          </view>
        </view>
      </scroll-view>
      <view class="sheet-note">
        空着的格子表示「这场没统计」，不等于 0 分；合计与球队得分不一致时会提示差额。
      </view>
      <view wx:if="{{statsReview.needReview}}" class="sheet-note">
        这场已发布：改动会存为待审核版本，协会负责人通过后才影响到球员榜。
      </view>
      <view wx:if="{{statsReview.canReview}}" class="sheet-actions">
        <view class="btn btn-ghost {{statsBusy ? 'is-disabled' : ''}}" data-approve="false" bindtap="onReviewStats">退回新版</view>
        <view class="btn btn-primary {{statsBusy ? 'is-disabled' : ''}}" data-approve="true" bindtap="onReviewStats">通过并发布</view>
      </view>
      <view class="sheet-actions">
        <view class="btn btn-ghost" bindtap="onCloseStats">取消</view>
        <view class="btn btn-primary {{statsBusy ? 'is-disabled' : ''}}" bindtap="onSaveStats">保存</view>
      </view>
    </view>

    <!-- 球员数据榜：只算已发布的比赛 -->
    <view wx:if="{{playerStats.length > 0}}" class="card">
      <view class="card-title">球员数据榜</view>
      <view class="table-head">
        <view class="col-name">球员</view>
        <view class="col">场次</view>
        <view class="col">得分</view>
        <view class="col">场均</view>
        <view class="col">篮板</view>
        <view class="col">助攻</view>
      </view>
      <view wx:for="{{playerStats}}" wx:key="userId" class="table-row">
        <view class="col-name">{{item.name}}</view>
        <view class="col">{{item.games}}</view>
        <view class="col">{{item.pointsText}}</view>
        <view class="col">{{item.pointsPerGameText}}</view>
        <view class="col">{{item.reboundsText}}</view>
        <view class="col">{{item.assistsText}}</view>
      </view>
      <view class="hint-inline">只统计已发布的比赛；没录的指标显示「—」，不计入场均。</view>
    </view>
  </block>
</view>
